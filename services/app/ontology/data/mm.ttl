    skos:definition "Area."@en ;
    rdfs:label "Meters Squared"@en ;
    skos:notation "m^2"@en .

:V a :Units ;
    skos:notation "V"@en .

:dB a :Units ;
    skos:notation "dB"@en .

:Ohmm a :Units ;
    skos:notation "Ohm*m"@en .

:r-deg a :Units ;
    rdfs:label "1(radian)/degree"@en ;
    skos:notation "radian/degree"@en .

:N a :Units ;
    skos:definition "Force."@en ;
    rdfs:label "Newtons" ;
    skos:notation "N" .

:J a :Units ;
    rdfs:label "Joules" ;
    skos:definition "Energy" ;
    skos:notation "J" .

:j-gk a :Units ;
    rdfs:label "Joules Per Gram Kelvin" ;
    skos:notation "J/K" ;
    skos:definition "Specific heat capacity "@en .

<http://nanomine.org/ns/unit/m-2-g> a :Units ;
