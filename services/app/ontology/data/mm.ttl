@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix pico: <http://data.cochrane.org/ontologies/pico/> .

# Ontology Metadata
<http://materialsmine.org/resource>
    a owl:Ontology ;
    rdfs:label "MaterialsMine Ontology"@en ;
    rdfs:label "MaterialsMine-Ontologie"@de ;
    rdfs:label "Ontología de MaterialsMine"@es ;
    rdfs:label "Ontologie de MaterialsMine"@fr ;
    dcterms:creator "Catherine L. Brinson" ;
    dcterms:description "An ontology to represent basic organizational information for MaterialsMine"@en ;
    dcterms:description "Eine Ontologie zur Darstellung grundlegender Organisationsinformationen für MaterialsMine"@de ;
    dcterms:description "Una ontología para representar información organizacional básica para MaterialsMine"@es ;
    dcterms:description "Une ontologie pour représenter les informations organisationnelles de base pour MaterialsMine"@fr ;
    dcterms:contributor 
        <https://orcid.org/0000-0003-2551-1563>,
        <https://orcid.org/0000-0002-4653-7124>,
        <https://orcid.org/0000-0001-5296-4440>,
        <https://orcid.org/0000-0001-7037-4567>,
        <https://orcid.org/0000-0002-2061-2261>,
        <https://orcid.org/0000-0001-8995-0050> ;
    dcterms:email "materialsmine-dev@duke.edu" ;
    dcterms:license <https://creativecommons.org/licenses/by-nc-sa/4.0> ;
    owl:imports 
        <http://semanticscience.org/ontology/sio.owl>,
        <http://purl.org/ontology/bibo/>,
        <http://www.nanopub.org/nschema#> ;
    owl:versionIRI :1.1 .

# Classes
:1DGeometry a owl:Class ;
    rdfs:label "1D Geometry"@en, "Géométrie 1D"@fr, "Geometría 1D"@es, "1D-Geometrie"@de ;
    rdfs:subClassOf :UnitCellGeometry ;
    skos:definition "One-dimensional geometry, which can be fully described as a function of one coordinate."@en,
                    "Géométrie unidimensionnelle, qui peut être entièrement décrite en fonction d'une seule coordonnée."@fr,
                    "Geometría unidimensional, que puede describirse completamente como una función de una sola coordenada."@es,
                    "Eindimensionale Geometrie, die vollständig als Funktion einer einzigen Koordinate beschrieben werden kann."@de .

:1DSolidMechanicsModel a owl:Class ;
    rdfs:label "1D Solid Mechanics Model"@en, "Modèle de mécanique des solides 1D"@fr, "Modelo de mecánica de sólidos 1D"@es, "1D-Festkörpermechanikmodell"@de ;
    skos:definition "A one-dimensional model of a solid relating stress with strain."@en,
                    "Un modèle unidimensionnel d’un solide reliant la contrainte à la déformation."@fr,
                    "Un modelo unidimensional de un sólido que relaciona el esfuerzo con la deformación."@es,
                    "Ein eindimensionales Modell eines Festkörpers, das Spannung mit Verformung verknüpft."@de .

:2DGeometry a owl:Class ;
    rdfs:label "2D Geometry"@en, "Géométrie 2D"@fr, "Geometría 2D"@es, "2D-Geometrie"@de ;
    rdfs:subClassOf :Geometry ;
    skos:definition "Two-dimensional geometry which can be fully described as a function of two coordinates."@en,
                    "Géométrie bidimensionnelle, qui peut être entièrement décrite comme une fonction de deux coordonnées."@fr,
                    "Geometría bidimensional que puede describirse completamente como una función de dos coordenadas."@es,
                    "Zweidimensionale Geometrie, die vollständig als Funktion von zwei Koordinaten beschrieben werden kann."@de .

:2DSolidMechanicsModel a owl:Class ;
    rdfs:label "2D Solid Mechanics Model"@en, "Modèle de mécanique des solides 2D"@fr, "Modelo de mecánica de sólidos 2D"@es, "2D-Festkörpermechanikmodell"@de ;
    skos:definition "A two-dimensional mathematical model that assumes either out of plane strain or out of plane stress component is zero."@en,
                    "Un modèle mathématique bidimensionnel qui suppose que la déformation hors plan ou la composante de contrainte hors plan est nulle."@fr,
                    "Un modelo matemático bidimensional que asume que la deformación fuera del plano o la componente de esfuerzo fuera del plano es cero."@es,
                    "Ein zweidimensionales mathematisches Modell, das annimmt, dass entweder die Verformung außerhalb der Ebene oder die Spannungskomponente außerhalb der Ebene null ist."@de .

:3DGeometry a owl:Class ;
    rdfs:label "3D Geometry"@en, "Géométrie 3D"@fr, "Geometría 3D"@es, "3D-Geometrie"@de ;
    rdfs:subClassOf :Geometry ;
    skos:definition "Three-dimensional geometry which can be fully described as a function of three coordinates."@en,
                    "Géométrie tridimensionnelle qui peut être entièrement décrite comme une fonction de trois coordonnées."@fr,
                    "Geometría tridimensional que puede describirse completamente como una función de tres coordenadas."@es,
                    "Dreidimensionale Geometrie, die vollständig als Funktion von drei Koordinaten beschrieben werden kann."@de .

:Air a owl:Class ;
    rdfs:label "Air"@en, "Air"@fr, "Aire"@es, "Luft"@de ;
    rdfs:subClassOf :AmbientCondition ;
    skos:definition "Gaseous medium surrounding the solid boundaries of a material."@en, "Milieu gazeux entourant les limites solides d’un matériau."@fr, "Medio gaseoso que rodea los límites sólidos de un material."@es .

:Aperiodic a owl:Class ;
    rdfs:label "Aperiodic"@en, "Apériodique"@fr, "Aperiódico"@es, "Aperiodisch"@de ;
    rdfs:subClassOf :Periodicity ;
    skos:definition "Not appearing or occurring at intervals."@en,
                    "Ne se produisant pas ou n'apparaissant pas à intervalles réguliers."@fr,
                    "No aparece o ocurre a intervalos."@es,
                    "Nicht in regelmäßigen Abständen auftretend oder vorkommend."@de .

:BandGap a owl:Class ;
    rdfs:label "Band Gap"@en, "Bande interdite"@fr, "Banda prohibida"@es, "Bandlücke"@de ;
    rdfs:subClassOf :ElectricalProperty ;
    skos:definition "A band of frequencies for which there do not exist eigenfrequency solutions in the dispersion relation (for any wavevector)."@en,
                    "Une bande de fréquences pour laquelle il n'existe pas de solutions d'autofréquences dans la relation de dispersion (pour aucun vecteur d'onde)."@fr,
                    "Una banda de frecuencias para las cuales no existen soluciones de autofrecuencia en la relación de dispersión (para cualquier vector de onda)."@es,
                    "Ein Frequenzbereich, für den es keine Eigenfrequenzlösungen in der Dispersionsrelation gibt (für jeden Wellenvektor)."@de .

:BandGapIndex a owl:Class ;
    rdfs:label "Band Gap Index"@en, "Indice de bande interdite"@fr, "Índice de banda prohibida"@es, "Bandlückenindex"@de ;
    rdfs:subClassOf :Index ;
    skos:definition "Integer rank of a band gap."@en,
                    "Rang entier d'une bande interdite."@fr,
                    "Rango entero de una brecha de banda."@es,
                    "Ganzzahliger Rang einer Bandlücke."@de .

:BandGapLocation a owl:Class ;
    rdfs:label "Band Gap Location"@en, "Emplacement de la bande interdite"@fr, "Ubicación de la banda prohibida"@es, "Bandlückenposition"@de ;
    rdfs:subClassOf sio:SIO_000056 ;
    skos:definition "The center of the band gap. This can be computed as the average of the upper bound and lower bound of the bandgap."@en,
                    "Le centre de la bande interdite. Il peut être calculé comme la moyenne de la borne supérieure et de la borne inférieure de la bande interdite."@fr,
                    "El centro de la banda prohibida. Esto se puede calcular como el promedio del límite superior y el límite inferior de la banda prohibida."@es,
                    "Das Zentrum der Bandlücke. Dies kann als Durchschnitt der oberen und unteren Grenze der Bandlücke berechnet werden."@de .

:BandGapMechanism a owl:Class ;
    rdfs:label "Band Gap Mechanism"@en, "Mécanisme de bande interdite"@fr, "Mecanismo de banda prohibida"@es, "Bandlückenmechanismus"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
          owl:someValuesFrom :BandGapMechanism ] .

:BandGapSize a owl:Class ;
    rdfs:label "Band Gap Size"@en, "Taille de la bande interdite"@fr, "Tamaño de la banda prohibida"@es, "Bandlückengröße"@de ;
    rdfs:subClassOf sio:SIO_000042 ;
    skos:definition "The width of the band gap. This can be computed as the upper bound of the bandgap minus the lower bound of the bandgap."@en,
                    "La largeur de la bande interdite. Cela peut être calculé comme la borne supérieure de la bande interdite moins la borne inférieure de la bande interdite."@fr,
                    "El ancho de la brecha de banda. Esto se puede calcular como el límite superior de la brecha de banda menos el límite inferior de la brecha de banda."@es,
                    "Die Breite der Bandlücke. Dies kann als die obere Grenze der Bandlücke minus die untere Grenze der Bandlücke berechnet werden."@de .

:BandGapType a owl:Class ;
    rdfs:label "Band Gap Type"@en, "Type de bande interdite"@fr, "Tipo de banda prohibida"@es, "Bandlückentyp"@de ;
    rdfs:subClassOf :BandGap ;
    skos:definition "If the band gap is particular to a specific type of mode, which type of mode?"@en,
                    "Si la bande interdite est propre à un type spécifique de mode, quel type de mode ?"@fr,
                    "Si la banda prohibida es particular de un tipo específico de modo, ¿qué tipo de modo?"@es,
                    "Wenn die Bandlücke für einen bestimmten Modustyp spezifisch ist, welcher Modustyp?"@de .

:BandIndex a owl:Class ;
    rdfs:label "Band Index"@en, "Indice de bande"@fr, "Índice de banda"@es, "Bandenindex"@de .

:Beam a owl:Class ;
    rdfs:label "Beam"@en, "Poutre"@fr, "Viga"@es, "Träger"@de ;
    rdfs:subClassOf :1DSolidMechanicsModel ;
    skos:definition "A slender 1D structural element that primarily bears lateral loads."@en,
                    "Un élément structurel 1D élancé qui supporte principalement des charges latérales."@fr,
                    "Un elemento estructural 1D delgado que soporta principalmente cargas laterales."@es,
                    "Ein schlankes 1D-Strukturelement, das hauptsächlich seitliche Lasten trägt."@de .

:Binary2DGeometry a owl:Class ;
    rdfs:label "Binary 2D Geometry"@en, "Géométrie binaire 2D"@fr, "Geometría 2D binaria"@es, "Binäre 2D-Geometrie"@de ;
    rdfs:subClassOf :Geometry ;
    skos:definition "A string that represents the entire pixelated unit cell, e.g., using 0s and 1s to represent different material compositions at each pixel."@en,
                    "Une chaîne qui représente l'intégralité de la cellule unitaire pixelisée, par exemple en utilisant des 0 et des 1 pour représenter différentes compositions de matériaux à chaque pixel."@fr,
                    "Una cadena que representa toda la celda unitaria pixelada, por ejemplo, usando 0 y 1 para representar diferentes composiciones de material en cada píxel."@es,
                    "Eine Zeichenkette, die die gesamte pixelierte Einheitszelle darstellt, z. B. mit 0 und 1, um verschiedene Materialzusammensetzungen in jedem Pixel darzustellen."@de .

:BinaryMaterialPropertyField a owl:Class ;
    rdfs:label "Binary Material Property Field"@en, "Champ de propriétés matérielles binaires"@fr, "Campo de propiedades materiales binario"@es, "Binäres Materialeigenschaftsfeld"@de ;
    rdfs:subClassOf :DiscreteMaterialPropertyField ;
    skos:definition "A variable that describes the presence of one of the two materials. No intermediate materials are allowed."@en,
                    "Une variable qui décrit la présence de l'un des deux matériaux. Aucun matériau intermédiaire n'est autorisé."@fr,
                    "Una variable que describe la presencia de uno de los dos materiales. No se permiten materiales intermedios."@es,
                    "Eine Variable, die das Vorhandensein eines von zwei Materialien beschreibt. Es sind keine Zwischenmaterialien erlaubt."@de .

:C11 a owl:Class ;
    rdfs:label "C11"@en, "C11"@fr, "C11"@es, "C11"@de ;
    rdfs:subClassOf :CMatrixElement ;
    skos:definition "C matrix element with indices 1 and 1."@en,
                    "Élément de la matrice C avec les indices 1 et 1."@fr,
                    "Elemento de la matriz C con índices 1 y 1."@es,
                    "C-Matrixelement mit den Indizes 1 und 1."@de .

:C12 a owl:Class ;
    rdfs:label "C12"@en, "C12"@fr, "C12"@es, "C12"@de ;
    rdfs:subClassOf :CMatrixElement ;
    skos:definition "C matrix element with indices 1 and 2."@en,
                    "Élément de la matrice C avec les indices 1 et 2."@fr,
                    "Elemento de la matriz C con índices 1 y 2."@es,
                    "C-Matrixelement mit den Indizes 1 und 2."@de .

:C16 a owl:Class ;
    rdfs:label "C16"@en, "C16"@fr, "C16"@es, "C16"@de ;
    rdfs:subClassOf :CMatrixElement ;
    skos:definition "C matrix element with indices 1 and 6."@en,
                    "Élément de la matrice C avec les indices 1 et 6."@fr,
                    "Elemento de la matriz C con índices 1 y 6."@es,
                    "C-Matrixelement mit den Indizes 1 und 6."@de .

:C22 a owl:Class ;
    rdfs:label "C22"@en, "C22"@fr, "C22"@es, "C22"@de ;
    rdfs:subClassOf :CMatrixElement ;
    skos:definition "C matrix element with indices 2 and 2."@en,
                    "Élément de la matrice C avec les indices 2 et 2."@fr,
                    "Elemento de la matriz C con índices 2 y 2."@es,
                    "C-Matrixelement mit den Indizes 2 und 2."@de .

:C26 a owl:Class ;
    rdfs:label "C26"@en, "C26"@fr, "C26"@es, "C26"@de ;
    rdfs:subClassOf :CMatrixElement ;
    skos:definition "C matrix element with indices 2 and 6."@en,
                    "Élément de la matrice C avec les indices 2 et 6."@fr,
                    "Elemento de la matriz C con índices 2 y 6."@es,
                    "C-Matrixelement mit den Indizes 2 und 6."@de .

:C66 a owl:Class ;
    rdfs:label "C66"@en, "C66"@fr, "C66"@es, "C66"@de ;
    rdfs:subClassOf :CMatrixElement ;
    skos:definition "C matrix element with indices 6 and 6."@en,
                    "Élément de la matrice C avec les indices 6 et 6."@fr,
                    "Elemento de la matriz C con índices 6 y 6."@es,
                    "C-Matrixelement mit den Indizes 6 und 6."@de .

:C4VSymmetry a owl:Class ;
    rdfs:label "C4V Symmetry"@en, "Symétrie C4V"@fr, "Simetría C4V"@es, "C4V-Symmetrie"@de ;
    skos:definition "A class of symmetry for 2D square unit cells. Possesses symmetry along diagonals as well as horizontal/vertical edges."@en,
                    "Une classe de symétrie pour les cellules unitaires carrées 2D. Possède une symétrie le long des diagonales ainsi que des bords horizontaux/verticaux."@fr,
                    "Una clase de simetría para celdas unitarias cuadradas 2D. Posee simetría a lo largo de las diagonales, así como de los bordes horizontales/verticales."@es,
                    "Eine Klasse von Symmetrie für quadratische 2D-Einheitszellen. Besitzt Symmetrie entlang der Diagonalen sowie der horizontalen/vertikalen Kanten."@de .

:CartesianVector a owl:Class ;
    rdfs:label "Cartesian Vector"@en, "Vecteur cartésien"@fr, "Vector cartesiano"@es, "Kartesischer Vektor"@de ;
    rdfs:subClassOf sio:SIO_001430 ;
    skos:definition "A vector defined in the Cartesian coordinate system."@en,
                    "Un vecteur défini dans le système de coordonnées cartésiennes."@fr,
                    "Un vector definido en el sistema de coordenadas cartesianas."@es,
                    "Ein Vektor, der im kartesischen Koordinatensystem definiert ist."@de .

:CMatrix a owl:Class ;
    rdfs:label "Material Stiffness Matrix"@en, "Matrice de rigidité du matériau"@fr, "Matriz de rigidez del material"@es, "Materialsteifigkeitsmatrix"@de ;
    rdfs:subClassOf sio:SIO_001433 ;
    skos:definition """The material stiffness matrix of a linear elastic material defines the relationship between the stress and strain vector such that $sigma = Cepsilon$, where $sigma$ = ..."""@en,
                    """La matrice de rigidité du matériau d'un matériau élastique linéaire définit la relation entre le vecteur contrainte et le vecteur déformation telle que $sigma = Cepsilon$, où $sigma$ = ..."""@fr,
                    """La matriz de rigidez del material de un material elástico lineal define la relación entre el vector de esfuerzo y el vector de deformación, tal que $sigma = Cepsilon$, donde $sigma$ = ..."""@es,
                    """Die Materialsteifigkeitsmatrix eines linear elastischen Materials definiert die Beziehung zwischen dem Spannungs- und Verzerrungsvektor, so dass $sigma = Cepsilon$, wobei $sigma$ = ..."""@de .

:CMatrixElement a owl:Class ;
    rdfs:label "C Matrix Element"@en, "Élément de la matrice C"@fr, "Elemento de la matriz C"@es, "C-Matrixelement"@de ;
    rdfs:subClassOf sio:SIO_000015 ;
    skos:definition "An element within a material stiffness matrix."@en,
                    "Un élément d'une matrice de rigidité du matériau."@fr,
                    "Un elemento dentro de una matriz de rigidez del material."@es,
                    "Ein Element innerhalb einer Materialsteifigkeitsmatrix."@de .

:CMatrixIndexI a owl:Class ;
    rdfs:label "C Matrix Index I"@en, "Indice I de la matrice C"@fr, "Índice I de la matriz C"@es, "C-Matrixindex I"@de ;
    rdfs:subClassOf :Index ;
    skos:definition "The corresponding row of an element within a stiffness matrix (Voigt notation)."@en,
                    "La ligne correspondante d’un élément au sein d’une matrice de rigidité (notation de Voigt)."@fr,
                    "La fila correspondiente de un elemento dentro de una matriz de rigidez (notación de Voigt)."@es,
                    "Die entsprechende Zeile eines Elements innerhalb einer Steifigkeitsmatrix (Voigt-Notation)."@de .

:CMatrixIndexJ a owl:Class ;
    rdfs:label "C Matrix Index J"@en, "Indice J de la matrice C"@fr, "Índice J de la matriz C"@es, "C-Matrixindex J"@de ;
    rdfs:subClassOf :Index ;
    skos:definition "The corresponding column of an element within a stiffness matrix (Voigt notation)."@en,
                    "La colonne correspondante d’un élément dans une matrice de rigidité (notation de Voigt)."@fr,
                    "La columna correspondiente de un elemento dentro de una matriz de rigidez (notación de Voigt)."@es,
                    "Die entsprechende Spalte eines Elements innerhalb einer Steifigkeitsmatrix (Voigt-Notation)."@de .

:CMatrixIndicesIJ a owl:Class ;
    rdfs:label "C Matrix Indices I J"@en, "Indices I J de la matrice C"@fr, "Índices I J de la matriz C"@es, "C-Matrixindizes I J"@de ;
    rdfs:subClassOf sio:SIO_000015 ;
    skos:definition "The location of an element within a material stiffness matrix, in the form of the full string IJ (Voigt notation)."@en,
                    "La position d’un élément dans une matrice de rigidité du matériau, sous la forme de la chaîne complète IJ (notation de Voigt)."@fr,
                    "La ubicación de un elemento dentro de una matriz de rigidez del material, en forma de la cadena completa IJ (notación de Voigt)."@es,
                    "Die Position eines Elements innerhalb einer Materialsteifigkeitsmatrix in Form der vollständigen Zeichenkette IJ (Voigt-Notation)."@de .

:CondensedBinary2DGeometry a owl:Class ;
    rdfs:label "Condensed Binary 2D Geometry"@en, "Géométrie binaire 2D condensée"@fr, "Geometría 2D binaria condensada"@es, "Kondensierte binäre 2D-Geometrie"@de ;
    rdfs:subClassOf :Binary2DGeometry ;
    skos:definition "If a representative unit cell geometry has a given symmetry type, the condensed binary 2D geometry is a string that represents only the unique pixels in the pixelated geometry."@en,
                    "Si une géométrie de cellule unitaire représentative possède un type de symétrie donné, la géométrie binaire 2D condensée est une chaîne qui représente uniquement les pixels uniques dans la géométrie pixellisée."@fr,
                    "Si una geometría representativa de celda unitaria tiene un tipo de simetría dado, la geometría binaria 2D condensada es una cadena que representa únicamente los píxeles únicos en la geometría pixelada."@es,
                    "Wenn eine repräsentative Einheitszellgeometrie einen bestimmten Symmetrietyp aufweist, ist die kondensierte binäre 2D-Geometrie eine Zeichenkette, die nur die einzigartigen Pixel in der pixelisierten Geometrie darstellt."@de .

:CondensedMaterialPropertyField a owl:Class ;
    rdfs:label "Condensed Material Property Field"@en, "Champ de propriétés matérielles condensé"@fr, "Campo de propiedades materiales condensado"@es, "Kondensiertes Materialeigenschaftsfeld"@de ;
    rdfs:subClassOf :MaterialPropertyField .

:CondensedMaterialPropertyFieldVector a owl:Class ;
    rdfs:label "Condensed Material Property Field Vector"@en, "Vecteur de champ de propriétés matérielles condensé"@fr, "Vector de campo de propiedades materiales condensado"@es, "Kondensierter Materialeigenschaftsfeldvektor"@de .

:Condition a owl:Class ;
    rdfs:label "Condition"@en, "Condition"@fr, "Condición"@es, "Bedingung"@de ;
    rdfs:subClassOf :CompressionProperty ;
    skos:definition "The approximation, such as Plane Stress or Plane Strain, used to calculate the stress state of the material."@en,
                    "L’approximation, telle que la contrainte plane ou la déformation plane, utilisée pour calculer l’état de contrainte du matériau."@fr,
                    "La aproximación, como el esfuerzo plano o la deformación plana, utilizada para calcular el estado de esfuerzo del material."@es,
                    "Die Annäherung, wie z. B. ebene Spannung oder ebene Verzerrung, die zur Berechnung des Spannungszustands des Materials verwendet wird."@de .

:Continuous a owl:Class ;
    rdfs:label "Continuous"@en, "Continu"@fr, "Continuo"@es, "Kontinuierlich"@de ;
    skos:definition "An attribute of a variable which is defined everywhere continuously."@en,
                    "Un attribut d'une variable qui est définie partout de manière continue."@fr,
                    "Un atributo de una variable que está definida en todas partes de manera continua."@es,
                    "Ein Attribut einer Variable, die überall kontinuierlich definiert ist."@de .

:ContinuousMaterialPropertyField a owl:Class ;
    rdfs:label "Continuous Material Property Field"@en, "Champ de propriétés matérielles continu"@fr, "Campo de propiedades materiales continuo"@es, "Kontinuierliches Materialeigenschaftsfeld"@de ;
    rdfs:subClassOf :MaterialPropertyField ;
    skos:definition "A continuous field showing the distribution of material properties in a given region."@en,
                    "Un champ continu montrant la distribution des propriétés matérielles dans une région donnée."@fr,
                    "Un campo continuo que muestra la distribución de las propiedades materiales en una región dada."@es,
                    "Ein kontinuierliches Feld, das die Verteilung von Materialeigenschaften in einem gegebenen Bereich zeigt."@de .

:ConcretizedModel a owl:Class ;
    rdfs:label "Concretized Model"@en, "Modèle concrétisé"@fr, "Modelo concretizado"@es, "Konkretisiertes Modell"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Property ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :Property ].

:CTensor a owl:Class ;
    rdfs:label "Material Stiffness Tensor"@en, "Tenseur de rigidité du matériau"@fr, "Tensor de rigidez del material"@es, "Materialsteifigkeitstensor"@de ;
    rdfs:subClassOf sio:SIO_001429 ;
    skos:definition """The material stiffness tensor of a linear elastic material defines the relationship between the stress and strain tensors such that $sigma = Cepsilon$, where $sigma$ is the Cauchy stress tensor (a second order tensor), and $epsilon$ is the infinitesimal strain tensor (a second order tensor)."""@en,
                    """Le tenseur de rigidité du matériau d’un matériau élastique linéaire définit la relation entre les tenseurs de contrainte et de déformation telle que $sigma = Cepsilon$, où $sigma$ est le tenseur de contrainte de Cauchy (un tenseur de second ordre), et $epsilon$ est le tenseur de déformation infinitésimale (un tenseur de second ordre)."""@fr,
                    """El tensor de rigidez del material de un material elástico lineal define la relación entre los tensores de esfuerzo y deformación, tal que $sigma = Cepsilon$, donde $sigma$ es el tensor de esfuerzo de Cauchy (un tensor de segundo orden), y $epsilon$ es el tensor de deformación infinitesimal (un tensor de segundo orden)."""@es,
                    """Der Materialsteifigkeitstensor eines linear elastischen Materials definiert die Beziehung zwischen den Spannungs- und Verzerrungstensoren, so dass $sigma = Cepsilon$, wobei $sigma$ der Cauchy-Spannungstensor (ein Tensor zweiter Ordnung) und $epsilon$ der infinitesimale Verzerrungstensor (ein Tensor zweiter Ordnung) ist."""@de .

:CTensorElement a owl:Class ;
    rdfs:label "C Tensor Element"@en, "Élément du tenseur C"@fr, "Elemento del tensor C"@es, "C-Tensorelement"@de ;
    rdfs:subClassOf sio:SIO_000015 ;
    skos:definition "An element within a material stiffness tensor."@en,
                    "Un élément au sein d'un tenseur de rigidité du matériau."@fr,
                    "Un elemento dentro de un tensor de rigidez del material."@es,
                    "Ein Element innerhalb eines Materialsteifigkeitstensors."@de .

:CTensorIndexI a owl:Class ;
    rdfs:label "C Tensor Index I"@en, "Indice I du tenseur C"@fr, "Índice I del tensor C"@es, "C-Tensorindex I"@de ;
    rdfs:subClassOf :Index ;
    skos:definition "The i component of an element's location within a material stiffness tensor."@en,
                    "La composante i de la position d’un élément dans un tenseur de rigidité du matériau."@fr,
                    "El componente i de la ubicación de un elemento dentro de un tensor de rigidez del material."@es,
                    "Die i-Komponente der Position eines Elements innerhalb eines Materialsteifigkeitstensors."@de .

:CTensorIndexJ a owl:Class ;
    rdfs:label "C Tensor Index J"@en, "Indice J du tenseur C"@fr, "Índice J del tensor C"@es, "C-Tensorindex J"@de ;
    rdfs:subClassOf :Index ;
    skos:definition "The j component of an element's location within a material stiffness tensor."@en,
                    "La composante j de la position d’un élément dans un tenseur de rigidité du matériau."@fr,
                    "El componente j de la ubicación de un elemento dentro de un tensor de rigidez del material."@es,
                    "Die j-Komponente der Position eines Elements innerhalb eines Materialsteifigkeitstensors."@de .

:CTensorIndexK a owl:Class ;
    rdfs:label "C Tensor Index K"@en, "Indice K du tenseur C"@fr, "Índice K del tensor C"@es, "C-Tensorindex K"@de ;
    rdfs:subClassOf :Index ;
    skos:definition "The k component of an element's location within a material stiffness tensor."@en,
                    "La composante k de la position d’un élément dans un tenseur de rigidité du matériau."@fr,
                    "El componente k de la ubicación de un elemento dentro de un tensor de rigidez del material."@es,
                    "Die k-Komponente der Position eines Elements innerhalb eines Materialsteifigkeitstensors."@de .

:CTensorIndexL a owl:Class ;
    rdfs:label "C Tensor Index L"@en, "Indice L du tenseur C"@fr, "Índice L del tensor C"@es, "C-Tensorindex L"@de ;
    rdfs:subClassOf :Index ;
    skos:definition "The l component of an element's location within a material stiffness tensor."@en,
                    "La composante l de la position d’un élément dans un tenseur de rigidité du matériau."@fr,
                    "El componente l de la ubicación de un elemento dentro de un tensor de rigidez del material."@es,
                    "Die l-Komponente der Position eines Elements innerhalb eines Materialsteifigkeitstensors."@de .

:CTensorIndicesIJKL a owl:Class ;
    rdfs:label "C Tensor Indices I J K L"@en, "Indices I J K L du tenseur C"@fr, "Índices I J K L del tensor C"@es, "C-Tensorindizes I J K L"@de ;
    rdfs:subClassOf sio:SIO_000015 ;
    skos:definition "The location of an element within a material stiffness tensor, in the form of the full string IJKL."@en,
                    "La position d’un élément au sein d’un tenseur de rigidité du matériau, sous la forme de la chaîne complète IJKL."@fr,
                    "La ubicación de un elemento dentro de un tensor de rigidez del material, en forma de la cadena completa IJKL."@es,
                    "Die Position eines Elements innerhalb eines Materialsteifigkeitstensors in Form der vollständigen Zeichenkette IJKL."@de .

:CubeGeometry a owl:Class ;
    rdfs:label "Cube Geometry"@en, "Géométrie cubique"@fr, "Geometría cúbica"@es, "Würfelgeometrie"@de ;
    rdfs:subClassOf :CuboidalGeometry ;
    skos:definition "The shape of the unitcell: Characterized by a parallelogram with two equal side lengths, perpendicular sides. "@en,
                    "La forme de la maille élémentaire : caractérisée par un parallélogramme avec deux côtés de même longueur et des côtés perpendiculaires."@fr,
                    "La forma de la celda unitaria: caracterizada por un paralelogramo con dos lados de igual longitud y lados perpendiculares."@es,
                    "Die Form der Einheitszelle: Charakterisiert durch ein Parallelogramm mit zwei gleich langen Seiten und rechtwinkligen Seiten."@de .

:CuboidalGeometry a owl:Class ;
    rdfs:label "Cuboidal Geometry"@en, "Géométrie cuboïde"@fr, "Geometría cuboidal"@es, "Kuboidgeometrie"@de ;
    rdfs:subClassOf :3DGeometry ;
    skos:definition "The shape of the unit cell in 3D: Represented as a cuboid with not all equal side lengths."@en,
                    "La forme de la cellule unitaire en 3D : Représentée comme un cuboïde avec des longueurs de côtés non toutes égales."@fr,
                    "La forma de la celda unitaria en 3D: Representada como un cuboide con lados de longitudes no todas iguales."@es,
                    "Die Form der Einheitszelle in 3D: Dargestellt als ein Kuboid mit nicht allen gleichen Seitenlängen."@de .

:DispersionBand a owl:Class ;
    rdfs:label "Dispersion Band"@en, "Bande de dispersion"@fr, "Banda de dispersión"@es, "Dispersionsband"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :BandIndex ],
            [ a owl:Restriction ;
            owl:someValuesFrom :DispersionBandValue ] .

:DispersionBandValue a owl:Class ;
    rdfs:label "Dispersion Band Value"@en, "Valeur de bande de dispersion"@fr, "Valor de banda de dispersión"@es, "Dispersionsbandwert"@de .

:DispersionBandValue a owl:Class ;
    rdfs:label "Dispersion Band Value"@en, "Valeur de bande de dispersion"@fr, "Valor de banda de dispersión"@es, "Dispersionsbandwert"@de ;
    rdfs:subClassOf sio:SIO_001367 .

:DispersionRelation a owl:Class ;
    rdfs:label "Dispersion Relation"@en, "Relation de dispersion"@fr, "Relación de dispersión"@es, "Dispersionsrelation"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :BandGap ],
            sio:SIO_000017 ;
    skos:definition "Frequency-wavevector pairs that represent the propagation of wave modes."@en,
                    "Paires fréquence-vecteur d'onde qui représentent la propagation des modes d'onde."@fr,
                    "Pares de frecuencia-vector de onda que representan la propagación de modos de onda."@es,
                    "Frequenz-Wellenvektor-Paare, die die Ausbreitung von Wellenmodi darstellen."@de .

:DispersionRelation1D a owl:Class ;
    rdfs:label "1D Dispersion Relation"@en, "Relation de dispersion 1D"@fr, "Relación de dispersión 1D"@es, "1D-Dispersionsrelation"@de ;
    rdfs:subClassOf :DispersionRelation ;
    skos:definition "Frequency-wavevector pairs that represent the propagation of wave modes found in a specific 1D geometry."@en,
                    "Paires fréquence-vecteur d'onde qui représentent la propagation des modes d'onde dans une géométrie unidimensionnelle spécifique."@fr,
                    "Pares de frecuencia-vector de onda que representan la propagación de modos de onda encontrados en una geometría unidimensional específica."@es,
                    "Frequenz-Wellenvektor-Paare, die die Ausbreitung von Wellenmodi in einer spezifischen eindimensionalen Geometrie darstellen."@de .

:DispersionRelation2D a owl:Class ;
    rdfs:label "2D Dispersion Relation"@en, "Relation de dispersion 2D"@fr, "Relación de dispersión 2D"@es, "2D-Dispersionsrelation"@de ;
    rdfs:subClassOf :DispersionRelation ;
    skos:definition "Frequency-wavevector pairs that represent the propagation of wave modes found in a specific 2D geometry."@en,
                    "Paires fréquence-vecteur d'onde qui représentent la propagation des modes d'onde trouvés dans une géométrie 2D spécifique."@fr,
                    "Pares de frecuencia-vector de onda que representan la propagación de modos de onda encontrados en una geometría 2D específica."@es,
                    "Frequenz-Wellenvektor-Paare, die die Ausbreitung von Wellenmodi in einer spezifischen zweidimensionalen Geometrie darstellen."@de .

:DispersionRelation3D a owl:Class ;
    rdfs:label "3D Dispersion Relation"@en, "Relation de dispersion 3D"@fr, "Relación de dispersión 3D"@es, "3D-Dispersionsrelation"@de ;
    rdfs:subClassOf :DispersionRelation ;
    skos:definition "Frequency-wavevector pairs that represent the propagation of wave modes found in a specific 3D geometry."@en,
                    "Paires fréquence-vecteur d’onde qui représentent la propagation des modes d’onde présents dans une géométrie 3D spécifique."@fr,
                    "Pares de frecuencia y vector de onda que representan la propagación de modos de onda en una geometría 3D específica."@es,
                    "Frequenz-Wellenvektor-Paare, die die Ausbreitung von Wellenmodi in einer spezifischen dreidimensionalen Geometrie darstellen."@de .

:DiscreteMaterialPropertyField a owl:Class ;
    rdfs:label "Discrete Material Property Field"@en, "Champ de propriétés matérielles discret"@fr, "Campo de propiedades materiales discreto"@es, "Diskretes Materialeigenschaftsfeld"@de ;
    rdfs:subClassOf :MaterialPropertyField ;
    skos:definition "A discretized field showing the distribution of material properties in a given region."@en,
                    "Un champ discrétisé montrant la distribution des propriétés matérielles dans une région donnée."@fr,
                    "Un campo discreto que muestra la distribución de las propiedades materiales en una región dada."@es,
                    "Ein diskretisiertes Feld, das die Verteilung von Materialeigenschaften in einem gegebenen Bereich zeigt."@de .

:Eigenvector a owl:Class ;
    rdfs:label "Eigenvector"@en, "Vecteur propre"@fr, "Vector propio"@es, "Eigenvektor"@de ;
    rdfs:subClassOf sio:SIO_001430 ;
    skos:definition "The mode shape associated with a solution to the wave equation for a particular eigenvalue."@en,
                    "La forme modale associée à une solution de l'équation d'onde pour une valeur propre particulière."@fr,
                    "La forma modal asociada a una solución de la ecuación de ondas para un valor propio particular."@es,
                    "Die Modenform, die mit einer Lösung der Wellengleichung für einen bestimmten Eigenwert verbunden ist."@de .

:EulerBernoulliBeam a owl:Class ;
    rdfs:label "Euler Bernoulli Beam"@en, "Poutre d'Euler-Bernoulli"@fr, "Viga de Euler-Bernoulli"@es, "Euler-Bernoulli-Träger"@de ;
    skos:definition "A mathematical model of a beam undergoing small deflections neglecting shear deformations."@en,
                    "Un modèle mathématique d'une poutre subissant de petites déflexions, négligeant les déformations de cisaillement."@fr,
                    "Un modelo matemático de una viga que experimenta pequeñas deflexiones, ignorando las deformaciones por cizallamiento."@es,
                    "Ein mathematisches Modell eines Trägers, der kleine Durchbiegungen erfährt und Scherdeformationen vernachlässigt."@de .

:FiniteMetamaterial a owl:Class ;
    rdfs:label "Finite Metamaterial"@en, "Métamatériau fini"@fr, "Metamaterial finito"@es, "Endliches Metamaterial"@de ;
    rdfs:subClassOf :Metamaterial ;
    skos:definition "A metamaterial that has a finite length, that doesn't extend infinitely in the space."@en,
                    "Un métamatériau qui a une longueur finie, qui ne s'étend pas à l'infini dans l'espace."@fr,
                    "Un metamaterial que tiene una longitud finita, que no se extiende infinitamente en el espacio."@es,
                    "Ein Metamaterial, das eine endliche Länge hat und sich nicht unendlich im Raum erstreckt."@de .

:FirstBrillouinZone a owl:Class ;
    rdfs:label "First Brillouin Zone"@en, "Première zone de Brillouin"@fr, "Primera zona de Brillouin"@es, "Erste Brillouin-Zone"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
          owl:someValuesFrom :IrreducibleBrillouinZone ] ;
    skos:definition "Primitive cell in reciprocal space."@en,
                    "Cellule primitive dans l'espace réciproque."@fr,
                    "Celda primitiva en el espacio recíproco."@es,
                    "Primitive Zelle im reziproken Raum."@de .

:FluidContinuumPhysicsModel a owl:Class ;
    rdfs:label "Fluid Continuum Physics Model"@en, "Modèle physique de continuum fluide"@fr, "Modelo físico de continuo fluido"@es, "Flüssigkeitskontinuums-Physikmodell"@de .

:FrequencyBand a owl:Class ;
    rdfs:label "Frequency Band"@en, "Bande de fréquence"@fr, "Banda de frecuencia"@es, "Frequenzband"@de ;
    rdfs:subClassOf :DispersionBand .

:FullMaterialPropertyField a owl:Class ;
    rdfs:label "Full Material Property Field"@en, "Champ de propriétés matérielles complet"@fr, "Campo de propiedades materiales completo"@es, "Vollständiges Materialeigenschaftsfeld"@de ;
    rdfs:subClassOf :MaterialPropertyField .

:FullMaterialPropertyFieldMatrix a owl:Class ;
    rdfs:label "Full Material Property Field Matrix"@en, "Matrice de champ de propriétés matérielles complète"@fr, "Matriz de campo de propiedades materiales completa"@es, "Vollständige Materialeigenschaftsfeldmatrix"@de .

:Geometry a owl:Class ;
    rdfs:label "Geometry"@en, "Géométrie"@fr, "Geometría"@es, "Geometrie"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Symmetry ],
            sio:SIO_000506 ;
    skos:definition "Representation of the spatial extent and form of an object."@en,
                    "Représentation de l'étendue spatiale et de la forme d'un objet."@fr,
                    "Representación de la extensión espacial y la forma de un objeto."@es,
                    "Darstellung der räumlichen Ausdehnung und Form eines Objekts."@de .

:GeometryEncoding a owl:Class ;
    rdfs:label "Geometry Encoding"@en, "Encodage de la géométrie"@fr, "Codificación de geometría"@es, "Geometriekodierung"@de ;
    rdfs:subClassOf sio:SIO_000015 ;
    skos:definition "The string-based representation scheme for a geometric arrangement."@en,
                    "Le schéma de représentation basé sur des chaînes pour une disposition géométrique."@fr,
                    "El esquema de representación basado en cadenas para una disposición geométrica."@es,
                    "Das zeichenkettenbasierte Repräsentationsschema für eine geometrische Anordnung."@de .

:GroupVelocity a owl:Class ;
    rdfs:label "Group Velocity"@en, "Vitesse de groupe"@fr, "Velocidad de grupo"@es, "Gruppengeschwindigkeit"@de ;
    rdfs:subClassOf :DispersionBand ;
    skos:definition "The group velocity associated with a solution to the wave equation. This can be computed as the gradient of the eigenfrequency with respect to the wavevector."@en,
                    "La vitesse de groupe associée à une solution de l'équation d'onde. Elle peut être calculée comme le gradient de la fréquence propre par rapport au vecteur d'onde."@fr,
                    "La velocidad de grupo asociada con una solución de la ecuación de onda. Esto se puede calcular como el gradiente de la autofrecuencia con respecto al vector de onda."@es,
                    "Die Gruppengeschwindigkeit, die mit einer Lösung der Wellengleichung verbunden ist. Diese kann als der Gradient der Eigenfrequenz in Bezug auf den Wellenvektor berechnet werden."@de .

:GroupVelocityBand a owl:Class ;
    rdfs:label "Group Velocity Band"@en, "Bande de vitesse de groupe"@fr, "Banda de velocidad de grupo"@es, "Gruppengeschwindigkeitsband"@de ;
    rdfs:subClassOf :DispersionBand .

:HexagonalGeometry a owl:Class ;
    rdfs:label "Hexagonal Geometry"@en, "Géométrie hexagonale"@fr, "Geometría hexagonal"@es, "Hexagonale Geometrie"@de ;
    rdfs:subClassOf :2DGeometry ;
    skos:definition "The shape of the unit cell: Regular hexagon."@en,
                    "La forme de la cellule unitaire : Hexagone régulier."@fr,
                    "La forma de la celda unitaria: Hexágono regular."@es,
                    "Die Form der Einheitszelle: Regelmäßiges Sechseck."@de .

:HyperElasticMaterialPhysicsModel a owl:Class ;
    rdfs:label "Hyper Elastic Material Physics Model"@en, "Modèle physique de matériau hyperélastique"@fr, "Modelo físico de material hiperelástico"@es, "Hyperelastisches Materialphysikmodell"@de ;
    skos:definition "A constitutive model of a hyper-elastic material, materials that undergo large deformations elastically."@en,
                    "Un modèle constitutif d'un matériau hyperélastique, des matériaux qui subissent de grandes déformations de manière élastique."@fr,
                    "Un modelo constitutivo de un material hiperelástico, materiales que experimentan grandes deformaciones de manera elástica."@es,
                    "Ein konstitutives Modell eines hyperelastischen Materials, Materialien, die große elastische Verformungen durchlaufen."@de ;
    prov:wasQuotedFrom <https://en.wikipedia.org/wiki/Hyperelastic_material> .

:Index a owl:Class ;
    rdfs:label "Index"@en, "Indice"@fr, "Índice"@es, "Index"@de ;
    rdfs:subClassOf sio:SIO_000015 ;
    skos:definition "Refers to an index in the indicial notation of vectors, matrices, and tensors."@en,
                    "Fait référence à un indice dans la notation indicielle des vecteurs, matrices et tenseurs."@fr,
                    "Se refiere a un índice en la notación indicial de vectores, matrices y tensores."@es,
                    "Bezieht sich auf einen Index in der indiziellen Notation von Vektoren, Matrizen und Tensoren."@de .

:InfiniteMetamaterial a owl:Class ;
    rdfs:label "Infinite Metamaterial"@en, "Métamatériau infini"@fr, "Metamaterial infinito"@es, "Unendliches Metamaterial"@de ;
    rdfs:subClassOf :Metamaterial ;
    skos:definition "A metamaterial that doesn't have a finite length, that extends infinitely in the space."@en,
                    "Un métamatériau qui n'a pas une longueur finie, qui s'étend à l’infini dans l'espace."@fr,
                    "Un metamaterial que no tiene una longitud finita, que se extiende infinitamente en el espacio."@es,
                    "Ein Metamaterial, das keine endliche Länge hat und sich unendlich im Raum erstreckt."@de .

:IrreducibleBrillouinZone a owl:Class ;
    rdfs:label "Irreducible Brillouin Zone"@en, "Zone de Brillouin irréductible"@fr, "Zona de Brillouin irreducible"@es, "Irreduzible Brillouin-Zone"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :IrreducibleBrillouinZoneContour ],
            :ReciprocalSpaceGeometry ;
    skos:definition "The smallest subspace of wavevector space that can be tessellated to form the dispersion relation over the entire wavevector space. Also the largest subspace of wavevector space that does not contain redundant information. The shape and size of this subspace depends on the geometry and symmetry of the unit cell."@en,
                    "Le plus petit sous-espace de l’espace des vecteurs d’onde qui peut être tessellé pour former la relation de dispersion sur l’ensemble de l’espace des vecteurs d’onde. C’est aussi le plus grand sous-espace de l’espace des vecteurs d’onde qui ne contient pas d’informations redondantes. La forme et la taille de ce sous-espace dépendent de la géométrie et de la symétrie de la cellule unitaire."@fr,
                    "El subespacio más pequeño del espacio de vectores de onda que puede teselar para formar la relación de dispersión en todo el espacio de vectores de onda. También es el subespacio más grande del espacio de vectores de onda que no contiene información redundante. La forma y el tamaño de este subespacio dependen de la geometría y la simetría de la celda unitaria."@es,
                    "Der kleinste Unterraum des Wellenvektorraums, der getesselt werden kann, um die Dispersionsrelation über den gesamten Wellenvektorraum zu bilden. Er ist auch der größte Unterraum des Wellenvektorraums, der keine redundanten Informationen enthält. Die Form und Größe dieses Unterraums hängen von der Geometrie und Symmetrie der Einheitszelle ab."@de .

:IrreducibleBrillouinZoneContour a owl:Class ;
    rdfs:label "Irreducible Brillouin Zone Contour"@en, "Contour de la zone de Brillouin irréductible"@fr, "Contorno de la zona de Brillouin irreducible"@es, "Kontur der irreduziblen Brillouin-Zone"@de ;
    rdfs:subClassOf :ReciprocalSpaceGeometry ;
    skos:definition "A contour in wavevector space that traverses the perimeter of the Irreducible Brillouin Zone."@en,
                    "Un contour dans l’espace des vecteurs d’onde qui parcourt le périmètre de la zone de Brillouin irréductible."@fr,
                    "Un contorno en el espacio del vector de onda que recorre el perímetro de la Zona de Brillouin Irreducible."@es,
                    "Eine Kontur im Wellenvektorraum, die den Umfang der irreduziblen Brillouin-Zone durchläuft."@de .

:KirchhoffLovePlate a owl:Class ;
    rdfs:label "Kirchhoff Love Plate"@en, "Plaque de Kirchhoff-Love"@fr, "Placa de Kirchhoff-Love"@es, "Kirchhoff-Love-Platte"@de ;
    skos:definition "A two-dimensional mathematical model that is used to determine the stresses and deformations in thin plates subjected to forces and moments. Applicable primarily for small deformations neglecting the effects of shear deformations."@en,
                    "Un modèle mathématique bidimensionnel utilisé pour déterminer les contraintes et les déformations dans des plaques minces soumises à des forces et des moments. Applicable principalement pour les petites déformations, négligeant les effets des déformations de cisaillement."@fr,
                    "Un modelo matemático bidimensional utilizado para determinar los esfuerzos y deformaciones en placas delgadas sometidas a fuerzas y momentos. Aplicable principalmente para pequeñas deformaciones, ignorando los efectos de las deformaciones por cizallamiento."@es,
                    "Ein zweidimensionales mathematisches Modell, das verwendet wird, um die Spannungen und Verformungen in dünnen Platten zu bestimmen, die Kräften und Momenten ausgesetzt sind. Hauptsächlich anwendbar für kleine Verformungen, wobei die Effekte von Scherverformungen vernachlässigt werden."@de .

:KinematicModel a owl:Class ;
    rdfs:label "Kinematic Model"@en, "Modèle cinématique"@fr, "Modelo cinemático"@es, "Kinematisches Modell"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :SolidContinuumPhysicsModel ] ;
    skos:definition "A model of a system that primarily describes the motion such as displacements, velocities etc without describing the cause of the motion."@en,
                    "Un modèle d’un système qui décrit principalement le mouvement, comme les déplacements, les vitesses, etc., sans décrire la cause du mouvement."@fr,
                    "Un modelo de un sistema que describe principalmente el movimiento, como desplazamientos, velocidades, etc., sin describir la causa del movimiento."@es,
                    "Ein Modell eines Systems, das hauptsächlich die Bewegung beschreibt, wie Verschiebungen, Geschwindigkeiten usw., ohne die Ursache der Bewegung zu beschreiben."@de .

:LameConstantLambda a owl:Class ;
    rdfs:label "Lame Constant Lambda"@en, "Constante de Lamé Lambda"@fr, "Constante de Lamé Lambda"@es, "Lamé-Konstante Lambda"@de ;
    skos:definition "One of the two isotropic small strain elasticity stiffness tensor parameters: Relates hydrostatic stress with hydrostatic strain."@en,
                    "L'un des deux paramètres du tenseur de rigidité de l'élasticité à petite déformation isotrope : Relie la contrainte hydrostatique à la déformation hydrostatique."@fr,
                    "Uno de los dos parámetros del tensor de rigidez de la elasticidad isotrópica de pequeña deformación: Relaciona el esfuerzo hidrostático con la deformación hidrostática."@es,
                    "Einer der zwei isotropen Parameter des Steifigkeitstensors für kleine Verformungen: Verknüpft hydrostatische Spannung mit hydrostatischer Verformung."@de .

:LameConstantMu a owl:Class ;
    rdfs:label "Lame Constant Mu"@en, "Constante de Lamé Mu"@fr, "Constante de Lamé Mu"@es, "Lamé-Konstante Mu"@de ;
    skos:definition "One of the two isotropic small strain elasticity stiffness tensor parameters: Relates deviatoric stress with deviatoric strain."@en,
                    "L'un des deux paramètres du tenseur de rigidité de l'élasticité à petite déformation : Relie la contrainte déviatorique à la déformation déviatorique."@fr,
                    "Uno de los dos parámetros del tensor de rigidez de la elasticidad isotrópica de pequeña deformación: Relaciona el esfuerzo desviador con la deformación desviadora."@es,
                    "Einer der zwei isotropen Parameter des Steifigkeitstensors für kleine Verformungen: Verknüpft deviatorische Spannung mit deviatorischer Deformation."@de .

:LatticeBasis a owl:Class ;
    rdfs:label "Lattice Basis"@en, "Base de réseau"@fr, "Base de red"@es, "Gitterbasis"@de ;
    skos:altLabel "Lattice Vectors"@en, "Vecteurs de réseau"@fr, "Vectores de red"@es, "Gittervektoren"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :CartesianVector ],
            sio:SIO_001433 .

:LatticeVector a owl:Class ;
    rdfs:label "Lattice Vector"@en, "Vecteur de réseau"@fr, "Vector de red"@es, "Gittervektor"@de ;
    rdfs:subClassOf sio:SIO_000041 ;
    skos:definition "A matrix composed of multiple Cartesian vectors, each representing a lattice vector. The combination of lattice vectors defines the lattice geometry."@en,
                    "Une matrice composée de plusieurs vecteurs cartésiens, chacun représentant un vecteur de réseau. La combinaison des vecteurs de réseau définit la géométrie du réseau."@fr,
                    "Una matriz compuesta por varios vectores cartesianos, cada uno representando un vector de red. La combinación de vectores de red define la geometría de la red."@es,
                    "Eine Matrix, die aus mehreren kartesischen Vektoren besteht, wobei jeder ein Gittervektor darstellt. Die Kombination der Gittervektoren definiert die Gittergeometrie."@de .

:LatticeVectors a owl:Class ;
    rdfs:label "Lattice Vectors"@en, "Vecteurs de réseau"@fr, "Vectores de red"@es, "Gittervektoren"@de ;
    skos:definition "Lattice vectors represent the edges of a unit cell of a lattice."@en,
                    "Les vecteurs de réseau représentent les bords d'une cellule unitaire d'un réseau."@fr,
                    "Los vectores de red representan los bordes de una celda unitaria de una red."@es,
                    "Gittervektoren repräsentieren die Kanten einer Einheitszelle eines Gitters."@de .

:LinearElastic a owl:Class ;
    rdfs:label "Linear Elastic"@en, "Élastique linéaire"@fr, "Elástico lineal"@es, "Linear elastisch"@de ;
    skos:definition "If a material is linear elastic, it means that it can be well-modeled by the theory of linear elasticity. This means that deformations and strains are linearly proportional to loads. It also means that the technique of superposition can be applied."@en,
                    "Si un matériau est élastique linéaire, cela signifie qu'il peut être bien modélisé par la théorie de l'élasticité linéaire. Cela signifie que les déformations et les contraintes sont proportionnelles linéairement aux charges. Cela signifie également que la technique de superposition peut être appliquée."@fr,
                    "Si un material es elástico lineal, significa que puede modelarse adecuadamente mediante la teoría de la elasticidad lineal. Esto implica que las deformaciones y las tensiones son proporcionalmente lineales a las cargas. También significa que se puede aplicar la técnica de superposición."@es,
                    "Wenn ein Material linear elastisch ist, bedeutet dies, dass es durch die Theorie der linearen Elastizität gut modelliert werden kann. Dies bedeutet, dass Verformungen und Spannungen linear proportional zu den Lasten sind. Es bedeutet auch, dass die Technik der Superposition angewendet werden kann."@de .

:LinearPhysicsModel a owl:Class ;
    rdfs:label "Linear Physics Model"@en, "Modèle physique linéaire"@fr, "Modelo físico lineal"@es, "Lineares Physikmodell"@de ;
    rdfs:subClassOf :PhysicsModel ;
    skos:definition "A model of a system in which the change of the output is proportional to the change of the input."@en,
                    "Un modèle d'un système dans lequel le changement de la sortie est proportionnel au changement de l'entrée."@fr,
                    "Un modelo de un sistema en el que el cambio de la salida es proporcional al cambio de la entrada."@es,
                    "Ein Modell eines Systems, bei dem die Änderung der Ausgabe proportional zur Änderung der Eingabe ist."@de ;
    prov:wasQuotedFrom <https://en.wikipedia.org/wiki/Nonlinear_system> .

:Location a owl:Class ;
    rdfs:label "Location"@en, "Emplacement"@fr, "Ubicación"@es, "Ort"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :BandGapLocation ] ;
    skos:definition "Position within a space."@en,
                    "Position dans un espace."@fr,
                    "Posición dentro de un espacio."@es,
                    "Position innerhalb eines Raums."@de .

:MagneticMaterialPhysicsModel a owl:Class ;
    rdfs:label "Magnetic Material Physics Model"@en, "Modèle physique de matériau magnétique"@fr, "Modelo físico de material magnético"@es, "Magnetisches Materialphysikmodell"@de ;
    skos:definition "A model of a material/system that models interactions caused by magnetism."@en,
                    "Un modèle d'un matériau/système qui modélise les interactions causées par le magnétisme."@fr,
                    "Un modelo de un material/sistema que modela las interacciones causadas por el magnetismo."@es,
                    "Ein Modell eines Materials/Systems, das Interaktionen modelliert, die durch Magnetismus verursacht werden."@de .

:MassSpringPhysicsModel a owl:Class ;
    rdfs:label "Mass Spring Physics Model"@en, "Modèle physique de masse-ressort"@fr, "Modelo físico de masa-resorte"@es, "Masse-Feder-Physikmodell"@de ;
    rdfs:subClassOf :PhysicsModel ;
    skos:definition "A dynamic system modeled using a mass attached to a spring, with or without damping effects."@en,
                    "Un système dynamique modélisé à l'aide d'une masse attachée à un ressort, avec ou sans effets d'amortissement."@fr,
                    "Un sistema dinámico modelado usando una masa unida a un resorte, con o sin efectos de amortiguación."@es,
                    "Ein dynamisches System, das mit einer an einer Feder befestigten Masse modelliert wird, mit oder ohne Dämpfungseffekte."@de .

:Material a owl:Class ;
    rdfs:label "Material"@en, "Matériau"@fr, "Material"@es, "Material"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :LameConstantMu ],
        [ a owl:Restriction ;
            owl:someValuesFrom :ShearModulus ],
        [ a owl:Restriction ;
            owl:someValuesFrom :YoungModulus ],
        [ a owl:Restriction ;
            owl:someValuesFrom sio:SIO_001406 ],
        [ a owl:Restriction ;
            owl:someValuesFrom :PoissonRatio ],
        [ a owl:Restriction ;
            owl:someValuesFrom :LameConstantLambda ] ;
    skos:definition "A physical entity that has mass."@en,
                    "Une entité physique qui a une masse."@fr,
                    "Una entidad física que tiene masa."@es,
                    "Eine physikalische Entität, die Masse hat."@de .

:MetamaterialChart a owl:Class ;
    rdfs:label "Metamaterial Chart"@en, "Graphique de métamatériau"@fr, "Gráfico de metamaterial"@es, "Metamaterialdiagramm"@de ;
    rdfs:subClassOf sio:SIO_000904 ;
    skos:definition "Charts that have the primary topic of metamaterials."@en,
                    "Graphiques ayant pour sujet principal les métamatériaux."@fr,
                    "Gráficos que tienen como tema principal los metamateriales."@es,
                    "Diagramme, die das Hauptthema Metamaterialien haben."@de .

:MetamaterialDataset a owl:Class ;
    rdfs:label "Metamaterial Dataset"@en, "Jeu de données de métamatériau"@fr, "Conjunto de datos de metamaterial"@es, "Metamaterial-Datensatz"@de ;
    rdfs:subClassOf <dcat:Dataset> ;
    skos:definition "Datasets that have the primary topic of metamaterials."@en,
                    "Jeux de données ayant pour sujet principal les métamatériaux."@fr,
                    "Conjuntos de datos que tienen como tema principal los metamateriales."@es,
                    "Datensätze, die das Hauptthema Metamaterialien haben."@de .

:MetamaterialFigure a owl:Class ;
    rdfs:label "Metamaterial Figure"@en, "Figure de métamatériau"@fr, "Figura de metamaterial"@es, "Metamaterialabbildung"@de ;
    rdfs:subClassOf sio:SIO_000903 ;
    skos:definition "Figures that have the primary topic of metamaterials."@en,
                    "Figures ayant pour sujet principal les métamatériaux."@fr,
                    "Figuras que tienen como tema principal los metamateriales."@es,
                    "Abbildungen, die das Hauptthema Metamaterialien haben."@de .

:MindlinReissnerPlate a owl:Class ;
    rdfs:label "Mindlin Reissner Plate"@en, "Plaque de Mindlin-Reissner"@fr, "Placa de Mindlin-Reissner"@es, "Mindlin-Reissner-Platte"@de ;
    skos:definition "A two-dimensional mathematical model that is used to determine the stresses and large-deformations in thin plates subjected to forces and moments."@en,
                    "Un modèle mathématique bidimensionnel utilisé pour déterminer les contraintes et les grandes déformations dans des plaques minces soumises à des forces et des moments."@fr,
                    "Un modelo matemático bidimensional utilizado para determinar los esfuerzos y las grandes deformaciones en placas delgadas sometidas a fuerzas y momentos."@es,
                    "Ein zweidimensionales mathematisches Modell, das verwendet wird, um die Spannungen und großen Verformungen in dünnen Platten zu bestimmen, die Kräften und Momenten ausgesetzt sind."@de .

:Model a owl:Class ;
    rdfs:label "Model"@en, "Modèle"@fr, "Modelo"@es, "Modell"@de ;
    skos:definition "An informative representation of an object or system."@en,
                    "Une représentation informative d’un objet ou d’un système."@fr,
                    "Una representación informativa de un objeto o sistema."@es,
                    "Eine informative Darstellung eines Objekts oder Systems."@de .

:ModeType a owl:Class ;
    rdfs:label "Mode Type"@en, "Type de mode"@fr, "Tipo de modo"@es, "Modustyp"@de ;
    skos:definition "The type of wave mode associated with a solution to the wave equation."@en,
                    "Le type de mode d'onde associé à une solution de l'équation d'onde."@fr,
                    "El tipo de modo de onda asociado con una solución de la ecuación de onda."@es,
                    "Der Typ des Wellenmodus, der mit einer Lösung der Wellengleichung verbunden ist."@de .

:MolecularDynamicsPhysicsModel a owl:Class ;
    rdfs:label "Molecular Dynamics Physics Model"@en, "Modèle physique de dynamique moléculaire"@fr, "Modelo físico de dinámica molecular"@es, "Molekulardynamik-Physikmodell"@de ;
    rdfs:subClassOf :PhysicsModel ;
    skos:definition "A model that uses molecular dynamics (MD) for computer simulation of a system. Often used for analyzing the physical movements of atoms and molecules."@en,
                    "Un modèle qui utilise la dynamique moléculaire (MD) pour la simulation informatique d’un système. Souvent utilisé pour analyser les mouvements physiques des atomes et des molécules."@fr,
                    "Un modelo que utiliza la dinámica molecular (MD) para la simulación por computadora de un sistema. A menudo se usa para analizar los movimientos físicos de átomos y moléculas."@es,
                    "Ein Modell, das Molekulardynamik (MD) für die Computersimulation eines Systems verwendet. Häufig genutzt zur Analyse der physikalischen Bewegungen von Atomen und Molekülen."@de ;
    prov:wasQuotedFrom <https://en.wikipedia.org/wiki/Molecular_dynamics> .

:MultiMaterial a owl:Class ;
    rdfs:label "Multi Material"@en, "Multi-matériau"@fr, "Multimaterial"@es, "Multimaterial"@de ;
    rdfs:subClassOf :Material ;
    skos:definition "A material composed of two or more distinct materials."@en,
                    "Un matériau composé de deux ou plusieurs matériaux distincts."@fr,
                    "Un material compuesto por dos o más materiales distintos."@es,
                    "Ein Material, das aus zwei oder mehr unterschiedlichen Materialien besteht."@de .

:NanomaterialDataset a owl:Class ;
    rdfs:label "Nanomaterial Dataset"@en, "Jeu de données de nanomatériau"@fr, "Conjunto de datos de nanomaterial"@es, "Nanomaterial-Datensatz"@de ;
    rdfs:subClassOf <dcat:Dataset> ;
    skos:definition "Datasets that have the primary topic of nanomaterials."@en,
                    "Jeux de données ayant pour sujet principal les nanomatériaux."@fr,
                    "Conjuntos de datos que tienen como tema principal los nanomateriales."@es,
                    "Datensätze, die das Hauptthema Nanomaterialien haben."@de .

:NanomaterialChart a owl:Class ;
    rdfs:label "Nanomaterial Chart"@en, "Graphique de nanomatériau"@fr, "Gráfico de nanomaterial"@es, "Nanomaterialdiagramm"@de ;
    rdfs:subClassOf sio:SIO_000904 ;
    skos:definition "Charts that have the primary topic of nanomaterials."@en,
                    "Graphiques ayant pour sujet principal les nanomatériaux."@fr,
                    "Gráficos que tienen como tema principal los nanomateriales."@es,
                    "Diagramme, die das Hauptthema Nanomaterialien haben."@de .

:NonlinearPhysicsModel a owl:Class ;
    rdfs:label "Nonlinear Physics Model"@en, "Modèle physique non linéaire"@fr, "Modelo físico no lineal"@es, "Nichtlineares Physikmodell"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :PhysicsModel ] ;
    skos:definition "A model of a nonlinear system in which the change of the output is not proportional to the change of the input."@en,
                    "Un modèle d’un système non linéaire dans lequel le changement de la sortie n’est pas proportionnel au changement de l’entrée."@fr,
                    "Un modelo de un sistema no lineal en el que el cambio de la salida no es proporcional al cambio de la entrada."@es,
                    "Ein Modell eines nichtlinearen Systems, bei dem die Änderung der Ausgabe nicht proportional zur Änderung der Eingabe ist."@de ;
    prov:wasQuotedFrom <https://en.wikipedia.org/wiki/Nonlinear_system> .

:NormalizedFrequency a owl:Class ;
    rdfs:label "Normalized Frequency"@en, "Fréquence normalisée"@fr, "Frecuencia normalizada"@es, "Normalisierte Frequenz"@de ;
    rdfs:subClassOf sio:SIO_001367, sio:SIO_001018 .

:ParallelepipedGeometry a owl:Class ;
    rdfs:label "Parallelepiped Geometry"@en, "Géométrie du parallélépipède"@fr, "Geometría del paralelepípedo"@es, "Geometrie des Parallelepipeds"@de ;
    rdfs:subClassOf :3DGeometry ;
    skos:definition "The shape of the unitcell: Characterized by a parallelogram with two unequal side lengths, and the angle between the sides is either acute or obtuse. "@en,
                    "La forme de la cellule unitaire : caractérisée par un parallélogramme avec deux longueurs de côtés inégales, et l'angle entre les côtés est soit aigu, soit obtus."@fr,
                    "La forma de la celda unitaria: caracterizada por un paralelogramo con dos longitudes de lado desiguales, y el ángulo entre los lados es agudo u obtuso."@es,
                    "Die Form der Einheitszelle: Charakterisiert durch ein Parallelogramm mit zwei ungleichen Seitenlängen, wobei der Winkel zwischen den Seiten entweder spitz oder stumpf ist."@de .

:ParametricGeometry a owl:Class ;
    rdfs:label "Parametric Geometry"@en, "Géométrie paramétrique"@fr, "Geometría paramétrica"@es, "Parametrische Geometrie"@de ;
    rdfs:subClassOf :Geometry ;
    skos:definition "Representing a geometry using a function of independent variables (i.e., parameters)."@en,
                    "Représentation d’une géométrie à l’aide d’une fonction de variables indépendantes (c.-à-d. paramètres)."@fr,
                    "Representación de una geometría utilizando una función de variables independientes (es decir, parámetros)."@es,
                    "Darstellung einer Geometrie mittels einer Funktion unabhängiger Variablen (d.h. Parameter)."@de .

:ParametricMaterialPropertyField a owl:Class ;
    rdfs:label "Parametric Material Property Field"@en, "Champ de propriétés matérielles paramétrique"@fr, "Campo de propiedades materiales paramétrico"@es, "Parametrisches Materialeigenschaftsfeld"@de ;
    rdfs:subClassOf :MaterialPropertyField ;
    skos:definition "A variable that describes the distribution of materials using the parameters defined by the user."@en,
                    "Une variable qui décrit la distribution des matériaux à l’aide des paramètres définis par l’utilisateur."@fr,
                    "Una variable que describe la distribución de materiales utilizando los parámetros definidos por el usuario."@es,
                    "Eine Variable, die die Verteilung von Materialien mit den vom Benutzer definierten Parametern beschreibt."@de .

:Periodic a owl:Class ;
    rdfs:label "Periodic"@en, "Périodique"@fr, "Periódico"@es, "Periodisch"@de ;
    rdfs:subClassOf :Periodicity ;
    skos:definition "Appearing or occurring at intervals."@en,
                    "Apparaissant ou se produisant à intervalles réguliers."@fr,
                    "Que aparece o ocurre a intervalos."@es,
                    "In regelmäßigen Abständen auftretend oder vorkommend."@de .

:Periodicity a owl:Class ;
    rdfs:label "Periodicity"@en, "Périodicité"@fr, "Periodicidad"@es, "Periodizität"@de ;
    skos:definition "The character of being periodic."@en,
                    "Le caractère d’être périodique"@fr,
                    "El carácter de ser periódico."@es,
                    "Der Charakter, periodisch zu sein."@de .

:PhaseVelocity a owl:Class ;
    rdfs:label "Phase Velocity"@en, "Vitesse de phase"@fr, "Velocidad de fase"@es, "Phasengeschwindigkeit"@de ;
    rdfs:subClassOf sio:SIO_001369, :DispersionBand ;
    skos:definition "The phase velocity associated with a solution to the wave equation. This can be computed as the eigenfrequency divided by each component of the wavevector."@en,
                    "La vitesse de phase associée à une solution de l'équation des ondes. Elle peut être calculée en divisant la fréquence propre par chaque composante du vecteur d'onde."@fr,
                    "La velocidad de fase asociada con una solución de la ecuación de ondas. Se puede calcular dividiendo la frecuencia propia entre cada componente del vector de onda."@es,
                    "Die Phasengeschwindigkeit, die mit einer Lösung der Wellengleichung verbunden ist. Sie kann berechnet werden, indem die Eigenfrequenz durch jede Komponente des Wellenvektors geteilt wird."@de .

:PhaseVelocityBand a owl:Class ;
    rdfs:label "Phase Velocity Band"@en, "Bande de vitesse de phase"@fr, "Banda de velocidad de fase"@es, "Phasengeschwindigkeitsband"@de ;
    rdfs:subClassOf :DispersionBand .

:PhotonicDispersionRelation a owl:Class ;
    rdfs:label "Photonic Dispersion Relation"@en, "Relation de dispersion photonique"@fr, "Relación de dispersión fotónica"@es, "Photonische Dispersionsrelation"@de ;
    rdfs:subClassOf :DispersionRelation ;
    skos:definition "A dispersion relation in a medium defined for optical properties."@en,
                    "Une relation de dispersion dans un milieu définie pour les propriétés optiques."@fr,
                    "Una relación de dispersión en un medio definida para propiedades ópticas."@es,
                    "Eine Dispersionsrelation in einem Medium, definiert für optische Eigenschaften."@de .

:PhononicDispersionRelation a owl:Class ;
    rdfs:label "Phononic Dispersion Relation"@en, "Relation de dispersion phononique"@fr, "Relación de dispersión fonónica"@es, "Phononische Dispersionsrelation"@de ;
    rdfs:subClassOf :DispersionRelation ;
    skos:definition "A dispersion relation in a medium defined for acoustic properties."@en,
                    "Une relation de dispersion dans un milieu définie pour les propriétés acoustiques."@fr,
                    "Una relación de dispersión en un medio definida para propiedades acústicas."@es,
                    "Eine Dispersionsrelation in einem Medium, definiert für akustische Eigenschaften."@de .

:PhysicalSpaceGeometry a owl:Class ;
    rdfs:label "Physical Space Geometry"@en, "Géométrie de l'espace physique"@fr, "Geometría del espacio físico"@es, "Physikalische Raumgeometrie"@de ;
    rdfs:subClassOf :UnitCellGeometry .

:PhysicsModel a owl:Class ;
    rdfs:label "Physics Model"@en, "Modèle physique"@fr, "Modelo físico"@es, "Physikmodell"@de ;
    rdfs:subClassOf :Continuous ;
    skos:definition "A model of a system to study a specific physics, for example linear elasticity, dielectricity etc. "@en,
                    "Un modèle d’un système pour étudier une physique spécifique, par exemple l’élasticité linéaire, la diélectricité, etc."@fr,
                    "Un modelo de un sistema para estudiar una física específica, por ejemplo, la elasticidad lineal, la dieléctrica, etc."@es,
                    "Ein Modell eines Systems zur Untersuchung einer bestimmten Physik, zum Beispiel lineare Elastizität, Dielektrizität usw."@de .

:Pixel a owl:Class ;
    rdfs:label "Pixel"@en, "Pixel"@fr, "Píxel"@es, "Pixel"@de ;
    rdfs:subClassOf sio:SIO_000015 ;
    skos:definition "A discretized, symbolic representation of a material substance in 2D space."@en,
                    "Une représentation discrétisée et symbolique d'une substance matérielle dans un espace 2D."@fr,
                    "Una representación simbólica discretizada de una sustancia material en un espacio 2D."@es,
                    "Eine diskretisierte symbolische Darstellung einer materiellen Substanz im 2D-Raum."@de .

:PixelCountVector a owl:Class ;
    rdfs:label "Pixel Count Vector"@en, "Vecteur de nombre de pixels"@fr, "Vector de conteo de píxeles"@es, "Pixelanzahl-Vektor"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom sio:SIO_000794 ],
            sio:SIO_001430 ;
    skos:definition "A vector with each entry representing the number (count) of pixels along each of the lattice vectors."@en,
                    "Un vecteur dont chaque entrée représente le nombre (compte) de pixels le long de chacun des vecteurs du réseau."@fr,
                    "Un vector en el que cada entrada representa la cantidad (recuento) de píxeles a lo largo de cada uno de los vectores de la red."@es,
                    "Ein Vektor, bei dem jeder Eintrag die Anzahl (Zahl) der Pixel entlang jedes der Gittervektoren darstellt."@de .

:PixelLengthVector a owl:Class ;
    rdfs:label "Pixel Length Vector"@en, "Vecteur de longueur de pixel"@fr, "Vector de longitud de píxel"@es, "Pixel-Längenvektor"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom sio:SIO_000041 ],
            sio:SIO_001430 ;
    skos:definition "A vector with each entry representing the length (defined in physical units, e.g. m) per pixel along each of the lattice vectors."@en,
                    "Un vecteur dont chaque entrée représente la longueur (définie en unités physiques, par exemple m) par pixel le long de chacun des vecteurs de réseau."@fr,
                    "Un vector en el que cada entrada representa la longitud (definida en unidades físicas, por ejemplo, m) por píxel a lo largo de cada uno de los vectores de red."@es,
                    "Ein Vektor, bei dem jeder Eintrag die Länge (definiert in physikalischen Einheiten, z.B. m) pro Pixel entlang der Gittervektoren darstellt."@de .

:PixelatedUnitCell a owl:Class ;
    rdfs:label "Pixelated Unit Cell"@en, "Cellule unitaire pixellisée"@fr, "Celda unitaria pixelada"@es, "Pixelierte Einheitszelle"@de ;
    rdfs:subClassOf :UnitCellGeometry ;
    skos:definition "The unit cell is divided into discrete pixels, each assigned a material property."@en,
                    "La cellule unitaire est divisée en pixels discrets, chacun assigné à une propriété matérielle."@fr,
                    "La celda unitaria se divide en píxeles discretos, cada uno asignado a una propiedad material."@es,
                    "Die Einheitszelle ist in diskrete Pixel unterteilt, von denen jedes eine Materialeigenschaft zugewiesen wird."@de .

:PixelMaterialPropertyField a owl:Class ;
    rdfs:label "Pixel Material Property Field"@en, "Champ de propriétés matérielles pixellisé"@fr, "Campo de propiedades materiales pixelado"@es, "Pixel-Materialeigenschaftsfeld"@de ;
    rdfs:subClassOf :MaterialPropertyField ;
    skos:definition "Material property field represented as a pixelated image."@en,
                    "Champ de propriétés matérielles représenté sous forme d’image pixellisée."@fr,
                    "Campo de propiedades materiales representado como una imagen pixelada."@es,
                    "Materialeigenschaftsfeld, dargestellt als pixelisiertes Bild."@de .

:PlaneStrain a owl:Class ;
    rdfs:label "Plane Strain"@en, "Déformation plane"@fr, "Deformación plana"@es, "Ebene Verformung"@de ;
    rdfs:subClassOf :Strain ;
    skos:definition "A state of strain where the out of plane component of strain is zero."@en,
                    "Un état de déformation où la composante hors plan de la déformation est nulle."@fr,
                    "Un estado de deformación donde la componente fuera del plano de la deformación es cero."@es,
                    "Ein Verformungszustand, bei dem die Komponente der Verformung außerhalb der Ebene null ist."@de .

:PlaneStress a owl:Class ;
    rdfs:label "Plane Stress"@en, "Contrainte plane"@fr, "Esfuerzo plano"@es, "Ebene Spannung"@de ;
    rdfs:subClassOf :Stress ;
    skos:definition "A state of stress where the out of plane component of stress is zero."@en,
                    "Un état de contrainte où la composante hors plan de la contrainte est nulle."@fr,
                    "Un estado de esfuerzo donde la componente fuera del plano del esfuerzo es cero."@es,
                    "Ein Spannungszustand, bei dem die Komponente der Spannung außerhalb der Ebene null ist."@de .

:Plate a owl:Class ;
    rdfs:label "Plate"@en, "Plaque"@fr, "Placa"@es, "Platte"@de ;
    skos:definition "A slender 2D structural element with small thickness compared to planar dimensions. Plate primarily bears lateral loads."@en,
                    "Un élément structurel 2D élancé avec une faible épaisseur par rapport aux dimensions planes. La plaque supporte principalement des charges latérales."@fr,
                    "Un elemento estructural 2D delgado con un grosor pequeño en comparación con las dimensiones planas. La placa soporta principalmente cargas laterales."@es,
                    "Ein schlankes 2D-Strukturelement mit geringer Dicke im Vergleich zu den planareren Dimensionen. Die Platte trägt hauptsächlich seitliche Lasten."@de ;
    prov:wasQuotedFrom <https://en.wikipedia.org/wiki/Plate_theory> .

:PoissonRatio a owl:Class ;
    rdfs:label "Poisson Ratio"@en, "Rapport de Poisson"@fr, "Relación de Poisson"@es, "Poisson-Zahl"@de ;
    skos:definition "A measure of the deformation (expansion or contraction) of a material in directions perpendicular to the specific direction of loading."@en,
                    "Une mesure de la déformation (expansion ou contraction) d’un matériau dans les directions perpendiculaires à la direction spécifique de chargement."@fr,
                    "Una medida de la deformación (expansión o contracción) de un material en direcciones perpendiculares a la dirección específica de carga."@es,
                    "Eine Maßeinheit für die Verformung (Ausdehnung oder Kontraktion) eines Materials in Richtungen senkrecht zur spezifischen Belastungsrichtung."@de ;
    prov:wasQuotedFrom <https://en.wikipedia.org/wiki/Poisson%27s_ratio> .

:Porosity a owl:Class ;
    rdfs:label "Porosity"@en, "Porosité"@fr, "Porosidad"@es, "Porosität"@de ;
    skos:definition "A measure of the void spaces in a material."@en,
                    "Une mesure des espaces vides dans un matériau."@fr,
                    "Una medida de los espacios vacíos en un material."@es,
                    "Eine Maßeinheit für die Hohlräume in einem Material."@de .

:Property a owl:Class ;
    rdfs:label "Property"@en, "Propriété"@fr, "Propiedad"@es, "Eigenschaft"@de ;
    rdfs:subClassOf sio:SIO_000614 .

:PureShear a owl:Class ;
    rdfs:label "Pure Shear"@en, "Cisaillement pur"@fr, "Cizallamiento puro"@es, "Reiner Schub"@de ;
    skos:definition "A state of deformation, in which trace of a strain tensor is zero."@en,
                    "Un état de déformation dans lequel la trace d’un tenseur de déformation est nulle."@fr,
                    "Un estado de deformación en el que la traza de un tensor de deformación es cero."@es,
                    "Ein Verformungszustand, bei dem die Spur eines Verzerrungstensors null ist."@de .

:ReciprocalSpaceGeometry a owl:Class ;
    rdfs:label "Reciprocal Space Geometry"@en, "Géométrie de l'espace réciproque"@fr, "Geometría del espacio recíproco"@es, "Reziproke Raumgeometrie"@de ;
    rdfs:subClassOf :FirstBrillouinZone ;
    skos:definition "The Fourier transform of a periodic geometry."@en,
                    "La transformée de Fourier d’une géométrie périodique."@fr,
                    "La transformada de Fourier de una geometría periódica."@es,
                    "Die Fourier-Transformation einer periodischen Geometrie."@de .

:RectangularGeometry a owl:Class ;
    rdfs:label "Rectangular Geometry"@en, "Géométrie rectangulaire"@fr, "Geometría rectangular"@es, "Rechteckige Geometrie"@de ;
    rdfs:subClassOf :2DGeometry ;
    skos:definition "The shape of the unit cell: Characterized by a parallelogram with two unequal side lengths, perpendicular sides."@en,
                    "La forme de la cellule unitaire : Caractérisée par un parallélogramme avec deux longueurs de côtés inégales, des côtés perpendiculaires."@fr,
                    "La forma de la celda unitaria: Caracterizada por un paralelogramo con dos longitudes de lados desiguales, lados perpendiculares."@es,
                    "Die Form der Einheitszelle: Gekennzeichnet durch ein Parallelogramm mit zwei ungleichen Seitenlängen, senkrechten Seiten."@de .

:RepresentativeVolumeElementGeometry a owl:Class ;
    rdfs:label "Representative Volume Element Geometry"@en, "Géométrie de l'élément de volume représentatif"@fr, "Geometría del elemento de volumen representativo"@es, "Geometrie des repräsentativen Volumenelements"@de ;
    rdfs:subClassOf :Geometry ;
    skos:definition "The simplest repeating unit in a structure in 3D that will yield.the same behavior as the whole structure."@en,
                    "L’unité répétitive la plus simple dans une structure en 3D qui produira le même comportement que l’ensemble de la structure."@fr,
                    "La unidad repetitiva más simple en una estructura en 3D que dará el mismo comportamiento que toda la estructura."@es,
                    "Die einfachste sich wiederholende Einheit in einer 3D-Struktur, die das gleiche Verhalten wie die gesamte Struktur zeigt."@de .

:ShearModulus a owl:Class ;
    rdfs:label "Shear Modulus"@en, "Module de cisaillement"@fr, "Módulo de cizallamiento"@es, "Schermodul"@de ;
    skos:definition "A measure of the elastic shear stiffness of a material and is defined as the ratio of shear stress to the shear strain."@en,
                    "Une mesure de la rigidité au cisaillement élastique d’un matériau, définie comme le rapport entre la contrainte de cisaillement et la déformation de cisaillement."@fr,
                    "Una medida de la rigidez elástica al corte de un material, definida como la relación entre la tensión de corte y la deformación por corte."@es,
                    "Ein Maß für die elastische Schubsteifigkeit eines Materials, definiert als das Verhältnis von Schubspannung zu Schubverzerrung."@de ;
    prov:wasQuotedFrom <https://en.wikipedia.org/wiki/Shear_modulus> .

:Shell a owl:Class ;
    rdfs:label "Shell"@en, "Coque"@fr, "Carcasa"@es, "Schale"@de ;
    skos:definition "A slender three-dimensional curved structural element."@en,
                    "Un élément structurel tridimensionnel courbé et élancé."@fr,
                    "Un elemento estructural tridimensional curvado y delgado."@es,
                    "Ein schlankes, dreidimensionales, gekrümmtes Strukturelement."@de .

:SolidContinuumPhysicsModel a owl:Class ;
    rdfs:label "Solid Continuum Physics Model"@en, "Modèle physique de continuum solide"@fr, "Modelo físico de continuo sólido"@es, "Festkörperkontinuums-Physikmodell"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :MaterialConstitutiveModel ],
        [ a owl:Restriction ;
            owl:someValuesFrom :SolidMechanicsModel ],
            :PhysicsModel ;
    skos:definition "A model of a system where a material is represented as a continuum without considering any internal architectures or microstructures."@en,
                    "Un modèle d’un système où un matériau est représenté comme un continuum sans prendre en compte les architectures ou microstructures internes."@fr,
                    "Un modelo de un sistema donde un material se representa como un continuo sin considerar arquitecturas o microestructuras internas."@es,
                    "Ein Modell eines Systems, bei dem ein Material als Kontinuum dargestellt wird, ohne interne Architekturen oder Mikrostrukturen zu berücksichtigen."@de .

:SolidMechanicsModel a owl:Class ;
    rdfs:label "Solid Mechanics Model"@en, "Modèle de mécanique des solides"@fr, "Modelo de mecánica de sólidos"@es, "Festkörpermechanikmodell"@de ;
    rdfs:subClassOf :2DSolidMechanicsModel ;
    skos:definition "A model of a material/system that models interactions caused by forces resulting in stresses and strains."@en,
                    "Un modèle d’un matériau/système qui modélise les interactions causées par des forces entraînant des contraintes et des déformations."@fr,
                    "Un modelo de un material/sistema que modela las interacciones causadas por fuerzas que resultan en esfuerzos y deformaciones."@es,
                    "Ein Modell eines Materials/Systems, das Interaktionen modelliert, die durch Kräfte verursacht werden, die zu Spannungen und Verformungen führen."@de .

:SquareGeometry a owl:Class ;
    rdfs:label "Square Geometry"@en, "Géométrie carrée"@fr, "Geometría cuadrada"@es, "Quadratische Geometrie"@de ;
    rdfs:subClassOf :RectangularGeometry ;
    skos:definition "The shape of the unit cell: Characterized by a parallelogram with two equal side lengths, perpendicular sides."@en,
                    "La forme de la cellule unitaire : Caractérisée par un parallélogramme avec deux longueurs de côtés égales, des côtés perpendiculaires."@fr,
                    "La forma de la celda unitaria: Caracterizada por un paralelogramo con dos longitudes de lados iguales, lados perpendiculares."@es,
                    "Die Form der Einheitszelle: Gekennzeichnet durch ein Parallelogramm mit zwei gleichen Seitenlängen, senkrechten Seiten."@de .

:StrainTensor a owl:Class ;
    rdfs:label "Strain Tensor"@en, "Tenseur de déformation"@fr, "Tensor de deformación"@es, "Verzerrungstensor"@de ;
    rdfs:subClassOf sio:SIO_001429 ;
    skos:definition """The strain tensor of a material defines the deformation state of a material, where $epsilon$ is the infinitesimal strain tensor (a second order tensor)."""@en,
                    """Le tenseur de déformation d'un matériau définit l'état de déformation d'un matériau, où $epsilon$ est le tenseur de déformation infinitésimale (un tenseur de second ordre)."""@fr,
                    """El tensor de deformación de un material define el estado de deformación de un material, donde $epsilon$ es el tensor de deformación infinitesimal (un tensor de segundo orden)."""@es,
                    """Der Verzerrungstensor eines Materials definiert den Verformungszustand eines Materials, wobei $epsilon$ der infinitesimale Verzerrungstensor (ein Tensor zweiter Ordnung) ist."""@de .

:StressTensor a owl:Class ;
    rdfs:label "Stress Tensor"@en, "Tenseur de contrainte"@fr, "Tensor de esfuerzo"@es, "Spannungstensor"@de ;
    rdfs:subClassOf sio:SIO_001429 .

:StressVector a owl:Class ;
    rdfs:label "Stress Vector"@en, "Vecteur de contrainte"@fr, "Vector de esfuerzo"@es ;
    rdfs:subClassOf sio:SIO_001430 .

:StructuralGeometry a owl:Class ;
    rdfs:label "Structural Geometry"@en, "Géométrie structurelle"@fr, "Geometría estructural"@es, "Strukturgeometrie"@de ;
    rdfs:subClassOf :Geometry .

:SurrogateModel a owl:Class ;
    rdfs:label "Surrogate Model"@en, "Modèle de substitution"@fr, "Modelo sustituto"@es, "Surrogatmodell"@de ;
    rdfs:subClassOf :ConcretizedModel ;
    skos:definition "A model that mimics the input/output behavior of complex systems."@en,
                    "Un modèle qui imite le comportement entrée/sortie de systèmes complexes."@fr,
                    "Un modelo que imita el comportamiento de entrada/salida de sistemas complejos."@es,
                    "Ein Modell, das das Eingabe-/Ausgabeverhalten komplexer Systeme nachahmt."@de .

:Symmetry a owl:Class ;
    rdfs:label "Symmetry"@en, "Symétrie"@fr, "Simetría"@es, "Symmetrie"@de ;
    skos:definition "Symmetry group? Bravais lattice? (wondering if we need to separate out into more specific terms)"@en,
                    "Groupe de symétrie ? Réseau de Bravais ? (je me demande si nous devons séparer en termes plus spécifiques)"@fr,
                    "¿Grupo de simetría? ¿Red de Bravais? (me pregunto si necesitamos separar en términos más específicos)"@es,
                    "Symmetriegruppe? Bravais-Gitter? (frage mich, ob wir in spezifischere Begriffe aufteilen müssen)"@de .

:TangoBlack a owl:Class ;
    rdfs:label "Tango Black"@en, "Tango Noir"@fr, "Tango Negro"@es, "Tango Schwarz"@de ;
    rdfs:subClassOf sio:SIO_000004 ;
    skos:definition "A specific 3D printable material."@en, 
                    "Un matériau spécifique imprimable en 3D."@fr, 
                    "Un material específico imprimible en 3D."@es,
                    "Ein bestimmtes 3D-druckbares Material."@de .

:TimoshenkoBeam a owl:Class ;
    rdfs:label "Timoshenko Beam"@en, "Poutre de Timoshenko"@fr, "Viga de Timoshenko"@es, "Timoshenko-Träger"@de ;
    skos:definition "A mathematical model of a beam undergoing large deflections accounting for shear deformations."@en,
                    "Un modèle mathématique d’une poutre subissant de grandes déflexions en tenant compte des déformations de cisaillement."@fr,
                    "Un modelo matemático de una viga que experimenta grandes deflexiones considerando las deformaciones por cizallamiento."@es,
                    "Ein mathematisches Modell eines Trägers, der große Durchbiegungen erfährt und Scherdeformationen berücksichtigt."@de .

:TriangularGeometry a owl:Class ;
    rdfs:label "Triangular Geometry"@en, "Géométrie triangulaire"@fr, "Geometría triangular"@es, "Dreieckige Geometrie"@de ;
    rdfs:subClassOf :2DGeometry ;
    skos:definition "The shape of the unit cell: Equilateral triangle."@en,
                    "La forme de la cellule unitaire : Triangle équilatéral."@fr,
                    "La forma de la celda unitaria: Triángulo equilátero."@es,
                    "Die Form der Einheitszelle: Gleichseitiges Dreieck."@de .

:UnitCell a owl:Class ;
    rdfs:label "Unit Cell"@en, "Cellule unitaire"@fr, "Celda unitaria"@es, "Einheitszelle"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :MaterialPropertyField ],
        [ a owl:Restriction ;
            owl:someValuesFrom :UnitCellGeometry ],
        [ a owl:Restriction ;
            owl:someValuesFrom sio:SIO_000043 ] ;
    skos:definition "The simplest repeating unit in a structure."@en,
                    "L'unité répétitive la plus simple dans une structure."@fr,
                    "La unidad repetitiva más simple en una estructura."@es,
                    "Die einfachste sich wiederholende Einheit in einer Struktur."@de .

:UnitCellExtent_X a owl:Class ;
    rdfs:label "Unit Cell Extent X"@en, "Étendue de la cellule unitaire en X"@fr, "Extensión de la celda unitaria en X"@es, "Ausdehnung der Einheitszelle in X-Richtung"@de ;
    rdfs:subClassOf sio:SIO_000038 ;
    skos:definition "Extent of the unit cell in the x direction (requires units, such as mm:Pixel)"@en, 
                    "Étendue de la cellule unitaire dans la direction x (nécessite des unités, telles que mm:Pixel)"@fr, 
                    "Extensión de la celda unitaria en la dirección x (requiere unidades, como mm:Pixel)"@es,
                    "Ausdehnung der Elementarzelle in x-Richtung (Einheiten erforderlich, z. B. mm:Pixel)".

:UnitCellExtent_Y a owl:Class ;
    rdfs:label "Unit Cell Extent Y"@en, "Étendue de la cellule unitaire en Y"@fr, "Extensión de la celda unitaria en Y"@es, "Ausdehnung der Einheitszelle in Y-Richtung"@de ;
    rdfs:subClassOf sio:SIO_000038 ;
    skos:definition "Extent of the unit cell in the y direction (requires units, such as mm:Pixel)"@en, 
                    "Étendue de la cellule unitaire dans la direction y (nécessite des unités, telles que mm:Pixel)"@fr, 
                    "Extensión de la celda unitaria en la dirección y (requiere unidades, como mm:Pixel)"@es, 
                    "Ausdehnung der Elementarzelle in Y-Richtung (Einheiten erforderlich, z. B. mm:Pixel)" .

:UnitCellExtent_Z a owl:Class ;
    rdfs:label "Unit Cell Extent Z"@en, "Étendue de la cellule unitaire en Z"@fr, "Extensión de la celda unitaria en Z"@es, "Ausdehnung der Einheitszelle in Z-Richtung"@de ;
    rdfs:subClassOf sio:SIO_000038 ;
    skos:definition "Extent of the unit cell in the z direction (requires units, such as mm:Pixel)"@en, 
                    "Étendue de la cellule unitaire dans la direction z (nécessite des unités, telles que mm:Pixel)"@fr, 
                    "Extensión de la celda unitaria en la dirección z (requiere unidades, como mm:Pixel)"@es,
                    "Ausdehnung der Elementarzelle in Z-Richtung (Einheiten erforderlich, z. B. mm:Pixel)" .

:UnitCellGeometry a owl:Class ;
    rdfs:label "Unit Cell Geometry"@en, "Géométrie de la cellule unitaire"@fr, "Geometría de la celda unitaria"@es, "Geometrie der Einheitszelle"@de ;
    rdfs:subClassOf :Geometry ;
    skos:definition "The geometry of a unit cell."@en,
                    "La géométrie d'une cellule unitaire."@fr,
                    "La geometría de una celda unitaria."@es,
                    "Die Geometrie einer Einheitszelle."@de .

 :UserDefinedMaterialPropertyField a owl:Class ;
    rdfs:label "User Defined Material Property Field"@en, "Champ de propriétés matérielles défini par l’utilisateur"@fr, "Campo de propiedades materiales definido por el usuario"@es, "Benutzerdefiniertes Materialeigenschaftsfeld"@de ;
    rdfs:subClassOf :MaterialPropertyField ;
    skos:definition "A variable that describes the distribution of materials using the parameters defined by the user."@en,
                    "Une variable qui décrit la distribution des matériaux à l’aide des paramètres définis par l’utilisateur."@fr,
                    "Una variable que describe la distribución de materiales utilizando los parámetros definidos por el usuario."@es,
                    "Eine Variable, die die Verteilung von Materialien mit den vom Benutzer definierten Parametern beschreibt."@de .

:VeroWhite a owl:Class ;
    rdfs:label "Vero White"@en, "Vero Blanc"@fr, "Vero Blanco"@es, "Vero Weiß"@de ;
    rdfs:subClassOf sio:SIO_000004 ;
    skos:definition "A specific 3D printable material."@en, 
                    "Un matériau spécifique imprimable en 3D."@fr, 
                    "Un material específico imprimible en 3D."@es,
                    "Ein spezifisches 3D-druckbares Material."@de .

:ViscoelasticMaterialPhysicsModel a owl:Class ;
    rdfs:label "Viscoelastic Material Physics Model"@en, "Modèle physique de matériau viscoélastique"@fr, "Modelo físico de material viscoelástico"@es, "Viskoelastisches Materialphysikmodell"@de ;
    skos:definition "A constitutive model to describe the behavior of materials that exhibit both viscous and elastic characteristics when undergoing deformations."@en,
                    "Un modèle constitutif pour décrire le comportement des matériaux qui présentent à la fois des caractéristiques visqueuses et élastiques lorsqu’ils subissent des déformations."@fr,
                    "Un modelo constitutivo para describir el comportamiento de materiales que exhiben características tanto viscosas como elásticas cuando se deforman."@es,
                    "Ein konstitutives Modell zur Beschreibung des Verhaltens von Materialien, die sowohl viskose als auch elastische Eigenschaften bei Verformungen zeigen."@de .

:VoidFraction a owl:Class ;
    rdfs:label "Void Fraction"@en, "Fraction de vide"@fr, "Fracción de vacío"@es, "Porenanteil"@de ;
    skos:altLabel "Porosity"@en, "Porosité"@fr, "Porosidad"@es, "Porosität"@de ;
    skos:definition "A fraction of the volume of voids over the total volume."@en,
                    "Une fraction du volume des vides par rapport au volume total."@fr,
                    "Una fracción del volumen de vacíos sobre el volumen total."@es,
                    "Ein Anteil des Volumens der Poren im Verhältnis zum Gesamtvolumen."@de .

:Voxel a owl:Class ;
    rdfs:label "Voxel"@en, "Voxel"@fr, "Voxel"@es, "Voxel"@de ;
    rdfs:subClassOf sio:SIO_000015 ;
    skos:definition "A discretized, symbolic representation of a material substance in 3D space."@en, 
                    "Une représentation discrétisée et symbolique d'une substance matérielle dans un espace 3D."@fr, 
                    "Una representación simbólica discretizada de una sustancia material en un espacio 3D."@es,
                    "Eine diskretisierte, symbolische Darstellung einer materiellen Substanz im 3D-Raum." .

:Wavenumber a owl:Class ;
    rdfs:label "Wavenumber"@en, "Nombre d'onde"@fr, "Número de onda"@es ;
    rdfs:subClassOf sio:SIO_000070 ;
    skos:definition "The wavenumber of a wave is the inverse of the wavelength. This is the inverse space component of the dispersion relation for a one-dimensional analysis."@en, 
                    "Le nombre d'onde d'une onde est l'inverse de la longueur d'onde. Il s'agit de la composante en espace réciproque de la relation de dispersion pour une analyse unidimensionnelle."@fr, 
                    "El número de onda de una onda es el inverso de la longitud de onda. Este es el componente en el espacio recíproco de la relación de dispersión para un análisis unidimensional."@es,
                    "Die Wellenzahl einer Welle ist der Kehrwert der Wellenlänge. Dies ist die raumbezogene Kehrwertkomponente der Dispersionsrelation in einer eindimensionalen Betrachtung." .

:Wavevector a owl:Class ;
    rdfs:label "Wave Vector"@en, "Vecteur d'onde"@fr, "Vector de onda"@es, "Wellenvektor"@de ;
    rdfs:subClassOf sio:SIO_001430 ;
    skos:definition "The wavenumber of a wave is the inverse of the wavelength. This is the inverse space component of the dispersion relation for a one-dimensional analysis."@en,
                    "Le nombre d'onde d'une onde est l'inverse de la longueur d'onde. Il s'agit de la composante en espace réciproque de la relation de dispersion pour une analyse unidimensionnelle"@fr,
                    "El número de onda de una onda es el inverso de la longitud de onda. Esta es la componente del espacio recíproco de la relación de dispersión para un análisis unidimensional."@es,
                    "Die Wellenzahl einer Welle ist der Kehrwert der Wellenlänge. Dies ist die reziproke Raumkomponente der Dispersionsrelation für eine eindimensionale Analyse."@de .  

:WaveVector a owl:Class ;
    rdfs:label "Wave Vector"@en, "Vecteur d'onde"@fr, "Vector de onda"@es, "Wellenvektor"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :DispersionBandValue ],
            [ a owl:Restriction ;
            owl:someValuesFrom :DispersionRelation ], 
            [ a owl:Restriction ;
            owl:someValuesFrom :ReciprocalSpaceGeometry ], 
            sio:SIO_000071 .

:YoungModulus a owl:Class ;
    rdfs:label "Young Modulus"@en, "Module de Young"@fr, "Módulo de Young"@es, "Youngscher Modulus"@de ;
    skos:definition "A measure of the tensile or compressive stiffness of a solid material when the force is applied lengthwise."@en,
                    "Une mesure de la rigidité en traction ou en compression d’un matériau solide lorsque la force est appliquée longitudinalement."@fr,
                    "Una medida de la rigidez en tracción o compresión de un material sólido cuando la fuerza se aplica longitudinalmente."@es,
                    "Eine Maßeinheit für die Zug- oder Drucksteifigkeit eines festen Materials, wenn die Kraft längs angewendet wird."@de ;
    prov:wasQuotedFrom <https://en.wikipedia.org/wiki/Young%27s_modulus> .  

:MeltProcessing a owl:Class ;
    rdfs:label "Melt Processing"@en, "Traitement par fusion"@fr, "Procesamiento por fusión"@es, "Schmelzverarbeitung"@de ;
    rdfs:subClassOf sio:SIO_000999 ;
    skos:definition "Mixing of polymer and nanoparticles in molten state."@en,
                    "Mélange de polymères et de nanoparticules à l’état fondu."@fr,
                    "Mezcla de polímeros y nanopartículas en estado fundido."@es,
                    "Mischen von Polymeren und Nanopartikeln im geschmolzenen Zustand."@de .

:In-SituPolymerization a owl:Class ;
    rdfs:label "In-Situ Polymerization"@en, "Polymérisation in situ"@fr, "Polimerización in situ"@es, "In-situ-Polymerisation"@de ;
    rdfs:subClassOf sio:SIO_000999 ;
    skos:definition "Mixing of nanoparticles within liquid monomer so that polymer formation results in embedding of particles."@en,
                    "Mélange de nanoparticules dans un monomère liquide de sorte que la formation du polymère entraîne l’enrobage des particules."@fr,
                    "Mezcla de nanopartículas dentro de un monómero líquido de modo que la formación del polímero resulte en la incrustación de partículas."@es,
                    "Mischen von Nanopartikeln in flüssigem Monomer, sodass die Polymerbildung zur Einbettung der Partikel führt."@de .

:SolutionProcessing a owl:Class ;
    rdfs:label "Solution Processing"@en, "Traitement en solution"@fr, "Procesamiento en solución"@es, "Lösungsverarbeitung"@de ;
    rdfs:subClassOf sio:SIO_000999 ;
    skos:definition "Mixing of dissolvable polymer with nanoparticles."@en,
                    "Mélange de polymères solubles avec des nanoparticules."@fr,
                    "Mezcla de polímeros solubles con nanopartículas."@es,
                    "Mischen von löslichem Polymer mit Nanopartikeln."@de .

:OtherProcessing a owl:Class ;
    rdfs:label "Other Processing"@en, "Autre traitement"@fr, "Otro procesamiento"@es, "Sonstige Verarbeitung"@de ;
    rdfs:subClassOf sio:SIO_000999 ;
    skos:definition "A process related to material processing not covered by other specific categories."@en,
                    "Un processus lié au traitement des matériaux non couvert par d’autres catégories spécifiques."@fr,
                    "Un proceso relacionado con el procesamiento de materiales no cubierto por otras categorías específicas."@es,
                    "Ein Prozess im Zusammenhang mit der Materialverarbeitung, der nicht von anderen spezifischen Kategorien abgedeckt wird."@de .

:Additive a owl:Class ;
    rdfs:label "Additive"@en, "Additif"@fr, "Aditivo"@es, "Additiv"@de ;
    rdfs:subClassOf sio:SIO_010004 ;
    skos:definition "Additive used in composite synthesis."@en,
                    "Additif utilisé dans la synthèse de composites."@fr,
                    "Aditivo utilizado en la síntesis de compuestos."@es,
                    "Additiv, das in der Synthese von Kompositen verwendet wird."@de .

:Solvent a owl:Class ;
    rdfs:label "Solvent"@en, "Solvant"@fr, "Solvente"@es, "Lösungsmittel"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom sio:SIO_000052 ],
        sio:SIO_010004 ;
    skos:definition "Solvent used in composite synthesis."@en,
                    "Solvant utilisé dans la synthèse de composites."@fr,
                    "Solvente utilizado en la síntesis de compuestos."@es,
                    "Lösungsmittel, das in der Synthese von Kompositen verwendet wird."@de .

:Dissolving a owl:Class ;
    rdfs:label "Dissolving"@en, "Dissolution"@fr, "Disolución"@es, "Auflösen"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Solvent ],
        sio:SIO_000999 ;
    skos:definition "Dissolving into solution without external force."@en,
                    "Dissolution dans une solution sans force externe."@fr,
                    "Disolución en una solución sin fuerza externa."@es,
                    "Auflösen in eine Lösung ohne äußere Kraft."@de .

:Curing a owl:Class ;
    rdfs:label "Curing"@en, "Durcissement"@fr, "Curado"@es, "Aushärtung"@de ;
    rdfs:subClassOf sio:SIO_000999 ;
    skos:definition "A process of hardening or solidifying a material through chemical or physical means."@en,
                    "Un processus de durcissement ou de solidification d’un matériau par des moyens chimiques ou physiques."@fr,
                    "Un proceso de endurecimiento o solidificación de un material mediante medios químicos o físicos."@es,
                    "Ein Prozess des Härtens oder Verfestigens eines Materials durch chemische oder physikalische Mittel."@de .

:Heating a owl:Class ;
    rdfs:label "Heating"@en, "Chauffage"@fr, "Calentamiento"@es, "Erwärmung"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom <obo:PATO_0001025> ],
            [ a owl:Restriction ;
            owl:someValuesFrom :AmbientCondition ],
        [ a owl:Restriction ;
            owl:someValuesFrom <obo:PATO_0000146> ],
            sio:SIO_000999 ;
    pico:Duration sio:SIO_000417 ;
    skos:definition "Process for applying heat."@en,
                    "Processus d’application de chaleur."@fr,
                    "Proceso para aplicar calor."@es,
                    "Prozess zum Anwenden von Wärme."@de .

:AmbientCondition a owl:Class ;
    rdfs:label "Ambient Condition"@en, "Condition ambiante"@fr, "Condición ambiental"@es, "Umgebungsbedingung"@de ;
    rdfs:subClassOf :ProcessingCondition ;
    skos:definition "Ambient conditions."@en,
                    "Conditions ambiantes."@fr,
                    "Condiciones ambientales."@es,
                    "Umgebungsbedingungen."@de .

:ProcessingCondition a owl:Class ;
    rdfs:label "Processing Condition"@en, "Condition de traitement"@fr, "Condición de procesamiento"@es, "Verarbeitungsbedingung"@de ;
    rdfs:subClassOf sio:SIO_000005 ;
    skos:definition "Conditions under which material processing occurs."@en,
                    "Conditions dans lesquelles le traitement des matériaux a lieu."@fr,
                    "Condiciones bajo las cuales ocurre el procesamiento de materiales."@es,
                    "Bedingungen, unter denen die Materialverarbeitung stattfindet."@de .

:Air a owl:Class ;
    rdfs:label "Air"@en, "Air"@fr, "Aire"@es, "Luft"@de ;
    rdfs:subClassOf :AmbientCondition ;
    skos:definition "Ambient condition involving air as the surrounding medium."@en,
                    "Condition ambiante impliquant l’air comme milieu environnant."@fr,
                    "Condición ambiental que involucra el aire como medio circundante."@es,
                    "Umgebungsbedingung, die Luft als umgebendes Medium einbezieht."@de .

:Vacuum a owl:Class ;
    rdfs:label "Vacuum"@en, "Vide"@fr, "Vacío"@es, "Vakuum"@de ;
    rdfs:subClassOf :AmbientCondition ;
    skos:definition "Ambient condition involving a vacuum environment."@en,
                    "Condition ambiante impliquant un environnement sous vide."@fr,
                    "Condición ambiental que involucra un entorno de vacío."@es,
                    "Umgebungsbedingung, die eine Vakuumumgebung einbezieht."@de .

:Inert a owl:Class ;
    rdfs:label "Inert"@en, "Inerte"@fr, "Inerte"@es, "Inert"@de ;
    rdfs:subClassOf :AmbientCondition ;
    skos:definition "Ambient condition involving an inert gas environment."@en,
                    "Condition ambiante impliquant un environnement de gaz inerte."@fr,
                    "Condición ambiental que involucra un entorno de gas inerte."@es,
                    "Umgebungsbedingung, die eine Inertgasumgebung einbezieht."@de .

:Cooling a owl:Class ;
    rdfs:label "Cooling"@en, "Refroidissement"@fr, "Enfriamiento"@es, "Kühlung"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom <obo:PATO_0001025> ],
        [ a owl:Restriction ;
            owl:someValuesFrom <obo:PATO_0000146> ],
        [ a owl:Restriction ;
            owl:someValuesFrom :AmbientCondition ],
        sio:SIO_000999 ;
    pico:Duration sio:SIO_000417 ;
    skos:definition "Process for reducing the temperature of a material."@en,
                    "Processus pour réduire la température d’un matériau."@fr,
                    "Proceso para reducir la temperatura de un material."@es,
                    "Prozess zum Senken der Temperatur eines Materials."@de .

:Drying-Evaporation a owl:Class ;
    rdfs:label "Drying Evaporation"@en, "Séchage par évaporation"@fr, "Evaporación por secado"@es, "Trocknung durch Verdampfung"@de ;
    rdfs:subClassOf 
        [ a owl:Restriction ;
            owl:someValuesFrom <obo:PATO_0001025> ],
        [ a owl:Restriction ;
            owl:someValuesFrom <obo:PATO_0000146> ],
        [ a owl:Restriction ;
            owl:someValuesFrom :AmbientCondition ],
        sio:SIO_000999 ;
    pico:Duration sio:SIO_000417 ;
    skos:definition "Process for drying and evaporation of liquid solutions."@en,
                    "Processus de séchage et d’évaporation des solutions liquides."@fr,
                    "Proceso para el secado y la evaporación de soluciones líquidas."@es,
                    "Prozess zum Trocknen und Verdampfen von flüssigen Lösungen."@de .

:Centrifugation a owl:Class ;
    rdfs:label "Centrifugation"@en, "Centrifugation"@fr, "Centrifugación"@es, "Zentrifugation"@de ;
    rdfs:subClassOf sio:SIO_000999 ;
    skos:definition "Process which involves the application of the centripetal force for the sedimentation of heterogeneous mixtures with a centrifuge."@en,
                    "Processus qui implique l’application de la force centripète pour la sédimentation de mélanges hétérogènes avec une centrifugeuse."@fr,
                    "Proceso que implica la aplicación de la fuerza centrípeta para la sedimentación de mezclas heterogéneas con una centrífuga."@es,
                    "Prozess, der die Anwendung der Zentripetalkraft für die Sedimentation heterogener Mischungen mit einer Zentrifuge umfasst."@de .

:Other a owl:Class ;
    rdfs:label "Other Processing Parameter"@en, "Autre paramètre de traitement"@fr, "Otro parámetro de procesamiento"@es, "Sonstiger Verarbeitungsparameter"@de ;
    rdfs:subClassOf sio:SIO_000999 ;
    skos:definition "A parameter related to material processing not covered by other specific categories."@en,
                    "Un paramètre lié au traitement des matériaux non couvert par d’autres catégories spécifiques."@fr,
                    "Un parámetro relacionado con el procesamiento de materiales no cubierto por otras categorías específicas."@es,
                    "Ein Parameter im Zusammenhang mit der Materialverarbeitung, der nicht von anderen spezifischen Kategorien abgedeckt wird."@de .

:Molding a owl:Class ;
    rdfs:label "Molding"@en, "Moulage"@fr, "Moldeo"@es, "Formen"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom <sio:SIO_000417> ],
        [ a owl:Restriction ;
            owl:someValuesFrom <obo:PATO_0000146> ],
        [ a owl:Restriction ;
            owl:someValuesFrom :AmbientCondition ],
        [ a owl:Restriction ;
            owl:someValuesFrom <obo:PATO_0001025> ],
        sio:SIO_000999 ;
    skos:definition "Methods to shape final composite."@en,
                    "Méthodes pour façonner le composite final."@fr,
                    "Métodos para dar forma al compuesto final."@es,
                    "Methoden zur Formgebung des endgültigen Komposits."@de .

:HotPressing a owl:Class ;
    rdfs:label "Hot-Processing (Compression Molding)"@en, "Pressage à chaud (moulage par compression)"@fr, "Procesamiento en caliente (moldeo por compresión)"@es, "Heißpressen (Kompressionsformen)"@de ;
    rdfs:subClassOf :Molding ;
    skos:definition "Applying heat and pressure."@en,
                    "Application de chaleur et de pression."@fr,
                    "Aplicación de calor y presión."@es,
                    "Anwendung von Wärme und Druck."@de .

:Casting a owl:Class ;
    rdfs:label "Casting"@en, "Coulée"@fr, "Fundición"@es, "Gießen"@de ;
    rdfs:subClassOf :Molding ;
    skos:definition "A process of shaping a composite by pouring it into a mold."@en,
                    "Un processus de mise en forme d’un composite en le versant dans un moule."@fr,
                    "Un proceso de dar forma a un compuesto vertiéndolo en un molde."@es,
                    "Ein Prozess zur Formgebung eines Komposits durch Gießen in eine Form."@de .

:InjectionMolding a owl:Class ;
    rdfs:label "Injection Molding"@en, "Moulage par injection"@fr, "Moldeo por inyección"@es, "Spritzgießen"@de ;
    rdfs:subClassOf :Molding ;
    skos:definition "A process of shaping a composite by injecting material into a mold."@en,
                    "Un processus de mise en forme d’un composite en injectant du matériau dans un moule."@fr,
                    "Un proceso de dar forma a un compuesto inyectando material en un molde."@es,
                    "Ein Prozess zur Formgebung eines Komposits durch Einspritzen von Material in eine Form."@de .

:RotationalMolding a owl:Class ;
    rdfs:label "Rotational Molding"@en, "Moulage par rotation"@fr, "Moldeo rotacional"@es, "Rotationsformen"@de ;
    rdfs:subClassOf :Molding ;
    skos:definition "A process of shaping a composite by rotating a mold while heating."@en,
                    "Un processus de mise en forme d’un composite en faisant tourner un moule tout en chauffant."@fr,
                    "Un proceso de dar forma a un compuesto rotando un molde mientras se calienta."@es,
                    "Ein Prozess zur Formgebung eines Komposits durch Drehen einer Form während des Erwärmens."@de .

:VacuumMolding a owl:Class ;
    rdfs:label "Vacuum Molding"@en, "Moulage sous vide"@fr, "Moldeo al vacío"@es, "Vakuumformen"@de ;
    rdfs:subClassOf :Molding ;
    skos:definition "A process of shaping a composite using a vacuum to draw material into a mold."@en,
                    "Un processus de mise en forme d’un composite en utilisant un vide pour aspirer le matériau dans un moule."@fr,
                    "Un proceso de dar forma a un compuesto usando un vacío para atraer el material hacia un molde."@es,
                    "Ein Prozess zur Formgebung eines Komposits durch Verwenden eines Vakuums, um Material in eine Form zu ziehen."@de .

:Mixing a owl:Class ;
    rdfs:label "Mixing"@en, "Mélange"@fr, "Mezcla"@es, "Mischen"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom <obo:PATO_0000146> ],
        [ a owl:Restriction ;
            owl:someValuesFrom :RotationalFrequency ],
        sio:SIO_000999 ;
    pico:Duration sio:SIO_000417 ;
    skos:definition "Processes for mixing of multiple substances."@en,
                    "Processus pour le mélange de plusieurs substances."@fr,
                    "Procesos para la mezcla de múltiples sustancias."@es,
                    "Prozesse zum Mischen mehrerer Substanzen."@de .

:RotationalFrequency a owl:Class ;
    rdfs:label "Rotational Frequency"@en, "Fréquence de rotation"@fr, "Frecuencia rotacional"@es, "Rotationsfrequenz"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :RevolutionsPerMinute ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_001367 ;
    skos:definition "The number of rotations of an object around an axis per unit time."@en,
                    "Le nombre de rotations d’un objet autour d’un axe par unité de temps."@fr,
                    "El número de rotaciones de un objeto alrededor de un eje por unidad de tiempo."@es,
                    "Die Anzahl der Umdrehungen eines Objekts um eine Achse pro Zeiteinheit."@de .

:MeltMixing a owl:Class ;
    rdfs:label "Melt Mixing"@en, "Mélange par fusion"@fr, "Mezcla por fusión"@es, "Schmelzmischen"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Additive ],
        :Mixing ;
    skos:definition "Mixing of polymer and nanoparticles in molten state."@en,
                    "Mélange de polymères et de nanoparticules à l’état fondu."@fr,
                    "Mezcla de polímeros y nanopartículas en estado fundido."@es,
                    "Mischen von Polymeren und Nanopartikeln im geschmolzenen Zustand."@de .

:BallMilling a owl:Class ;
    rdfs:label "Ball Milling"@en, "Broyage à billes"@fr, "Molienda de bolas"@es, "Kugelmühlen"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Additive ],
        :Mixing ;
    skos:definition "Grinding process with rotating cylindrical shells and balls."@en,
                    "Processus de broyage avec des coques cylindriques rotatives et des billes."@fr,
                    "Proceso de molienda con carcasas cilíndricas rotativas y bolas."@es,
                    "Mahlenprozess mit rotierenden zylindrischen Schalen und Kugeln."@de .

:Ultra-sonication a owl:Class ;
    rdfs:label "Ultra Sonication"@en, "Ultrasonication"@fr, "Ultrasonido"@es, "Ultraschallbehandlung"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Additive ],
        :Mixing ;
    skos:definition """The irradiation of a liquid sample with ultrasonic (>20 kHz) waves resulting in agitation."""@en,
                    """L’irradiation d’un échantillon liquide avec des ondes ultrasoniques (>20 kHz) entraînant une agitation."""@fr,
                    """La irradiación de una muestra líquida con ondas ultrasónicas (>20 kHz) que resulta en agitación."""@es,
                    """Die Bestrahlung einer flüssigen Probe mit Ultraschallwellen (>20 kHz), die zu einer Bewegung führt."""@de .

:Stirring a owl:Class ;
    rdfs:label "Stirring"@en, "Agitation"@fr, "Agitación"@es, "Rühren"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Solvent ],
        :Mixing ;
    skos:definition "Manual stirring of liquid solutions."@en,
                    "Agitation manuelle de solutions liquides."@fr,
                    "Agitación manual de soluciones líquidas."@es,
                    "Manuelles Rühren von flüssigen Lösungen."@de .

:MechanicalMixing a owl:Class ;
    rdfs:label "Mechanical Mixing"@en, "Mélange mécanique"@fr, "Mezcla mecánica"@es, "Mechanisches Mischen"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Additive ],
        :Mixing ;
    skos:definition "Manual mixing."@en,
                    "Mélange manuel."@fr,
                    "Mezcla manual."@es,
                    "Manuelles Mischen."@de .

:HighShearMixing a owl:Class ;
    rdfs:label "High Shear Mixing"@en, "Mélange à haut cisaillement"@fr, "Mezcla de alto cizallamiento"@es, "Hochschermischen"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Additive ],
        :Mixing ;
    skos:definition "A stator-rotator setup that disperses substance into continuous phase through high shear."@en,
                    "Une configuration stator-rotor qui disperse une substance dans une phase continue par un cisaillement élevé."@fr,
                    "Una configuración de estator-rotor que dispersa una sustancia en una fase continua mediante un alto cizallamiento."@es,
                    "Ein Stator-Rotor-Setup, das Substanz durch hohen Scherkraft in eine kontinuierliche Phase dispergiert."@de .

:RollMilling a owl:Class ;
    rdfs:label "Roll Milling"@en, "Laminage"@fr, "Laminación"@es, "Walzfräsen"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Additive ],
        :Mixing ;
    skos:definition "Grinding process with a roller and flat plate."@en,
                    "Processus de broyage avec un rouleau et une plaque plate."@fr,
                    "Proceso de molienda con un rodillo y una placa plana."@es,
                    "Mahlenprozess mit einer Walze und einer flachen Platte."@de .

:Extrusion a owl:Class ;
    rdfs:label "Extrusion"@en, "Extrusion"@fr, "Extrusión"@es, "Extrusion"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Extruder ],
        sio:SIO_000999 ;
    skos:definition "Process used to create objects of a fixed cross-sectional profile. A material is pushed through a die of the desired cross-section."@en,
                    "Processus utilisé pour créer des objets avec un profil de section transversale fixe. Un matériau est poussé à travers une filière de la section transversale souhaitée."@fr,
                    "Proceso utilizado para crear objetos con un perfil de sección transversal fija. Un material se empuja a través de un troquel de la sección transversal deseada."@es,
                    "Prozess zur Herstellung von Objekten mit einem festen Querschnittsprofil. Ein Material wird durch eine Matrize mit dem gewünschten Querschnitt gedrückt."@de .

:Extruder a owl:Class ;
    rdfs:label "Extruder"@en, "Extrudeuse"@fr, "Extrusora"@es, "Extruder"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:someValuesFrom :Throughput ],
        [ a owl:Restriction ;
            owl:someValuesFrom :InnerBarrelDiameter ],
        [ a owl:Restriction ;
            owl:someValuesFrom :ResidenceTime ],
        [ a owl:Restriction ;
            owl:someValuesFrom :DLRatio ],
        [ a owl:Restriction ;
            owl:someValuesFrom :ChannelDepth ],
        [ a owl:Restriction ;
            owl:someValuesFrom :ScrewDiameter ],
        [ a owl:Restriction ;
            owl:someValuesFrom :MeltTemperature ],
        [ a owl:Restriction ;
            owl:someValuesFrom :FlightClearance ],
        [ a owl:Restriction ;
            owl:someValuesFrom :Dimension ],
        [ a owl:Restriction ;
            owl:someValuesFrom :ScrewLead ],
        [ a owl:Restriction ;
            owl:someValuesFrom :Amperage ],
        [ a owl:Restriction ;
            owl:someValuesFrom :ScrewLength ],
        [ a owl:Restriction ;
            owl:someValuesFrom :FlightWidth ],
        [ a owl:Restriction ;
            owl:someValuesFrom :PressureAtDie ],
        [ a owl:Restriction ;
            owl:someValuesFrom :ExtrusionTemperature ],
        [ a owl:Restriction ;
            owl:someValuesFrom :ChannelsPerScrew ],
        [ a owl:Restriction ;
            owl:someValuesFrom :Voltage ],
        [ a owl:Restriction ;
            owl:someValuesFrom :Torque ],
        [ a owl:Restriction ;
            owl:someValuesFrom :ScrewChannelWidth ],
        [ a owl:Restriction ;
            owl:someValuesFrom :HeatingZone ],
        sio:SIO_000956 .

:SingleScrew a owl:Class ;
    rdfs:label "Single Screw Extruder"@en, "Extrudeuse à vis unique"@fr, "Extrusora de tornillo único"@es, "Einschneckenextruder"@de ;
    rdfs:subClassOf :Extruder .

:TwinScrew a owl:Class ;
    rdfs:label "Twin Screw Extruder"@en, "Extrudeuse à double vis"@fr, "Extrusora de doble tornillo"@es, "Doppelschneckenextruder"@de ;
    rdfs:subClassOf :Extruder .

:HeatingZone a owl:Class ;
    rdfs:label "Heating Zone"@en, "Zone de chauffage"@fr, "Zona de calentamiento"@es, "Heizzone"@de ;
    rdfs:subClassOf sio:SIO_000370 .

:ScrewLead a owl:Class ;
    rdfs:label "Screw Lead"@en, "Pas de vis"@fr, "Paso de tornillo"@es, "Schneckensteigung"@de ;
    rdfs:subClassOf sio:SIO_000041 .

:Dimension a owl:Class ;
    rdfs:label "Dimension"@en, "Dimension"@fr, "Dimensión"@es, "Dimension"@de ;
    rdfs:subClassOf sio:SIO_000258 .

:RadialClearence a owl:Class ;
    rdfs:label "Radial Clearance"@en, "Jeu radial"@fr, "Holura radial"@es, "Radialspiel"@de ;
    rdfs:subClassOf :Dimension, sio:SIO_000040 .

:Rotation a owl:Class ;
    rdfs:label "Rotation"@en, "Rotation"@fr, "Rotación"@es, "Rotation"@de ;
    rdfs:subClassOf sio:SIO_000052 .

:ResidenceTime a owl:Class ;
    rdfs:label "Residence Time"@en, "Temps de séjour"@fr, "Tiempo de residencia"@es, "Verweilzeit"@de ;
    rdfs:subClassOf sio:SIO_000417 .

:Other_Processing a owl:Class ;
    rdfs:label "Other Processing"@en, "Autre traitement"@fr, "Otro procesamiento"@es, "Sonstige Verarbeitung"@de ;
    rdfs:subClassOf sio:SIO_000999 .

:Output a owl:Class ;
    rdfs:label "Output"@en, "Sortie"@fr, "Salida"@es, "Ausgabe"@de .

:LengthOfHeatingZone a owl:Class ;
    rdfs:label "Length of Heating Zone"@en, "Longueur de la zone de chauffage"@fr, "Longitud de la zona de calentamiento"@es, "Länge der Heizzone"@de ;
    rdfs:subClassOf sio:SIO_000041 .

:ChemicalUsed a owl:Class ;
    rdfs:label "Chemical Used"@en, "Produit chimique utilisé"@fr, "Químico utilizado"@es, "Verwendete Chemikalie"@de ;
    rdfs:subClassOf sio:SIO_010004 .

:HeatingZoneNumber a owl:Class ;
    rdfs:label "Heating Zone Number"@en, "Numéro de zone de chauffage"@fr, "Número de zona de calentamiento"@es, "Heizzonennummer"@de ;
    rdfs:subClassOf sio:SIO_000366 .

:Mixer a owl:Class ;
    rdfs:label "Mixer"@en, "Mélangeur"@fr, "Mezclador"@es, "Mischer"@de ;
    rdfs:subClassOf sio:SIO_000956 .

:MixingMethod a owl:Class ;
    rdfs:label "Mixing Method"@en, "Méthode de mélange"@fr, "Método de mezcla"@es, "Mischmethode"@de ;
    rdfs:subClassOf sio:SIO_000999 .

:SolventName a owl:Class ;
    rdfs:label "Solvent Name"@en, "Nom du solvant"@fr, "Nombre del solvente"@es, "Lösungsmittelname"@de ;
    rdfs:subClassOf sio:SIO_000116 .

:SolventAmount a owl:Class ;
    rdfs:label "Solvent Amount"@en, "Quantité de solvant"@fr, "Cantidad de solvente"@es, "Lösungsmittelmenge"@de ;
    rdfs:subClassOf sio:SIO_000052 .

:DLRatio a owl:Class ;
    rdfs:label "Screw Diameter/Length Ratio"@en, "Rapport diamètre/longueur de vis"@fr, "Relación diámetro/longitud del tornillo"@es, "Schneckendurchmesser-Längen-Verhältnis"@de ;
    rdfs:subClassOf sio:SIO_001018 .

