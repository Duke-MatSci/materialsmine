:CycleInformation a owl:Class ;
    rdfs:label "Cycle Information"@en, "Información del ciclo"@es, "Zyklusinformationen"@de, "Informations sur le cycle"@fr ;
    rdfs:subClassOf sio:SIO_000015 .

:PeakPosition a owl:Class ;
    rdfs:label "Peak Position"@en, "Posición máxima"@es, "Spitzenposition"@de, "Position maximale"@fr ;
    rdfs:subClassOf sio:SIO_000144 ;
    skos:definition "the location corresponding to the maximum intensity of an identified peak observed in 1D graph"@en,
        "L'emplacement correspondant à l'intensité maximale d'un pic identifié observé dans un graphique en 1D"@fr,
        "La ubicación correspondiente a la intensidad máxima de un pico identificado observado en un gráfico 1D"@es,
        "Die Position, die der maximalen Intensität eines identifizierten Peaks entspricht, der in einem 1D-Diagramm beobachtet wird"@de .

:FullWidthHalfMax a owl:Class ;
    rdfs:label "Full-Width Half-Max"@en, "Ancho total a mitad de máximo"@es, "Halbwertsbreite"@de, "Largeur à mi-hauteur"@fr ;
    rdfs:subClassOf sio:SIO_000144 ;
    skos:definition "The numerical value associated with full width half maximum of an identified peak observed in 1D graph"@en,
        "La valeur numérique associée à la largeur à mi-hauteur d'un pic identifié observé dans un graphique en 1D"@fr,
        "El valor numérico asociado a la anchura a media altura de un pico identificado observado en un gráfico 1D"@es,
        "Der numerische Wert, der mit der Halbwertsbreite eines identifizierten Peaks verknüpft ist, der in einem 1D-Diagramm beobachtet wird"@de .

:VolumeFraction a owl:Class ;
    rdfs:label "VolumeFraction"@en, "Fracción volumétrica"@es, "Volumenanteil"@de, "Fraction volumique"@fr ;
    skos:definition  "percentage of number of white or black pixels"@en,  "Pourcentage du nombre de pixels blancs ou noirs"@fr, "Prozentsatz der Anzahl weißer oder schwarzer Pixel"@de, "Porcentaje del número de píxeles blancos o negros"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_001018 .

:ClusterNearestSurfaceDistance a owl:Class ;
    rdfs:label "Cluster Nearest Surface Distance"@en, "Distancia más cercana a la superficie del grupo"@es, "Nächste Oberflächenentfernung des Clusters"@de, "Distance minimale à la surface du cluster"@fr ;
    skos:definition  "Shortest distance between surface of two clusters"@en, "Distance la plus courte entre les surfaces de deux groupes"@fr, "Kürzeste Entfernung zwischen den Oberflächen zweier Cluster"@de, "Distancia más corta entre las superficies de dos agrupaciones"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :nm ;
            owl:onProperty sio:SIO_000221 ],
        obo:PATO_0000040 .

:NearestCenterDistance a owl:Class ;
    rdfs:label "Nearest Center Distance"@en, "Distancia al centro más cercano"@es, "Abstand zum nächsten Zentrum"@de, "Distance au centre le plus proche"@fr ;
    skos:definition  "distance between centroids of two clusters"@en, "distance entre les centroïdes de deux clusters"@fr, "Abstand zwischen den Schwerpunkten zweier Cluster"@de, "distancia entre los centroides de dos clústeres"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :nm ;
            owl:onProperty sio:SIO_000221 ],
        obo:PATO_0000040 .

:NearestBoundaryDistance a owl:Class ;
    rdfs:label "Nearest Boundary Distance"@en, "DistanciaA lLímiteMás Cercano"@es, "Kürzeste Abstandsgrenze"@de, "Distance ÀLaFrontièreLa PlusProche"@fr ;
    skos:definition  "distance between boundaries of two clusters"@en, "distance entre les frontières de deux clusters"@fr, "Abstand zwischen den Grenzen zweier Cluster"@de, "distancia entre los límites de dos grupos"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :nm ;
            owl:onProperty sio:SIO_000221 ],
        obo:PATO_0000040 .

:PrincipleAxisOrientationAngle a owl:Class ;
    rdfs:label "Principle Axis Orientation Angle"@en, "Angle d’orientation de l’axe principal"@fr, "Ausrichtungswinkel der Hauptachse"@de, "Ángulo de orientación del eje principal"@es ;
    skos:definition  "The orientation angle of the major axis when the cluster is approximated by ellipse"@en, "L'angle d'orientation de l'axe majeur lorsque le cluster est approximé par une ellipse"@fr, "Der Orientierungswinkel der Hauptachse, wenn der Cluster durch eine Ellipse angenähert wird"@de, "El ángulo de orientación del eje mayor cuando el grupo se aproxima por una elipse"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :r-deg ;
            owl:onProperty sio:SIO_000221 ],
        :OrientationAngle .

:FillerPhaseSurfaceArea a owl:Class ;
    rdfs:label "Surface area of filler phase"@en, "Área superficial de la fase de relleno"@es, "Oberfläche der Füllstoffphase"@de, "Surface de la phase de charge"@fr ;
    skos:definition  "The ratio of the filler surface pixels to the total pixels in the microstructures"@en, "Le rapport des pixels de surface de charge au nombre total de pixels dans les microstructures"@fr, "Das Verhältnis der Füllstoff-Oberflächenpixel zur Gesamtanzahl der Pixel in den Mikrostrukturen"@de, "La proporción de los píxeles de la superficie de relleno con respecto al total de píxeles en las microestructuras"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_001407 .

:MatrixPhaseSurfaceArea a owl:Class ;
    rdfs:label "Surface area of matrix phase"@en, "Área superficial de la fase matriz"@es, "Oberfläche der Matrixphase"@de, "Surface de la phase matrice"@fr ;
    skos:definition  "The ratio of the matrix surface pixels to the total pixels in the microstructures"@en,
            "Le rapport des pixels de surface de la matrice au nombre total de pixels dans les microstructures"@fr,
            "Das Verhältnis der Matrixoberflächenpixel zur Gesamtanzahl der Pixel in den Mikrostrukturen"@de,
            "La proporción de los píxeles de la superficie de la matriz con respecto al total de píxeles en las microestructuras"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_001407 .

:ClusterNumber a owl:Class ;
    rdfs:label "Cluster Number"@en, "Número de clúster"@es, "Clusterzahl"@de, "Nombre de cluster"@fr ;
    skos:definition  "total number of pixels in a cluster"@en, "nombre total de pixels dans un cluster"@fr, "Gesamtanzahl der Pixel in einem Cluster"@de, "número total de píxeles en un clúster"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000052 .

:LocalVFVoronoiCells a owl:Class ;
    rdfs:label "LocalVFVoronoiCells"@en, "Celdas de Voronoi con Fracción Volumétrica Local"@es, "Lokale VF-Voronoi-Zellen"@de, "Cellules de Voronoï avec Fraction Volumique Locale"@fr ;
    skos:definition  "Local volume fraction for Voronoi cells"@en, "Fraction de volume local pour les cellules de Voronoï"@fr, "Lokaler Volumenanteil für Voronoi-Zellen"@de, "Fracción de volumen local para las celdas de Voronoi"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000070 .

:ClusterArea a owl:Class ;
    rdfs:label "Cluster Area"@en, "Área de clúster"@es, "Clusterbereich"@de, "Zone de cluster"@fr ;
    skos:definition  "The area of clusters"@en, "La superficie des grappes"@fr, "Die Fläche der Cluster"@de, "El área de los grupos"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :nm2 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000045 .

:PoreSize a owl:Class ;
    rdfs:label "Cluster Area"@en, "Área de clúster"@es, "Clusterbereich"@de, "Zone de cluster"@fr ;
    skos:definition  "The size of the inscribed circle of the cluster"@en, "Taille du cercle inscrit du cluster"@fr, "Größe des eingeschriebenen Kreises des Clusters"@de, "Tamaño del círculo inscrito del grupo"@es ;
     rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :nm2 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000070 .

:EquivalentRadius a owl:Class ;
    rdfs:label "EquivalentRadius"@en, "RadioEquivalente"@es, "ÄquivalenterRadius"@de, "RayonÉquivalent"@fr ;
    skos:definition  "Radius of clusters when they are approximated as circles"@en, "Rayon des clusters lorsqu'ils sont approximés par des cercles"@fr, "Radius der Cluster, wenn sie als Kreise angenähert werden"@de, "Radio de los cúmulos cuando se aproximan como círculos"@es ;
     rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :nm ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000070 .

:Compactness a owl:Class ;
    rdfs:label "Compactness"@en, "Compacidad"@es, "Kompaktheit"@de, "Compacité"@fr ;
    skos:definition  "how close the pixels are close to the cluster centroid"@en, "à quel point les pixels sont proches du centroïde du cluster"@fr, "wie nah die Pixel am Cluster-Zentroid liegen"@de, "qué tan cerca están los píxeles del centroide del clúster"@es ;
     rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :nm ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000070 .

:Roundness a owl:Class ;
    rdfs:label "Roundness"@en, "Redondez"@es, "Rundheit"@de, "Rondeur"@fr ;
    skos:definition  "how close the cluster shape is to a circle"@en, "dans quelle mesure la forme du groupe est proche d’un cercle"@fr, "wie nah die Clusterform einem Kreis ist"@de, "qué tan cercana es la forma del grupo a un círculo"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000070 .

:Eccentricity a owl:Class ;
    rdfs:label "Eccentricity"@en, "Excentricidad"@es, "Exzentrizität"@de, "Excentricité"@fr ;
    skos:definition  "measure of how 'out of round' an ellipse is"@en, "mesure du caractère « non circulaire » d'une ellipse"@fr, "Maß dafür, wie „unrund“ eine Ellipse ist"@de, "medida de cuán 'no redonda' es una elipse"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000070 .

:AspectRatio a owl:Class ;
    rdfs:label "Aspect Ratio"@en, "Relación de aspecto"@es, "Seitenverhältnis"@de, "Rapport d'aspect"@fr ;
    skos:definition  "ratio of major to minor axes of an ellipse"@en, "rapport entre les axes majeur et mineur d'une ellipse"@fr, "Verhältnis der Haupt- zur Nebenachse einer Ellipse"@de, "relación entre los ejes mayor y menor de una elipse"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_001018 .

:Rectangularity a owl:Class ;
    rdfs:label "Rectangularity"@en, "Rectangularidad"@es, "Rechteckigkeit"@de, "Rectangularité"@fr ;
    skos:definition  "how close the cluster shape is to a rectangle"@en, "à quel point la forme du cluster est proche d’un rectangle"@fr, "wie nahe die Clusterform an einem Rechteck ist"@de, "qué tan cerca está la forma del clúster de un rectángulo"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000070 .

:Tortuosity a owl:Class ;
    rdfs:label "Tortuosity"@en, "Tortuosidad"@es, "Tortuosität"@de, "Tortuosité"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 1 ;
            owl:onProperty sio:SIO_000221 ],
        sio:SIO_000070 .

