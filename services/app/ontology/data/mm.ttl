<http://nanomine.org/ns/unit/m-2-g> a :Units ;
    skos:notation "1/Pa"@en .

<http://nanomine.org/ns/unit/kv> a :Units ;
    skos:definition "Charge density"@en, "Densité de charge"@fr, "Ladungsdichte"@de, "Densidad de carga"@es ;
    rdfs:label "Coulombs Per Meter Squared"@en ;
    skos:notation "C/m^2"@en .

<http://nanomine.org/ns/unit/kev> a :Units ;
