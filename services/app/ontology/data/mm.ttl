:ImagePreProcessing a owl:Class ;
    rdfs:label "ImagePreProcessing"@en, "Preprocesamiento de imágenes"@es, "Bildvorverarbeitung"@de, "Prétraitement d'image"@fr ;
    rdfs:subClassOf sio:SIO_000649 .

:ExperimentalSampleInfo a owl:Class ;
    rdfs:label "Experimental Sample Info"@en, "Información de Muestra Experimental"@es, "Experimentelle Probendaten"@de, "Informations Échantillon Expérimental"@fr ;
    rdfs:subClassOf sio:SIO_000015 .

:SampleSize a owl:Class ;
    rdfs:label "SampleSize"@en, "Tamaño de muestra"@es, "Stichprobengröße"@de, "Taille d’échantillon"@fr ;
    rdfs:subClassOf sio:SIO_000070 .

:SampleThickness a owl:Class ;
    rdfs:label "SampleThickness"@en, "Espesor de la muestra"@es, "Probendicke"@de, "Épaisseur de l’échantillon"@fr ;
    rdfs:subClassOf sio:SIO_000043 .

:DomainSpacing a owl:Class ;
    rdfs:label "Domain Spacing"@en, "Espaciado de Dominio"@es, "Domänenabstand"@de, "Espacement de Domaine"@fr ;
    rdfs:subClassOf sio:SIO_000038 ;
    skos:definition "The length between neighboring domains in a microstructure"@en, "La longueur entre les domaines voisins dans une microstructure"@fr, "Die Länge zwischen benachbarten Domänen in einer Mikrostruktur"@de, "La longitud entre dominios vecinos en una microestructura"@es .

:GrainSize a owl:Class ;
    rdfs:label "Grain Size"@en, "Tamaño de grano"@es, "Korngröße"@de, "Taille des grains"@fr ;
    rdfs:subClassOf sio:SIO_000045 ;
    skos:definition "The area of a micro structural feature defined as a domain in a 2D image"@en, "La superficie d'une caractéristique microstructurale définie comme un domaine dans une image 2D"@fr, "Die Fläche eines mikrostrukturellen Merkmals, das als Bereich in einem 2D-Bild definiert ist"@de, "El área de una característica microestructural definida como un dominio en una imagen 2D"@es .

 :MechanicalProperty a owl:Class ;
    rdfs:label "Tensile Property"@en, "Propriété mécanique"@fr, "propiedad mecánica"@es, "mechanische Eigenschaft"@de ;
    skos:definition "A materials property related to the response of a material under some external applied load"@en, "Une propriété des matériaux liée à la réponse d’un matériau soumis à une charge externe appliquée"@fr, "Eine Materialeigenschaft, die sich auf das Verhalten eines Materials unter äußerer Belastung bezieht"@de, "Una propiedad del material relacionada con la respuesta de un material bajo una carga externa aplicada"@es ;
    rdfs:subClassOf sio:SIO_000052 .

:TensileProperty a owl:Class ;
    rdfs:label "Mechanical Property"@en, "Propriété de traction"@fr, "Propiedad de tracción"@es, "Zugeigenschaft"@de ;
    skos:definition "Properties of how the material will react to forces being applied in tension."@en, "Propriétés de la façon dont le matériau réagit aux forces exercées en traction."@fr, "Eigenschaften, wie das Material auf Zugkräfte reagiert."@de, "Propiedades de cómo reaccionará el material ante fuerzas aplicadas en tracción."@es ;
    rdfs:subClassOf :MechanicalProperty .

:TensileLoadingProfile a owl:Class ;
    rdfs:label "Tensile Loading Profile"@en, "Profil de charge de traction"@fr, "Perfil de carga de tracción"@es, "Zugbelastungsprofil"@de ;
    skos:definition "Stress vs. strain curve during tensile loading and/or unloading test."@en, "Courbe contrainte-déformation lors d’un essai de traction et/ou de décharge."@fr, "Spannungs-Dehnungs-Kurve während eines Zug- und/oder Entlastungstests."@de, "Curva de esfuerzo-deformación durante una prueba de carga y/o descarga por tracción."@es ;
    rdfs:subClassOf :TensileProperty .

:TensileModulus a owl:Class ;
    rdfs:label "TensileModulus"@en, "Module d'élasticité en traction"@fr, "Zugmodul"@de, "Módulo de elasticidad a tracción"@es ;
    skos:definition "Young's modulus, or elastic modulus, describes tensile elasticity, or the tendency of an object to deform along an axis when opposing forces are applied along that axis; it is defined as the ratio of tensile stress to tensile strain."@en,
        "Le module de Young, ou module d'élasticité, décrit l'élasticité en traction, c'est-à-dire la tendance d'un objet à se déformer le long d’un axe lorsque des forces opposées sont appliquées le long de cet axe ; il est défini comme le rapport de la contrainte de traction à la déformation."@fr,
        "Der Elastizitätsmodul (Youngscher Modul) beschreibt die Zugelastizität, also die Tendenz eines Objekts, sich entlang einer Achse zu verformen, wenn entgegengesetzte Kräfte entlang dieser Achse wirken; er ist definiert als das Verhältnis von Zugspannung zu Dehnung."@de,
        "El módulo de Young, o módulo elástico, describe la elasticidad en tracción, o la tendencia de un objeto a deformarse a lo largo de un eje cuando se aplican fuerzas opuestas en ese eje; se define como la relación entre el esfuerzo de tracción y la deformación."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue  <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :TensileProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/gigapascal> .

:TensileStressAtBreak a owl:Class ;
    rdfs:label "Tensile Stress At Break"@en, "Contrainte de traction à la rupture"@fr, "Tensión de rotura"@es, "Zugspannung beim Bruch"@de ;
    skos:definition "Tensile stress at the moment at which a test specimen tears"@en, 
                    "Contrainte de traction au moment où une éprouvette se déchire"@fr, 
                    "Zugspannung im Moment des Reißens einer Probe"@de, 
                    "Tensión de tracción en el momento en que una probeta se rompe"@es ;   
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue  <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :TensileProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:TensileStressAtYield a owl:Class ;
    rdfs:label "Tensile Stress At Yield"@en, "limite d'écoulement à la traction"@fr, "resistencia de tensión a la fluencia"@es, "Streckspannung"@de ;
    skos:definition "Tensile stress corresponding to the yield point (an increase in strain does not result in an increase in stress)."@en, 
                    "Contrainte de traction correspondant au point de limite d'élasticité (une augmentation de la déformation n'entraîne pas une augmentation de la contrainte)."@fr, 
                    "Zugspannung am Streckpunkt (eine Zunahme der Dehnung führt nicht zu einer Zunahme der Spannung)."@de, 
                    "Tensión de tracción correspondiente al punto de cedencia (un aumento en la deformación no produce un aumento en la tensión)."@es ;
    rdfs:subClassOf :TensileProperty ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue  <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :TensileProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:TensileToughness a owl:Class ;
    rdfs:label "Tensile Toughness"@en, "Résistance à la traction"@fr, "Tenacidad a la tracción"@es, "Zugzähigkeit"@de ;
    skos:definition "The amount of energy a material can absorb prior to fracture under an applied tensile load."@en, 
                    "La quantité d'énergie qu'un matériau peut absorber avant de se rompre sous une charge de traction appliquée."@fr, 
                    "Die Energiemenge, die ein Material aufnehmen kann, bevor es unter einer Zugbelastung bricht."@de, 
                    "La cantidad de energía que un material puede absorber antes de fracturarse bajo una carga de tracción aplicada."@es ;
    rdfs:subClassOf :TensileProperty .

:ElongationAtYield a owl:Class ;
    rdfs:label "Elongation At Yield"@en, "Allongement à la limite d’élasticité"@fr, "Dehnung bei Streckgrenze"@de, "Elongación en el límite elástico"@es ;
    skos:definition "Tensile elongation corresponding to the yield (an increase in strain does not result in an increase in stress)."@en, 
                    "Allongement en traction correspondant à la limite d'élasticité (une augmentation de la déformation n'entraîne pas une augmentation de la contrainte)."@fr, 
                    "Zugdehnung, die der Streckgrenze entspricht (eine Zunahme der Dehnung führt nicht zu einer Zunahme der Spannung)."@de, 
                    "Elongación por tracción correspondiente al límite elástico (un aumento en la deformación no resulta en un aumento en el esfuerzo)."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://nanomine.org/ns/unit/degc-min> ;
            owl:onProperty sio:SIO_000221 ],
            :TensileProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/percent> .

:ElongationAtBreak a owl:Class ;
    rdfs:label "Elongation At Break"@en, "allongement à la rupture"@fr, "alargamiento a la rotura"@es, "Bruchdehnung"@de ;
    skos:definition "Elongation of specimen when breaks"@en, "Allongement de l’éprouvette lors de la rupture"@fr, 
                    "Dehnung der Probe beim Bruch"@de, "Elongación de la muestra al romperse"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://nanomine.org/ns/unit/degc-min> ;
            owl:onProperty sio:hasUnit ],
            :TensileProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/percent> .

:FiberTensileModulus a owl:Class ;
    rdfs:label "Fiber Tensile Modulus"@en, "Module de traction des fibres"@fr,  "Módulo de tensión de fibra"@es, "Faser-Zugmodul"@de ; 
    skos:definition "Tensile modulus along grain direction in fibers"@en, 
                    "Module de traction selon la direction du grain dans les fibres"@fr, 
                    "Zugmodul entlang der Faserrichtung in Fasern"@de, 
                    "Módulo de tracción en la dirección de la fibra en fibras"@es ;
     rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :TensileProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/gigapascal> .

:FiberTensileStrength a owl:Class ;
    rdfs:label "Fiber Tensile Strength"@en, "Résistance à la traction des fibres"@fr, "resistencia a la tensión de la fibra"@es, "Faserzugfestigkeit"@de ;
    skos:definition "Tensile Stress along grain direction in fibers"@en, 
                    "Contrainte de traction selon la direction du grain dans les fibres"@fr, 
                    "Zugspannung entlang der Faserorientierung in Fasern"@de, 
                    "Esfuerzo de tracción en la dirección de la fibra en las fibras"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :N ;
            owl:onProperty sio:SIO_000221 ],
        :TensileProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:FiberTensileElongation a owl:Class ;
    rdfs:label "Fiber Tensile Elongation"@en, "Élongation à la traction de la fibre"@fr, "Alargamiento a la tensión de fibra"@es, "Faserzugdehnungt"@de ;
    skos:definition "Elongation along grain direction in fibers"@en, 
                    "Allongement selon la direction du grain dans les fibres"@fr, 
                    "Dehnung entlang der Faserrichtung im Korn"@de, 
                    "Elongación a lo largo de la dirección del grano en las fibras"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://nanomine.org/ns/unit/degc-min> ;
            owl:onProperty sio:hasUnit ],
            :TensileProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/percent> .

:PoissonsRatio a owl:Class ;
    rdfs:label "Poissons Ratio"@en, "coefficient de Poisson"@fr, "coeficiente de Poisson"@es, "Poissonzahl or Querkontraktionszahl"@de ; 
    skos:definition "Negative ratio of traverse to axial strain"@en, 
                    "Rapport négatif de la déformation transversale à la déformation axiale"@fr, 
                    "Negatives Verhältnis der Quer- zur axialen Dehnung"@de, 
                    "Relación negativa de la deformación transversal con respecto a la deformación axial"@es ;
    rdfs:subClassOf :TensileProperty .

:FlexuralProperty a owl:Class ;
    rdfs:label "Flexural Property"@en, "Propriété de flexion"@fr, "Propiedad de flexión"@es, "Biegeeigentum"@de ;
    skos:definition "Properties of how the material will react to forces being applied in bending"@en, 
                    "Propriétés de la réaction du matériau aux forces appliquées en flexion"@fr, 
                    "Eigenschaften, wie das Material auf Biegekräfte reagiert"@de, 
                    "Propiedades de cómo el material reaccionará a las fuerzas aplicadas en flexión"@es ;
    rdfs:subClassOf :MechanicalProperty .

:FlexuralLoadingProfile a owl:Class ;
    rdfs:label "Flexural Loading Profile"@en, "Profil de charge en flexion"@fr, "Perfil de carga de flexión"@es, "Biegebelastungsprofil"@de ;
    skos:definition "Stress vs. strain curve of during flexural loading and/or unloading test"@en, 
                    "Courbe contrainte-déformation lors d’un test de flexion en chargement et/ou déchargement"@fr, 
                    "Spannungs-Dehnungs-Kurve während eines Biegebeanspruchungs- und/oder Entlastungstests"@de, 
                    "Curva tensión-deformación durante la prueba de carga y/o descarga por flexión"@es ;
    rdfs:subClassOf :FlexuralProperty .

:FlexuralModulus a owl:Class ;
    rdfs:label "Flexural Modulus"@en, "Profil de charge en flexion"@fr, "Módulo de flexión"@es, "Biegemodul"@de ;
    skos:definition "Ratio of stress to strain in flexural deformation, or the tendency for a material to bend"@en, 
                    "Rapport de la contrainte à la déformation en flexion, ou la tendance d’un matériau à se plier"@fr, 
                    "Verhältnis von Spannung zu Dehnung bei Biegebeanspruchung oder die Neigung eines Materials zu biegen"@de, 
                    "Relación entre esfuerzo y deformación en flexión, o la tendencia de un material a doblarse"@es ;
   rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :FlexuralProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/gigapascal> .

:FlexuralStressAtBreak a owl:Class ;
    rdfs:label "Flexural Stress At Break"@en, "Contrainte de flexion à la rupture"@fr, "Esfuerzo de flexión en la rotura"@es, "Biegespannung bei Bruch"@de ;
    skos:definition "Flexural stress at the moment at which a test specimen tears"@en, 
                    "Contrainte de flexion au moment où l’éprouvette se déchire"@fr, 
                    "Biegespannung im Moment des Zerreißens einer Probe"@de, 
                    "Tensión de flexión en el momento en que se desgarra la muestra de prueba"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :FlexuralProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:FlexuralStressAtYield a owl:Class ;
    rdfs:label "Flexural Stress At Yield"@en, "Contrainte de flexion à la limite d'élasticité"@fr, "Esfuerzo de flexión en el límite elástico"@es, "Biegespannung bei Streckgrenze"@de ;
    skos:definition "Flexural stress corresponding to the yield point"@en, 
                    "Contrainte de flexion correspondant à la limite d’élasticité"@fr, 
                    "Biegespannung am Streckpunkt"@de, 
                    "Tensión de flexión correspondiente al punto de cedencia"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :FlexuralProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:DeflectionAtBreak a owl:Class ;
    rdfs:label "Deflection At Break"@en, "Déflexion à la rupture"@fr, "Desviación en la rotura"@es, "Durchbiegung beim Bruch"@de ;
    skos:definition "Maximum deflection at fracture"@en, 
                    "Flèche maximale à la rupture"@fr, 
                    "Maximale Durchbiegung beim Bruch"@de, 
                    "Deflexión máxima en la fractura"@es ;
    rdfs:subClassOf :FlexuralProperty .

:FlexuralToughness a owl:Class ;
    rdfs:label "Flexural Toughness"@en, "Ténacité à la flexion"@fr, "Tenacidad a flexión"@es, "Biegezähigkeit"@de ;
    skos:definition "The amount of energy a material can absorb prior to fracture under an applied flexural load."@en, 
                    "La quantité d'énergie qu'un matériau peut absorber avant de se rompre sous une charge de flexion appliquée."@fr, 
                    "Die Energiemenge, die ein Material vor dem Bruch unter einer aufgebrachten Biegebelastung aufnehmen kann."@de, 
                    "La cantidad de energía que un material puede absorber antes de fracturarse bajo una carga de flexión aplicada."@es ;
    rdfs:subClassOf :FlexuralProperty .

:CompressionProperty a owl:Class ;
    rdfs:label "Compression Property"@en,  "Propriété de compression"@fr, "propiedad de compresión"@es, "Kompri"@de ; 
    skos:definition "Properties of how the material will react to forces being applied in compression."@en, 
                    "Propriétés de la manière dont le matériau réagira aux forces appliquées en compression."@fr, 
                    "Eigenschaften, wie das Material auf Kräfte reagiert, die bei Druckbelastung wirken."@de, 
                    "Propiedades de cómo reaccionará el material a las fuerzas aplicadas en compresión."@es ;
    rdfs:subClassOf :MechanicalProperty .

:CompressiveLoadingProfile a owl:Class ;
    rdfs:label "Compressive Loading Profile"@en, "Profil de charge compressive"@fr, "Perfil de carga de compresión"@es, "KompriDruckbelastungsprofil"@de ;
    skos:definition "Stress vs. strain curve of during compressive loading and/or unloading test."@en, 
                    "Courbe contrainte-déformation lors d’un test de compression et/ou de décompression."@fr, 
                    "Spannungs-Dehnungs-Kurve während eines Druckbelastungs- und/oder Entlastungstests."@de, 
                    "Curva de esfuerzo-deformación durante una prueba de carga y/o descarga por compresión."@es ;
    rdfs:subClassOf :CompressionProperty .

:CompressiveToughness a owl:Class ;
    rdfs:label "Compressive Toughness"@en, "Résistance à la compression"@fr,  "Tenacidad a la compresión"@es, "Druckzähigkeit"@de ;
    skos:definition "The amount of energy a material can absorb prior to fracture under an applied compressive load."@en, 
                    "La quantité d'énergie qu'un matériau peut absorber avant de se fracturer sous une charge de compression appliquée."@fr, 
                    "Die Energiemenge, die ein Material vor dem Bruch unter einer aufgebrachten Druckbelastung aufnehmen kann."@de, 
                    "La cantidad de energía que un material puede absorber antes de fracturarse bajo una carga de compresión aplicada."@es ;
    rdfs:subClassOf :CompressionProperty .

:CompressiveToughness a owl:Class ;
    rdfs:label "Compressive Toughness"@en, "Résistance à la compression"@fr,  "Tenacidad a la compresión"@es, "Druckzähigkeit"@de ;
    skos:definition "The amount of energy a material can absorb prior to fracture under an applied compressive load."@en, 
                    "La quantité d'énergie qu'un matériau peut absorber avant de se fracturer sous une charge de compression appliquée."@fr, 
                    "Die Energiemenge, die ein Material vor dem Bruch unter einer aufgebrachten Druckbelastung aufnehmen kann."@de, 
                    "La cantidad de energía que un material puede absorber antes de fracturarse bajo una carga de compresión aplicada."@es ;
    rdfs:subClassOf :CompressionProperty .

:CompressionModulus a owl:Class ;
    rdfs:label "Compression Modulus"@en, "Module de compression"@fr, "Módulo de Compresión"@es, "Kompressionsmodul"@de ;
    skos:definition "The ratio of compressive stress to compressive strain."@en, 
                    "Le rapport entre la contrainte de compression et la déformation de compression."@fr, 
                    "Das Verhältnis von Druckspannung zu Druckdehnung."@de, 
                    "La relación entre el esfuerzo de compresión y la deformación por compresión."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :CompressionProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/gigapascal> .

:CompressionStressAtBreak a owl:Class ;
    rdfs:label "Compression Stress At Break"@en, "Contrainte de compression à la rupture"@fr, "Esfuerzo a la compresión a la rotura"@es, "Druckspannung beim Bruch"@de ;
    skos:definition "Compression stress when specimen breaks"@en, 
                    "Contrainte de compression lorsque l’éprouvette se casse"@fr, 
                    "Druckspannung beim Bruch der Probe"@de, 
                    "Tensión de compresión cuando la muestra se rompe"@es ;
   rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :CompressionProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:CompressionStressAtYield a owl:Class ;
    rdfs:label "Compression Stress At Yield"@en, "Contrainte de compression à la limite d'élasticité"@fr, "Esfuerzo de compresión a la fluencia"@es, "treckspannung bei Druckbelastung"@de ;
    skos:definition "Compression stress at yield point"@en, 
                    "Contrainte de compression au point d'élasticité"@fr, 
                    "Druckspannung am Streckpunkt"@de, 
                    "Tensión de compresión en el punto de fluencia"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :CompressionProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:Condition a owl:Class ;
    rdfs:label "Condition"@en, "la condition"@fr, "condición"@es, "Zustand"@de ;
    skos:definition "Description of the material's environment (e.g., during characterization)."@en, 
                    "Description de l'environnement du matériau (par exemple, lors de la caractérisation)."@fr, 
                    "Beschreibung der Umgebung des Materials (z. B. während der Charakterisierung)."@de, 
                    "Descripción del entorno del material (por ejemplo, durante la caracterización)."@es ;
    rdfs:subClassOf :CompressionProperty .

:StrainRate a owl:Class ;
    rdfs:label "Strain Rate"@en, "vitesse de déformation"@fr, "Velocidad de deformación"@es, "Belastungsrate"@de ;
    skos:definition "Rate of strain change"@en, 
                    "Taux de variation de la déformation"@fr, 
                    "Rate der Dehnungsänderung"@de, 
                    "Tasa de cambio de deformación"@es ;
     rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://nanomine.org/ns/unit/1-s> ;
            owl:onProperty sio:SIO_000221 ],
            :CompressionProperty ;
    :hasPreferredUnit <http://nanomine.org/ns/unit/1-s> .

:StrainAmplitude a owl:Class ;
    rdfs:label "Strain Amplitude"@en, "Amplitude de contrainte"@fr, "Amplitud de deformación"@es, "Dehnungsamplitude"@de ;
    skos:definition "The magnitude of forced displacement of a material sample"@en, 
                    "L’amplitude du déplacement forcé d’un échantillon de matériau"@fr, 
                    "Die Größe der erzwungenen Verschiebung einer Materialprobe"@de, 
                    "La magnitud del desplazamiento forzado de una muestra de material"@es ;
    rdfs:subClassOf :Condition .

:PreLoad a owl:Class ;
    rdfs:label "Pre-Load"@en, "précharger"@fr, "precarga"@es, "Vorspannung"@de ;
    skos:definition "Pre-stress or pre-strain before testing"@en, 
                    "Précontrainte ou pré-déformation avant l'essai"@fr, 
                    "Vorspannung oder Vorverformung vor dem Test"@de, 
                    "Preesfuerzo o predeformación antes de la prueba"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
    :Condition .


:ShearProperty a owl:Class ;
    rdfs:label "Shear Property"@en, "propriété au cisaillement"@fr, "propiedad de cizalladura"@es, "Schereigenschaft"@de ; 
    skos:definition "Properties of how the material will react to forces being applied in shear"@en, 
                    "Propriétés de la réaction du matériau aux forces de cisaillement appliquées"@fr, 
                    "Eigenschaften des Materials bei auf Scherung wirkenden Kräften"@de, 
                    "Propiedades de cómo reaccionará el material a fuerzas aplicadas en cortante"@es ;
    rdfs:subClassOf :MechanicalProperty .

:ShearLoadingProfile a owl:Class ;
    rdfs:label "Shear Loading Profile"@en, "Profil de charge de cisaillement"@fr, "Perfil de carga de corte"@es, "Scherbelastungsprofil"@de ;
    skos:definition "Stress vs. strain curve of during shear loading and/or unloading test."@en ;
    rdfs:subClassOf :ShearProperty .

:ShearModulus a owl:Class ;
    rdfs:label "Shear Modulus"@en, "module de cisaillement"@fr, "Módulo de corte"@es, "Schubmodul"@de ;
    skos:definition "Ratio of shear stress to shear strain"@en, 
                    "Rapport de la contrainte de cisaillement à la déformation de cisaillement"@fr, 
                    "Verhältnis von Schubspannung zu Schubverformung"@de, 
                    "Relación entre esfuerzo cortante y deformación cortante"@es ;
   rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :ShearProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/gigapascal> .

:ShearStressAtBreak a owl:Class ;
    rdfs:label "Shear Stress At Break"@en, "Contrainte de cisaillement à la rupture"@fr, "Schubspannung beim Bruch"@de, "Tensión de corte en el momento de la rotura"@es ;
    skos:definition "Shear stress when specimen breaks"@en, 
                    "Contrainte de cisaillement à la rupture de l'éprouvette"@fr, 
                    "Schubspannung beim Bruch der Probe"@de, 
                    "Tensión de corte cuando la muestra se rompe"@es ;
   rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :ShearProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:ShearStressAtYield a owl:Class ;
    rdfs:label "Shear Stress At Yield"@en, "contrainte de cisaillement au seuil d'écoulement"@fr, "Resistencia al Corte en Fluencia"@es, "Schubspannung bei Fließgrenze"@de ; 
    skos:definition "Shear stress at yield point"@en, 
                    "Contrainte de cisaillement au point de limite d'élasticité"@fr, 
                    "Schubspannung am Streckpunkt"@de, 
                    "Tensión de corte en el punto de cedencia"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
            :ShearProperty ;
        :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:FractureToughnessProperty a owl:Class ;
    rdfs:label "Fracture Toughness Property"@en, "Ténacité à la Fracture"@fr, "Tenacidad a la fractura"@es, "Bruchzähigkeit f"@de ;
    skos:definition "Ability of material containing a crack to resist fracture"@en, "Capacité d’un matériau contenant une fissure à résister à la rupture"@fr, "Fähigkeit eines Materials mit einem Riss, dem Bruch zu widerstehen"@de, "Capacidad de un material con una grieta para resistir la fractura"@es ;
    rdfs:subClassOf :MechanicalProperty .

:EssentialWorkOfFracture a owl:Class ;
    rdfs:label "Essential Work Of Fracture"@en, "Travail essentiel de la fracture"@fr, "Trabajo esencial de fractura"@es, "Wesentliche Arbeit des Bruchs"@de ;
    skos:definition "Energy associated with cracking at the process zone"@en, "Énergie associée à la fissuration dans la zone de processus"@fr, "Energie, die mit der Rissbildung in der Prozesszone verbunden ist"@de, "Energía asociada con la formación de grietas en la zona de proceso"@es ;
     rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :J ;
            owl:onProperty sio:SIO_000221 ],
       :FractureToughnessProperty .

:LinearElastic a owl:Class ;
    rdfs:label "Linear Elastic"@en, "Élastique linéaire"@fr, "Élastique linéaire"@es, "Linear elastisch"@de ;
    skos:definition "Infinitesimal material deformation or deformation within the linear regime"@en, "Déformation infinitésimale du matériau ou déformation dans le régime linéaire"@fr, "Unendlich kleine Materialverformung oder Verformung im linearen Bereich"@de, "Deformación infinitesimal del material o deformación dentro del régimen lineal"@es ;
    rdfs:subClassOf :FractureToughnessProperty .

:PlasticElastic a owl:Class ;
    rdfs:label "Plastic Elastic"@en, "plastique élastique"@fr, "elástico de plástico"@es, "Kunststoff-Elastik"@de ;
    skos:definition "Material deformation that undergoes both elastic and plastic deformation"@en,
        "Déformation du matériau subissant à la fois une déformation élastique et plastique"@fr,
        "Materialverformung, die sowohl elastische als auch plastische Verformung durchläuft"@de,
        "Deformación del material que experimenta tanto deformación elástica como plástica"@es ;
    rdfs:subClassOf :FractureToughnessProperty .

:Impact a owl:Class ;
    rdfs:label "Impact"@en, "l'impact"@fr, "impacto"@es, "Auswirkung"@de ; 
    skos:definition "Izod impact resistance of materials"@en, "Résistance à l'impact Izod des matériaux"@fr, "Izod-Schlagzähigkeit von Materialien"@de, "Resistencia al impacto Izod de los materiales"@es ;
    rdfs:subClassOf :FractureToughnessProperty .

:ImpactToughness a owl:Class ;
    rdfs:label "Impact Toughness"@en, "résistance aux chocs"@fr, "Resistencia al impacto"@es, "Schlagzähigkeit"@de ;
    skos:definition "The amount of impact energy a material can absorb prior to fracture"@en, "La quantité d'énergie d'impact qu'un matériau peut absorber avant la fracture"@fr, "Die Menge der Aufprallenergie, die ein Material vor dem Bruch aufnehmen kann"@de, "La cantidad de energía de impacto que un material puede absorber antes de la fractura"@es ;
    rdfs:subClassOf :Impact .

:Notched a owl:Class ;
    rdfs:label "Notched"@en, "cranté"@fr, "con muescas"@es, "einkerben"@de ;
    skos:definition "Property of a material sample, in which a uniform notch has been created for the purpose of concentrating stress in a region of interest."@en, "Propriété d'un échantillon de matériau, dans lequel une encoche uniforme a été créée dans le but de concentrer la contrainte dans une zone d'intérêt."@fr, "Eigenschaft einer Materialprobe, bei der eine gleichmäßige Kerbe erzeugt wurde, um die Spannung in einem interessierenden Bereich zu konzentrieren."@de, "Propiedad de una muestra de material, en la que se ha creado una muesca uniforme con el propósito de concentrar el esfuerzo en una región de interés."@es ;
    rdfs:subClassOf sio:SIO_000005 .

:IZODArea a owl:Class ;
    rdfs:label "IZOD Area"@en, "la Zone IZOD"@fr, "área de Izod"@es, "IZOD-Bereich"@de ;
    skos:definition "Area associated in Izod impact testing"@en, "Surface associée au test d'impact Izod"@fr, "Fläche im Zusammenhang mit dem Izod-Schlagversuch"@de, "Área asociada en la prueba de impacto Izod"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :m2 ;
            owl:onProperty sio:SIO_000221 ],
       :MechanicalProperty .

:IZOD_ImpactEnergy a owl:Class ;
    rdfs:label "IZOD Impact Energy"@en, "Énergie d'Impact IZOD"@fr, "Energía de Impacto Izod"@es, "IZOD Schlagenergie"@de ;
    skos:definition "Energy absorbed by the sample during Izod impact testing, as calculated by the height of swing arm"@en, "Énergie absorbée par l'échantillon lors de l'essai d'impact Izod, calculée à partir de la hauteur du bras oscillant"@fr, "Energie, die von der Probe während des Izod-Schlagversuchs aufgenommen wird, berechnet anhand der Höhe des Schwenkarms"@de, "Energía absorbida por la muestra durante la prueba de impacto Izod, calculada según la altura del brazo oscilante"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :J ;
            owl:onProperty sio:SIO_000221 ],
    :MechanicalProperty .

:CharpyImpactEnergy a owl:Class ;
    rdfs:label "Charpy Impact Energy"@en, "Énergie d'Impact Charpy"@fr, "Energía de Impacto Charpy"@es, "Charpy-Aufschlagenergie"@de ; 
    skos:definition "Energy absorbed by the sample during Charpy impact testing"@en, "Énergie absorbée par l’échantillon lors de l’essai de choc Charpy"@fr, "Energie, die von der Probe während des Charpy-Schlagversuchs aufgenommen wird"@de, "Energía absorbida por la muestra durante la prueba de impacto Charpy"@es ;
   rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :J ;
            owl:onProperty sio:SIO_000221 ],
   :MechanicalProperty .

:HardnessProperty a owl:Class ;
    rdfs:label "Hardness Property"@en, "propriété de dureté"@fr, "propiedad de dureza"@es, "Härte Eigenschafte"@de ;
    skos:definition "Materials property representing the material's resistance to deformation under an applied compressive load from a test fixture of known tip geometry"@en, "Propriété des matériaux représentant la résistance du matériau à la déformation sous une charge de compression appliquée à partir d'un dispositif d'essai à géométrie de pointe connue"@fr, "Materialeigenschaft, die den Widerstand des Materials gegen Verformung unter einer aufgebrachten Druckbelastung von einer Prüfvorrichtung mit bekannter Spitzengeometrie darstellt"@de, "Propiedad del material que representa la resistencia del material a la deformación bajo una carga de compresión aplicada desde un dispositivo de prueba con geometría de punta conocida"@es ;
    rdfs:subClassOf sio:SIO_000052 .

:HardnessTestStandard a owl:Class ;
    rdfs:label "Hardness Test Standard"@en, "Norme de test de dureté"@fr, "Norma de Ensayo de Dureza"@es, "Härteteststandard"@de ;
    skos:definition "A materials testing standard, created by a standards body such as ASTM, defining test parameters such as pre-load, load, and tip geometry of the testing apparatus"@en,
        "Une norme d'essai des matériaux, créée par un organisme de normalisation tel que l'ASTM, définissant des paramètres d'essai tels que la précharge, la charge et la géométrie de la pointe de l'appareil d'essai"@fr,
        "Ein Materialprüfstandard, erstellt von einer Normungsorganisation wie ASTM, der Prüfparameter wie Vorspannung, Belastung und Spitzengeometrie der Prüfapparatur definiert"@de,
        "Una norma de ensayo de materiales, creada por un organismo de normalización como ASTM, que define parámetros de prueba como la precarga, la carga y la geometría de la punta del aparato de ensayo"@es ;
    rdfs:subClassOf :HardnessProperty .

:HardnessScale a owl:Class ;
    rdfs:label "Hardness Scale"@en, "Valeur de Dureté"@fr, "Escala de Dureza"@es, "Härte Skala"@de ;
    skos:definition "A standard numerical scale associated with a particular hardness test tip geometry"@en, "Une échelle numérique standard associée à une géométrie spécifique de pointe de test de dureté"@fr, "Eine standardisierte numerische Skala, die mit einer bestimmten Geometrie der Härteprüfspitze verbunden ist"@de, "Una escala numérica estándar asociada con una geometría particular de la punta de prueba de dureza"@es ;
    rdfs:subClassOf :HardnessProperty .

:ViscoelasticProperty a owl:Class ;
    rdfs:label "Viscoelastic Property"@en, "Propriété viscoélastiqueé"@fr, "Propiedad Viscoelástica"@es, "Viskoelastische Eigenschaft"@de ;
    skos:definition "Properties of materials that exhibit both viscous and elastic behaviors"@en, "Propriétés des matériaux qui présentent à la fois des comportements visqueux et élastiques"@fr, "Eigenschaften von Materialien, die sowohl viskoses als auch elastisches Verhalten zeigen"@de, "Propiedades de materiales que exhiben comportamientos tanto viscosos como elásticos"@es ;
    rdfs:subClassOf sio:SIO_000052 .

:DynamicProperty a owl:Class ;
    rdfs:label "Dynamic Property"@en, "Propriété Dynamique"@fr, "Propiedad Dinámica"@es, "Dynamische Eigenschaft"@de ;
    skos:definition "A materials property representing the behavior of the material under some dynamic environmental force"@en, "Une propriété des matériaux représentant le comportement du matériau sous une force environnementale dynamique"@fr, "Eine Materialeigenschaft, die das Verhalten des Materials unter einer dynamischen Umweltkraft beschreibt"@de, "Una propiedad de los materiales que representa el comportamiento del material bajo una fuerza ambiental dinámica"@es ;
    rdfs:subClassOf :ViscoelasticProperty .

:Torsion a owl:Class ;
    rdfs:label "Torsion"@en, "torsion"@fr, "torsión"@es, "Verdrillung"@de ; 
    skos:definition "Describing countervailing rotational forces about the central axis of a material, separated by some distance along the central axis of the material; 'twisting' force"@en,
        "Décrivant des forces de rotation opposées autour de l'axe central d'un matériau, séparées par une certaine distance le long de cet axe; force de 'torsion'"@fr,
        "Beschreibung gegenwirkender Drehkräfte um die Mittelachse eines Materials, die entlang der Mittelachse des Materials durch einen Abstand getrennt sind; 'Dreh'-Kraft"@de,
        "Describe fuerzas rotacionales contrarias alrededor del eje central de un material, separadas por cierta distancia a lo largo del eje central del material; fuerza de 'torsión'"@es ;
    rdfs:subClassOf :ViscoelasticProperty .

:Tensile a owl:Class ;
    rdfs:label "Tensile"@en, "à traction"@fr, "extensible"@es, "dehnbar"@de ;
    skos:definition "Describing countervailing forces applied outward along the central axis of a material"@en,
        "Description des forces opposées appliquées vers l'extérieur le long de l'axe central d'un matériau"@fr,
        "Beschreibung von entgegenwirkenden Kräften, die entlang der Mittelachse eines Materials nach außen wirken"@de,
        "Descripción de fuerzas contrapuestas aplicadas hacia afuera a lo largo del eje central de un material"@es ;
    rdfs:subClassOf :ViscoelasticProperty .

:Shear a owl:Class ;
    rdfs:label "Shear"@en, "cisailler"@fr, "esquilar"@es, "Scheren"@de ;
    skos:definition "Describing opposing in-plane forces on a material"@en, "Description des forces opposées dans le plan sur un matériau"@fr, "Beschreibung entgegengesetzter Kräfte in der Ebene auf ein Material"@de, "Descripción de fuerzas opuestas en el plano sobre un material"@es ;
    rdfs:subClassOf :ViscoelasticProperty .

:Compression a owl:Class ;
    rdfs:label "Compression"@en, "compression"@fr, "Compresión"@es, "Verdichtung"@de ;
    skos:definition "Describing opposing in-plane forces on a material"@en, "Description des forces opposées dans le plan sur un matériau"@fr, "Beschreibung gegensätzlicher in der Ebene wirkender Kräfte auf ein Material"@de, "Descripción de fuerzas opuestas en el plano sobre un material"@es ;
    rdfs:subClassOf :ViscoelasticProperty .

:Creep a owl:Class ;
    rdfs:label "Creep"@en, "e glisser"@fr, "deslizarse"@es, "schleichen"@de ;
    skos:definition "Creep is the tendency of material to move slowly or deform permanently under the influence of mechanical stresses"@en, "Le fluage est la tendance d’un matériau à se déplacer lentement ou à se déformer de façon permanente sous l’influence de contraintes mécaniques"@fr, "Kriechen ist die Tendenz eines Materials, sich langsam zu bewegen oder dauerhaft unter dem Einfluss mechanischer Belastungen zu verformen"@de, "La fluencia es la tendencia de un material a moverse lentamente o deformarse permanentemente bajo la influencia de tensiones mecánicas"@es ;
    rdfs:subClassOf :ViscoelasticProperty .

:CompressiveCreep a owl:Class ;
    rdfs:label "Compressive Creep"@en, "fluage sous compression"@fr, "Fluencia compresiva"@es, "Kriechverformung unter Druck"@de ;
    skos:definition "creep during compressive test"@en, "fluage lors d’un essai de compression"@fr, "Kriechen während des Drucktests"@de, "flujo durante la prueba de compresión"@es ;
    rdfs:subClassOf :Creep .

:CompressiveCreepRuptureStrength a owl:Class ;
    rdfs:label "Compressive Creep Rupture Strength"@en, "Résistance à la rupture par fluage en compression"@fr, "Resistencia a la Fluencia Compresiva Ruptura"@es, "Druckzeitbruchfestigkeit"@de ;
    skos:definition "Material strength at rupture during a compressive creep test"@en, "Résistance du matériau à la rupture lors d'un essai de fluage en compression"@fr, "Materialfestigkeit beim Bruch während eines Druckkriechversuchs"@de, "Resistencia del material a la ruptura durante una prueba de fluencia a compresión"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
        :CompressiveCreep .

:CompressiveCreepRuptureTime a owl:Class ;
    rdfs:label "Compressive Creep Rupture Time"@en, "Temps de rupture par fluage par compression"@fr, "Tiempo de Resistencia a Cargas de Creep a Compresión"@es, "Druckkriechbruchzeit"@de ;
    skos:definition "Time taken to rupture from applying load during a compressive creep test"@en, "Temps nécessaire à la rupture lors de l'application de la charge pendant un essai de fluage en compression"@fr, "Zeit bis zum Bruch nach Belastungsanwendung während eines Druckkriechversuchs"@de, "Tiempo hasta la ruptura desde la aplicación de la carga durante una prueba de fluencia a compresión"@es ;
    rdfs:subClassOf :CompressiveCreep ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time> ;
            owl:onProperty sio:SIO_000221 ],
        :CompressiveCreep .

:CompressiveCreepStrain a owl:Class ;
    rdfs:label "Compressive Creep Strain"@en, "Contrainte de Flottement Compressif"@fr, "deformación plástica compresiva"@es, "Druckkriechdehnung"@de ;
    skos:definition "Profile of strain as a function of time during a compressive creep test"@en, "Profil de déformation en fonction du temps lors d’un essai de fluage en compression"@fr, "Verformungsprofil als Funktion der Zeit während eines Kriechversuchs unter Druck"@de, "Perfil de deformación en función del tiempo durante una prueba de fluencia por compresión"@es ;
    rdfs:subClassOf :CompressiveCreep .

:TensileCreep a owl:Class ;
    rdfs:label "Tensile Creep"@en, "Fluage en traction"@fr, "Zugkriechen"@de, "Fluencia a la tracción"@es ;
    skos:definition "Creep during tensile test"@en, "Fluage lors de l'essai de traction"@fr, "Kriechen während des Zugversuchs"@de, "Fluencia durante la prueba de tracción"@es ;
    rdfs:subClassOf :Creep .

:TensileCreepRecovery a owl:Class ;
    rdfs:label "Tensile Creep Recovery"@en, "Récupération après fluage en traction"@fr, "Spannungsrückstellung nach Kriechen"@de, "Recuperación tras fluencia a tracción"@es ;
    skos:definition "Ability of material to recover to original state after creep"@en, "Capacité du matériau à retrouver son état initial après fluage"@fr, "Fähigkeit des Materials, nach Kriechen in den ursprünglichen Zustand zurückzukehren"@de, "Capacidad del material para recuperar su estado original después del fluencia"@es ;
    rdfs:subClassOf :TensileCreep .

:TensileCreepModulus a owl:Class ;
    rdfs:label "Tensile Creep Modulus"@en, "Module de fluage en traction"@fr, "Zug-Kriechmodul"@de, "Módulo de fluencia a la tracción"@es ;
    skos:definition "Elastic modulus during creep test"@en, "Module d'élasticité pendant l'essai de fluage"@fr, "Elastizitätsmodul während des Kriechversuchs"@de, "Módulo elástico durante la prueba de fluencia"@es ;
     rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
        :TensileCreep .

:TensileCreepCompliance a owl:Class ;
    rdfs:label "Tensile Creep Compliance"@en, "Conformité au fluage en traction"@fr, "Zugkriechen-Konformität"@de, "Cumplimiento de fluencia a la tracción"@es ;
    skos:definition "Inverse of tensile creep modulus"@en, "Inverse du module de fluage en traction"@fr, "Inverse des Zugkriechmoduls"@de, "Inverso del módulo de fluencia a la tracción"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://nanomine.org/ns/unit/m-2-g> ;
            owl:onProperty sio:SIO_000221 ],
        :TensileCreep .

:TensileCreepRuptureStrength a owl:Class ;
    rdfs:label "Tensile Creep Rupture Strength"@en, "Résistance à la rupture par fluage en traction"@fr, "Zugkriechbruchfestigkeit"@de, "Resistencia a la ruptura por fluencia a tracción"@es ;
    skos:definition "Material strength at rupture during a tensile creep test"@en, "Résistance du matériau à la rupture lors d’un essai de fluage en traction"@fr, "Festigkeit des Materials beim Bruch während eines Kriechversuchs unter Zugbelastung"@de, "Resistencia del material a la rotura durante un ensayo de fluencia a tracción"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :N ;
            owl:onProperty sio:SIO_000221 ],
   :TensileCreep .

:TensileCreepRuptureTime a owl:Class ;
    rdfs:label "Tensile Creep Rupture Time"@en, "Temps de rupture en fluage en traction"@fr, "Zeit bis zum Kriechbruch bei Zugbeanspruchung"@de, "Tiempo de rotura por fluencia a tracción"@es ;
    skos:definition "Time taken to rupture from applying load during a tensile creep test"@en, "Temps nécessaire à la rupture sous charge lors d’un essai de fluage en traction"@fr, "Zeit bis zum Bruch unter Belastung während eines Kriechversuchs bei Zugbeanspruchung"@de, "Tiempo hasta la rotura bajo carga durante una prueba de fluencia a tracción"@es ;
    rdfs:subClassOf :TensileCreep .

:TensileCreepStrain a owl:Class ;
    rdfs:label "Tensile Creep Strain"@en, "Déformation de fluage en traction"@fr, "Kriechdehnung bei Zugbelastung"@de, "Deformación por fluencia en tracción"@es ;
    skos:definition "Profile of strain as a function of time during a tensile creep test"@en, "Profil de la déformation en fonction du temps lors d’un essai de fluage en traction"@fr, "Verformungsprofil in Abhängigkeit von der Zeit während eines Kriechversuchs unter Zugbelastung"@de, "Perfil de la deformación en función del tiempo durante una prueba de fluencia por tracción"@es ;
    rdfs:subClassOf :TensileCreep .

:FlexuralCreep a owl:Class ;
    rdfs:label "Flexural Creep"@en, "Fluage en flexion"@fr, "Biegekriechen"@de, "Fluencia por flexión"@es ;
    skos:definition "Creep during flexural or bending test."@en, "Fluage pendant un essai de flexion ou de courbure."@fr, "Kriechen während eines Biege- oder Durchbiegungstests."@de, "Fluencia durante una prueba de flexión o de doblado."@es ;
    rdfs:subClassOf :Creep .

:FlexuralCreepRuptureStrength a owl:Class ;
    rdfs:label "Flexural Creep Rupture Strength"@en, "Résistance à la rupture en fluage en flexion"@fr, "Biegekriechbruchfestigkeit"@de, "Resistencia a la rotura por fluencia en flexión"@es ;
    skos:definition "Material strength at rupture during a flexural creep test."@en, "Résistance du matériau à la rupture lors d’un essai de fluage en flexion."@fr, "Materialfestigkeit beim Bruch während eines Kriechbiegetests."@de, "Resistencia del material a la rotura durante una prueba de fluencia en flexión."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/pascal> ;
            owl:onProperty sio:SIO_000221 ],
        :FlexuralCreep .

:FlexuralCreepRuptureTime a owl:Class ;
    rdfs:label "Flexural Creep Rupture Time"@en, "Temps de rupture en fluage en flexion"@fr, "Kriechbruchzeit bei Biegung"@de, "Tiempo de rotura por fluencia en flexión"@es ;
    skos:definition "Time taken to rupture from applying load during a flexural creep test."@en, "Temps nécessaire à la rupture sous charge lors d’un essai de fluage en flexion."@fr, "Zeit bis zum Bruch unter Belastung während eines Biegekrüche-Tests."@de, "Tiempo hasta la rotura al aplicar carga durante una prueba de fluencia por flexión."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time> ;
            owl:onProperty sio:SIO_000221 ],
        :FlexuralCreep .

:FlexuralCreepStrain a owl:Class ;
    rdfs:label "Flexural Creep Strain"@en, "Déformation visqueuse en flexion"@fr, "Biegekruppverformung"@de, "Deformación por fluencia a la flexión"@es ;
    skos:definition "Profile of strain as a function of time during a flexural creep test."@en, "Profil de déformation en fonction du temps lors d’un essai de fluage en flexion."@fr, "Verlaufsprofil der Dehnung als Funktion der Zeit während eines Biegekruppversuchs."@de, "Perfil de deformación en función del tiempo durante una prueba de fluencia a flexión."@es ;
    rdfs:subClassOf :FlexuralCreep .

:ElectricalProperty a owl:Class ;
    rdfs:label "Electrical Property"@en, "Propriété électrique"@fr, "Elektrische Eigenschaft"@de, "Propiedad eléctrica"@es ;
    skos:definition "A materials property describing the material's behavior under some applied electrical field"@en, "Une propriété des matériaux décrivant le comportement du matériau sous un champ électrique appliqué"@fr, "Eine Materialeigenschaft, die das Verhalten des Materials unter einem angelegten elektrischen Feld beschreibt"@de, "Una propiedad de los materiales que describe el comportamiento del material bajo un campo eléctrico aplicado"@es ;
    rdfs:subClassOf sio:SIO_000052 .

:ElectricalProperty a owl:Class ;
    rdfs:label "Electrical Property"@en, "Propriété électrique"@fr, "Elektrische Eigenschaft"@de, "Propiedad eléctrica"@es ;
    skos:definition "This. The imaginary component of the frequency-dependent complex permittivity of a material under an oscillating electric field."@en,
        "La composante imaginaire de la permittivité complexe dépendante de la fréquence d’un matériau soumis à un champ électrique oscillant."@fr,
        "Die imaginäre Komponente der frequenzabhängigen komplexen Permittivität eines Materials unter einem oszillierenden elektrischen Feld."@de,
        "La componente imaginaria de la permitividad compleja dependiente de la frecuencia de un material bajo un campo eléctrico oscilante."@es ;
    rdfs:subClassOf :ElectricalProperty .

:DielectricRealPermittivity a owl:Class ;
    rdfs:label "Dielectric Real Permittivity"@en, "Permittivité diélectrique réelle"@fr, "Dielektrische reale Permittivität"@de, "Permisividad dieléctrica real"@es ;
    skos:definition "The real component of the frequency-dependent complex permittivity of a material under an oscillating electric field."@en, "La composante réelle de la permittivité complexe dépendante de la fréquence d’un matériau soumis à un champ électrique oscillant."@fr, "Die reale Komponente der frequenzabhängigen komplexen Permittivität eines Materials unter einem oszillierenden elektrischen Feld."@de, "El componente real de la permitividad compleja dependiente de la frecuencia de un material bajo un campo eléctrico oscilante."@es ;
    rdfs:subClassOf :ElectricalProperty .

:DielectricLossTangent a owl:Class ;
    rdfs:label "Dielectric Loss Tangent"@en, "Tangente de perte diélectrique"@fr, "Dielektrischer Verlustwinkel"@de, "Tangente de pérdida dieléctrica"@es ;
    skos:definition "The ratio of the imaginary to real components of permittivity, representing the dissipation of electromagnetic energy in the presence of an oscillating electric field."@en, "Le rapport des composantes imaginaire et réelle de la permittivité, représentant la dissipation de l'énergie électromagnétique en présence d'un champ électrique oscillant."@fr, "Das Verhältnis der imaginären zu den reellen Komponenten der Permittivität, das die Dissipation elektromagnetischer Energie im Vorhandensein eines oszillierenden elektrischen Feldes darstellt."@de, "La proporción de los componentes imaginarios a reales de la permitividad, que representa la disipación de energía electromagnética en presencia de un campo eléctrico oscilante."@es ;
    rdfs:subClassOf :ElectricalProperty .

:DC_DielectricConstant a owl:Class ;
    rdfs:label "DC Dielectric Constant"@en, "Constante diélectrique en courant continu"@fr, "Gleichstrom-Dielektrizitätskonstante"@de, "Constante dieléctrica de CC"@es ;
    skos:definition "A measure of the electric polarizability of a dielectric material."@en, "Une mesure de la polarizabilité électrique d'un matériau diélectrique."@fr, "Ein Maß für die elektrische Polarisierbarkeit eines dielektrischen Materials."@de, "Una medida de la polarizabilidad eléctrica de un material dieléctrico."@es ;
    rdfs:subClassOf :ElectricalProperty .

:AC_DielectricDispersion a owl:Class ;
    rdfs:label "AC Dielectric Dispersion"@en, "Dispersion diélectrique en courant alternatif"@fr, "Wechselstrom-Dielektrische Dispersion"@de, "Dispersión dieléctrica de CA"@es ;
    skos:definition "Frequency dependence of dielectric permittivity under an oscillating electric field"@en, "Dépendance en fréquence de la permittivité diélectrique sous un champ électrique oscillant"@fr, "Frequenzabhängigkeit der dielektrischen Permittivität unter einem oszillierenden elektrischen Feld"@de, "Dependencia de frecuencia de la permitividad dieléctrica bajo un campo eléctrico oscilante"@es ;
    rdfs:subClassOf :ElectricalProperty .

:AC_DielectricConstant a owl:Class ;
    rdfs:label "AC Dielectric Constant"@en, "Constante diélectrique AC"@fr, "Wechselstrom-Dielektrizitätskonstante"@de, "Constante dieléctrica de CA"@es ;
    skos:definition "Frequency dependence of dielectric permittivity under an oscillating electric field"@en, "Dépendance en fréquence de la permittivité diélectrique sous un champ électrique oscillant"@fr, "Frequenzabhängigkeit der dielektrischen Permittivität unter einem oszillierenden elektrischen Feld"@de, "Dependencia de frecuencia de la permitividad dieléctrica bajo un campo eléctrico oscilante"@es ;
    rdfs:subClassOf :ElectricalProperty .

:Impedance a owl:Class ;
    rdfs:label "Impedance"@en, "Impédance"@fr, "Impedanz"@de, "Impedancia"@es ;
    skos:definition "The effective resistance to an alternating current"@en, "La résistance efficace à un courant alternatif"@fr, "Der effektive Widerstand bei Wechselstrom"@de, "La resistencia eficaz a una corriente alterna"@es ;
    rdfs:subClassOf :ElectricalProperty .

:DielectricBreakdownStrength a owl:Class ;
    rdfs:label "Dielectric Breakdown Strength"@en, "Résistance diélectrique à la rupture"@fr, "Dielektrische Durchschlagsfestigkeit"@de, "Resistencia dieléctrica de ruptura"@es ;
    skos:definition "Maximum voltage required to produce a dielectric breakdown through the material and is expressed as Volts per unit thickness."@en, "Tension maximale requise pour provoquer une rupture diélectrique à travers le matériau, exprimée en volts par unité d'épaisseur."@fr, "Maximale Spannung, die erforderlich ist, um einen elektrischen Durchbruch durch das Material zu erzeugen, angegeben in Volt pro Einheit Dicke."@de, "Voltaje máximo requerido para producir una ruptura dieléctrica a través del material, expresado en voltios por unidad de espesor."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://nanomine.org/ns/unit/m-2g> ;
            owl:onProperty sio:SIO_000221 ],
            :ElectricalProperty ;
    :hasPreferredUnit <http://materialsmine.org/ns/unit/kv-mm> .

:VolumeResistivity a owl:Class ;
    rdfs:label "Volume Resistivity"@en, "Résistivité volumique"@fr, "Volumenwiderstand"@de, "Resistividad volumétrica"@es ;
    skos:definition "Ability to oppose the flow of electric current"@en, "Capacité à s’opposer au flux de courant électrique"@fr, "Fähigkeit, dem Fluss des elektrischen Stroms zu widerstehen"@de, "Capacidad para oponerse al flujo de corriente eléctrica"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Ohmm ;
            owl:onProperty sio:SIO_000221],
       :ElectricalProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/ohmMetre> .

:SurfaceResistivity a owl:Class ;
    rdfs:label "Surface Resistivity"@en, "Résistivité de surface"@fr, "Oberflächenwiderstand"@de, "Resistividad superficial"@es ;
    skos:definition "Ability to resist leakage current along the surface of an insulating material."@en, "Capacité à résister au courant de fuite le long de la surface d'un matériau isolant."@fr, "Fähigkeit, den Leckstrom entlang der Oberfläche eines Isoliermaterials zu widerstehen."@de, "Capacidad para resistir la corriente de fuga a lo largo de la superficie de un material aislante."@es ;
    rdfs:subClassOf :ElectricalProperty ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :Ohmm ;
            owl:onProperty sio:SIO_000221],
       :ElectricalProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/ohmMetre> .

:ElectricalConductivity a owl:Class ;
    rdfs:label "Electrical Conductivity"@en, "Conductivité électrique"@fr, "Elektrische Leitfähigkeit"@de, "Conductividad eléctrica"@es ;
    skos:definition "Ability of electric current to flow through a material"@en, "Capacité du courant électrique à circuler à travers un matériau"@fr, "Fähigkeit des elektrischen Stroms, durch ein Material zu fließen"@de, "Capacidad de la corriente eléctrica para fluir a través de un material"@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue  <http://www.ontology-of-units-of-measure.org/resource/om-2/siemensPerMetre> ;
            owl:onProperty sio:SIO_000221 ],
            :ElectricalProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/siemensPerMetre> .

:ArcResistance a owl:Class ;
    rdfs:label  "Arc Resistance"@en, "Résistance à l'arc"@fr, "Lichtbogenzähigkeit"@de, "Resistencia al arco"@es ;
    skos:definition "A measure of the durability of an insulating or dielectric material against the formation of conductive paths along the surface by arc discharges."@en, "Une mesure de la durabilité d’un matériau isolant ou diélectrique contre la formation de chemins conducteurs à la surface par des décharges d’arc."@fr, "Ein Maß für die Haltbarkeit eines isolierenden oder dielektrischen Materials gegen die Bildung leitfähiger Pfade entlang der Oberfläche durch Lichtbogenentladungen."@de, "Una medida de la durabilidad de un material aislante o dieléctrico contra la formación de caminos conductores a lo largo de la superficie por descargas de arco."@es ;
     rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/second-Time> ;
            owl:onProperty sio:SIO_000221 ],
        :ElectricalProperty .

:ElectricPercolationThreshold a owl:Class ;
    rdfs:label "Electric Percolation Threshold"@en, "Seuil de percolation électrique"@fr, "Elektrische Perkolationsschwelle"@de, "Umbral de percolación eléctrica"@es ;
    skos:definition "minimum filler content in the polymer matrix after which there is no significant change in the electrical properties of the composites."@en, "teneur minimale de charge dans la matrice polymère au-delà de laquelle il n'y a plus de changement significatif des propriétés électriques des composites."@fr, "minimaler Füllstoffgehalt in der Polymermatrix, ab dem sich die elektrischen Eigenschaften der Verbundwerkstoffe nicht mehr wesentlich ändern."@de, "contenido mínimo de relleno en la matriz polimérica a partir del cual no hay un cambio significativo en las propiedades eléctricas de los compuestos."@es ;
    rdfs:subClassOf :ElectricalProperty .

:EnergyDensity a owl:Class ;
    rdfs:label "Energy Density"@en, "Densité d'énergie"@fr, "Energiedichte"@de, "Densidad de energía"@es ;
    skos:definition "amount of energy stored in a given system or region of space per unit volume or mass"@en, "quantité d'énergie stockée dans un système donné ou une région de l'espace par unité de volume ou de masse"@fr, "Menge an Energie, die in einem bestimmten System oder Raumgebiet pro Volumen- oder Masseneinheit gespeichert ist"@de, "cantidad de energía almacenada en un sistema o región del espacio por unidad de volumen o masa"@es ;
     rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue  <http://nanomine.org/ns/unit/kev> ;
            owl:onProperty sio:SIO_000221 ],
        :ElectricalProperty .

:CurrentDensity a owl:Class ;
    rdfs:label "Current Density"@en, "Densité de courant"@fr, "Stromdichte"@de, "Densidad de corriente"@es ;
    skos:definition "The amount of electric current flowing per unit cross-sectional area of a material"@en, "La quantité de courant électrique circulant par unité de surface de section d’un matériau"@fr, "Die Menge an elektrischem Strom, die pro Flächeneinheit eines Materials fließt"@de, "La cantidad de corriente eléctrica que fluye por unidad de área de sección transversal de un material"@es ;
    rdfs:subClassOf :ElectricalProperty ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue  <http://nanomine.org/ns/unit/kv> ;
            owl:onProperty sio:SIO_000221 ],
    :ElectricalProperty .

:ComparativeTrackingIndex a owl:Class ;
    rdfs:label "Comparative Tracking Index"@en, "Indice de suivi comparatif"@fr, "Vergleichbarer Kriechstromindex"@de, "Índice de seguimiento comparativo"@es ;
    skos:definition "maximum voltage at which an insulating material can withstand 50 drops of contaminated water without tracking."@en,
        "Tension maximale à laquelle un matériau isolant peut résister à 50 gouttes d'eau contaminée sans amorçage."@fr,
        "Maximale Spannung, bei der ein Isoliermaterial 50 Tropfen verunreinigten Wassers ohne Kriechstrombildung standhält."@de,
        "Tensión máxima a la que un material aislante puede soportar 50 gotas de agua contaminada sin formación de caminos de fuga."@es ;
  rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :V ;
            owl:onProperty sio:SIO_000221],
       :ElectricalProperty .

:Flammability a owl:Class ;
    rdfs:label "Flammability Index"@en, "Indice d'inflammabilité"@fr, "Entflammbarkeitsindex"@de, "Índice de inflamabilidad"@es ;
    skos:definition "A standard that measures how a plastic material burns and how well it prevents flames."@en, "Une norme qui mesure comment un matériau plastique brûle et son efficacité à empêcher les flammes."@fr, "Ein Standard, der misst, wie ein Kunststoffmaterial brennt und wie gut es Flammen verhindert."@de, "Un estándar que mide cómo quema un material plástico y qué tan bien previene las llamas."@es ;
    rdfs:subClassOf :ElectricalProperty .

:ShieldingEffectiveness a owl:Class ;
    rdfs:label "Shielding Effectiveness Index"@en, "Indice d'efficacité du blindage"@fr, "Abschirmwirkungsgrad-Index"@de, "Índice de eficacia del blindaje"@es ;
    skos:definition "a metric that measures how well a shield can block or absorb electromagnetic radiation, such as radio frequency (RF) signals."@en, "une mesure qui évalue l'efficacité d'un blindage à bloquer ou absorber les radiations électromagnétiques, telles que les ondes radio (RF)."@fr, "eine Metrik, die misst, wie gut ein Schild elektromagnetische Strahlung wie Hochfrequenzsignale (RF) blockieren oder absorbieren kann."@de, "una métrica que mide qué tan bien un blindaje puede bloquear o absorber la radiación electromagnética, como las señales de radiofrecuencia (RF)."@es ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :dB ;
            owl:onProperty sio:SIO_000221],
       :ElectricalProperty .

:ThermalProperty a owl:Class ;
    rdfs:label "Thermal Property"@en, "Propriété thermique"@fr, "Thermische Eigenschaft"@de, "Propiedad térmica"@es ;
    skos:definition "A material's property describing the material's ability to absorb, conduct, or otherwise interact with energy in the form of heat."@en, "Propriété d’un matériau décrivant sa capacité à absorber, conduire ou interagir avec l’énergie sous forme de chaleur."@fr, "Eine Materialeigenschaft, die die Fähigkeit beschreibt, Wärmeenergie aufzunehmen, zu leiten oder anderweitig damit zu interagieren."@de, "Propiedad de un material que describe su capacidad para absorber, conducir o interactuar con la energía en forma de calor."@es ;
    rdfs:subClassOf :SIO_000052 .

:Crystallinity a owl:Class ;
    rdfs:label "Crystallinity"@en, "Cristallinité"@fr, "Kristallinität"@de, "Cristalinidad"@es ;
    skos:definition "degree of structural order in a solid."@en, "degré d'ordre structurel dans un solide."@fr, "Grad der strukturellen Ordnung in einem Festkörper."@de, "grado de orden estructural en un sólido."@es ;
    rdfs:subClassOf :Crystallinity .

:DegreeOfCrystallization a owl:Class ;
    rdfs:label "Degree Of Crystallization"@en, "Degré de cristallisation"@fr, "Kristallisationsgrad"@de, "Grado de cristalización"@es ;
    skos:definition "The percentage of the crystallized region in a polymer/material. It describes the extent of the crystallization process."@en,
        "Pourcentage de la région cristallisée dans un polymère ou matériau. Il décrit l'étendue du processus de cristallisation."@fr,
        "Prozentsatz des kristallisierten Bereichs in einem Polymer oder Material. Er beschreibt das Ausmaß des Kristallisationsprozesses."@de,
        "Porcentaje de la región cristalizada en un polímero o material. Describe el alcance del proceso de cristalización."@es ;
    rdfs:subClassOf :Crystallinity .

:GrowthRateOfCrystal a owl:Class ;
    rdfs:label "Growth Rate Of Crystal"@en, "Taux de croissance du cristal"@fr, "Wachstumsrate des Kristalls"@de, "Tasa de crecimiento del cristal"@es ;
    skos:definition "Rate of the crystallization process."@en, "Taux du processus de cristallisation."@fr, "Rate des Kristallisationsprozesses."@de, "Tasa del proceso de cristalización."@es ;
    rdfs:subClassOf :Crystallinity .

:GrowthRateParameterOfAvramiEquation a owl:Class ;
    rdfs:label "Growth Rate Parameter Of Avrami E quation"@en, "Paramètre du taux de croissance de l'équation d'Avrami"@fr, "Wachstumsratenparameter der Avrami-Gleichung"@de, "Parámetro de tasa de crecimiento de la ecuación de Avrami"@es ;
    skos:definition "Growth Rate Parameter in Avrami Equation"@en, "Paramètre de taux de croissance dans l'équation d'Avrami"@fr, "Wachstumsratenparameter in der Avrami-Gleichung"@de, "Parámetro de tasa de crecimiento en la ecuación de Avrami"@es ;
    rdfs:subClassOf :Crystallinity .

 :NucleationParameterOfAvramiEquation a owl:Class ;
    rdfs:label "Nucleation Parameter Of Avrami Equation"@en, "Paramètre de nucléation de l'équation d'Avrami"@fr, "Nukleationsparameter der Avrami-Gleichung"@de, "Parámetro de nucleación de la ecuación de Avrami"@es ;
    skos:definition "Nucleation Parameter in Avrami Equation"@en, "Paramètre de nucléation dans l’équation d’Avrami"@fr, "Keimungsparameter in der Avrami-Gleichung"@de, "Parámetro de nucleación en la ecuación de Avrami"@es ;
    rdfs:subClassOf :Crystallinity .

:HalflifeOfCrystallization a owl:Class ;
    rdfs:label "Halflife Of Crystallization"@en, "Demi-vie de cristallisation"@fr, "Halbwertszeit der Kristallisation"@de, "Vida media de cristalización"@es ;
    skos:definition "The time required for half of a material to form a crystalline structure under some condition."@en, "Le temps nécessaire pour que la moitié d'un matériau forme une structure cristalline sous certaines conditions."@fr, "Die Zeit, die benötigt wird, damit die Hälfte eines Materials unter bestimmten Bedingungen eine kristalline Struktur bildet."@de, "El tiempo necesario para que la mitad de un material forme una estructura cristalina bajo ciertas condiciones."@es ;
    rdfs:subClassOf :Crystallinity .

:CrystallizationTemperature a owl:Class ;
    rdfs:label "Crystallization Temperature"@en, "Température de cristallisation"@fr, "Kristallisationstemperatur"@de, "Temperatura de cristalización"@es ;
    skos:definition "It is the temperature at which a solid phase begins to form, resulting in a mixture of solid particles and solution"@en,
        "C’est la température à laquelle une phase solide commence à se former, entraînant un mélange de particules solides et de solution"@fr,
        "Es ist die Temperatur, bei der sich eine feste Phase zu bilden beginnt, was zu einer Mischung aus festen Partikeln und Lösung führt"@de,
        "Es la temperatura a la que comienza a formarse una fase sólida, lo que da lugar a una mezcla de partículas sólidas y solución"@es ;
    rdfs:subClassOf ::ThermalProperty, obo:PATO_0000146 .

:HeatOfCrystallization a owl:Class ;
    rdfs:label "Heat of Crystallization"@en, "Chaleur de cristallisation"@fr, "Calor de cristalización"@es, "Kristallisationswärme"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :J ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty ;
    skos:definition "The amount of heat that must be removed from one gram of a liquid at its freezing point to freeze it with no change in temperature."@en,
                    "La quantité de chaleur qui doit être retirée d’un gramme de liquide à son point de congélation pour le geler sans changement de température."@fr,
                    "La cantidad de calor que debe extraerse de un gramo de líquido en su punto de congelación para congelarlo sin cambio de temperatura."@es,
                    "Die Wärmemenge, die aus einem Gramm Flüssigkeit an ihrem Gefrierpunkt entfernt werden muss, um sie ohne Temperaturänderung einzufrieren."@de ;
    :hasPreferredUnit <http://qudt.org/vocab/unit/j-per-gm> .

:HeatOfFusion a owl:Class ;
    rdfs:label "Heat of Fusion"@en, "Chaleur de fusion"@fr, "Calor de fusión"@es, "Schmelzwärme"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :J ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty ;
    skos:definition "Change in enthalpy with energy dissipation."@en,
                    "Changement d’enthalpie avec dissipation d’énergie."@fr,
                    "Cambio en la entalpía con disipación de energía."@es,
                    "Änderung der Enthalpie mit Energieabgabe."@de ;
    :hasPreferredUnit <http://qudt.org/vocab/unit/j-per-gm> .

:DSCProfile a owl:Class ;
    rdfs:label "DSC Profile"@en, "Profil DSC"@fr, "Perfil DSC"@es, "DSC-Profil"@de ;
    skos:definition "Heat flow vs temperature out of a differential scanning calorimetry experiment."@en,
                    "Flux de chaleur par rapport à la température issu d’une expérience de calorimétrie à balayage différentiel."@fr,
                    "Flujo de calor frente a la temperatura de un experimento de calorimetría de barrido diferencial."@es,
                    "Wärmefluss im Verhältnis zur Temperatur aus einem Experiment der differentiellen Scanning-Kalorimetrie."@de ;
    rdfs:subClassOf :ThermalProperty .

:ThermalDecompositionTemperature a owl:Class ;
    rdfs:label "Thermal Decomposition Temperature"@en, "Température de décomposition thermique"@fr, "Temperatura de descomposición térmica"@es, "Thermische Zersetzungstemperatur"@de ;
    skos:definition "Thermal decomposition temperature of a substance is the temperature at which the substance chemically decomposes by heat."@en,
                    "La température de décomposition thermique d’une substance est la température à laquelle la substance se décompose chimiquement par la chaleur."@fr,
                    "La temperatura de descomposición térmica de una sustancia es la temperatura a la que la sustancia se descompone químicamente por el calor."@es,
                    "Die thermische Zersetzungstemperatur einer Substanz ist die Temperatur, bei der die Substanz durch Wärme chemisch zerfällt."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/kelvin> ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty, obo:PATO_0000146 ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/degreeCelsius> .

:GlassTransitionTemperature a owl:Class ;
    rdfs:label "Glass Transition Temperature"@en, "Température de transition vitreuse"@fr, "Temperatura de transición vítrea"@es, "Glasübergangstemperatur"@de ;
    skos:definition "Is the temperature region where the polymer transitions from a hard, glassy material to a soft, rubbery material."@en,
                    "Est la région de température où le polymère passe d’un matériau dur et vitreux à un matériau mou et caoutchouteux."@fr,
                    "Es la región de temperatura donde el polímero pasa de un material duro y vítreo a un material blando y gomoso."@es,
                    "Ist der Temperaturbereich, in dem das Polymer von einem harten, glasartigen Material zu einem weichen, gummiartigen Material übergeht."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/kelvin> ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty, obo:PATO_0000146 ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/degreeCelsius> .

:LCPhaseTransitionTemperature a owl:Class ;
    rdfs:label "LC Phase Transition Temperature"@en, "Température de transition de phase LC"@fr, "Temperatura de transición de fase LC"@es, "LC-Phasenübergangstemperatur"@de ;
    skos:definition "Temperature of transition to liquid crystal phase."@en,
                    "Température de transition vers la phase de cristal liquide."@fr,
                    "Temperatura de transición a la fase de cristal líquido."@es,
                    "Temperatur des Übergangs zur Flüssigkristallphase."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/kelvin> ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty, obo:PATO_0000146 ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/degreeCelsius> .

:MeltingTemperature a owl:Class ;
    rdfs:label "Melting Temperature"@en, "Température de fusion"@fr, "Temperatura de fusión"@es, "Schmelztemperatur"@de ;
    skos:definition "The temperature at which a solid turns into a liquid."@en,
                    "La température à laquelle un solide se transforme en liquide."@fr,
                    "La temperatura a la que un sólido se convierte en líquido."@es,
                    "Die Temperatur, bei der ein Feststoff in eine Flüssigkeit übergeht."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/kelvin> ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty, obo:PATO_0000146 ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/degreeCelsius> .

:SpecificHeatCapacityCp a owl:Class ;
    rdfs:label "Specific Heat Capacity Cp"@en, "Capacité thermique massique à pression constante"@fr, "Calor específico a presión constante (Cp)"@es, "Spezifische Wärmekapazität bei konstantem Druck"@de ;
    skos:definition "Cp for a gas is the change in the enthalpy (H) of the system with respect to change in temperature at a fixed pressure of the system."@en,
                    "Cp pour un gaz est le changement d’enthalpie (H) du système par rapport au changement de température à une pression fixe du système."@fr,
                    "Cp para un gas es el cambio en la entalpía (H) del sistema con respecto al cambio de temperatura a una presión fija del sistema."@es,
                    "Cp für ein Gas ist die Änderung der Enthalpie (H) des Systems in Bezug auf die Temperaturänderung bei konstantem Druck des Systems."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :j-gk ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty ;
    :hasPreferredUnit <http://materialsmine.org/ns/unit/j-gk> .

:SpecificHeatCapacityCv a owl:Class ;
    rdfs:label "Specific Heat Capacity Cv"@en, "Capacité thermique massique à volume constant"@fr, "Calor específico a volumen constante (Cv)"@es, "Spezifische Wärmekapazität bei konstantem Volumen"@de ;
    skos:definition "Cv for a gas is the change in internal energy (U) of a system with respect to change in temperature at a fixed volume of the system."@en,
                    "Cv pour un gaz est le changement d’énergie interne (U) d’un système par rapport au changement de température à un volume fixe du système."@fr,
                    "Cv para un gas es el cambio en la energía interna (U) de un sistema con respecto al cambio de temperatura a un volumen fijo del sistema."@es,
                    "Cv für ein Gas ist die Änderung der inneren Energie (U) eines Systems in Bezug auf die Temperaturänderung bei konstantem Volumen des Systems."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :j-gk ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty ;
    :hasPreferredUnit <http://materialsmine.org/ns/unit/j-gk> .

:ThermalConductivity a owl:Class ;
    rdfs:label "Thermal Conductivity"@en, "Conductivité thermique"@fr, "Conductividad térmica"@es, "Thermische Leitfähigkeit"@de ;
    skos:definition "A measure of the ability of a substance to conduct heat, determined by the rate of heat flow normally through an area in the substance divided by the area and by minus the component of the temperature gradient in the direction of flow."@en,
                    "Une mesure de la capacité d’une substance à conduire la chaleur, déterminée par le taux de flux de chaleur à travers une surface dans la substance divisé par la surface et par moins la composante du gradient de température dans la direction du flux."@fr,
                    "Una medida de la capacidad de una sustancia para conducir el calor, determinada por la tasa de flujo de calor a través de un área en la sustancia dividida por el área y por menos el componente del gradiente de temperatura en la dirección del flujo."@es,
                    "Ein Maß für die Fähigkeit einer Substanz, Wärme zu leiten, bestimmt durch die Rate des Wärmeflusses normal durch eine Fläche in der Substanz, geteilt durch die Fläche und minus die Komponente des Temperaturgradienten in Flussrichtung."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/wattPerMetreKelvin> ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/wattPerMetreKelvin> .

:ThermalDiffusivity a owl:Class ;
    rdfs:label "Thermal Diffusivity"@en, "Diffusivité thermique"@fr, "Difusividad térmica"@es, "Wärmediffusivität"@de ;
    skos:definition "Thermal diffusivity is the thermal conductivity divided by density and specific heat capacity at constant pressure. It measures the rate of transfer of heat of a material from the hot side to the cold side."@en,
                    "La diffusivité thermique est la conductivité thermique divisée par la densité et la capacité thermique massique à pression constante. Elle mesure le taux de transfert de chaleur d’un matériau du côté chaud au côté froid."@fr,
                    "La difusividad térmica es la conductividad térmica dividida por la densidad y la capacidad calorífica específica a presión constante. Mide la tasa de transferencia de calor de un material desde el lado caliente al lado frío."@es,
                    "Die Wärmediffusivität ist die Wärmeleitfähigkeit geteilt durch die Dichte und die spezifische Wärmekapazität bei konstantem Druck. Sie misst die Rate des Wärmetransfers eines Materials von der heißen zur kalten Seite."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :m-2-s ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty .

:BrittleTemperature a owl:Class ;
    rdfs:label "Brittle Temperature"@en, "Température de fragilité"@fr, "Temperatura de fragilidad"@es, "Sprödigkeitstemperatur"@de ;
    skos:definition "Brittleness temperature is the temperature at which 50% of the tested specimens exhibit brittle failure at specified impact conditions."@en,
                    "La température de fragilité est la température à laquelle 50 % des échantillons testés présentent une rupture fragile dans des conditions d’impact spécifiées."@fr,
                    "La temperatura de fragilidad es la temperatura a la que el 50 % de los especímenes probados presentan una falla frágil en condiciones de impacto especificadas."@es,
                    "Die Sprödigkeitstemperatur ist die Temperatur, bei der 50 % der getesteten Proben unter spezifizierten Aufprallbedingungen einen spröden Bruch aufweisen."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/kelvin> ;
            owl:onProperty sio:SIO_000221 ],
            :ThermalProperty, obo:PATO_0000146 ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/degreeCelsius> .

:VolumetricProperty a owl:Class ;
    rdfs:label "Volumetric Property"@en, "Propriété volumétrique"@fr, "Propiedad volumétrica"@es, "Volumetrische Eigenschaft"@de ;
    skos:definition "A property related to the three-dimensional volume of a material."@en,
                    "Une propriété liée au volume tridimensionnel d’un matériau."@fr,
                    "Una propiedad relacionada con el volumen tridimensional de un material."@es,
                    "Eine Eigenschaft, die mit dem dreidimensionalen Volumen eines Materials zusammenhängt."@de ;
    rdfs:subClassOf sio:SIO_000048 .

:WeightLoss a owl:Class ;
    rdfs:label "Weight Loss"@en, "Perte de poids"@fr, "Pérdida de peso"@es, "Gewichtsverlust"@de ;
    skos:definition "The loss of mass of a material under some condition (e.g., increasing temperature during thermogravimetric analysis)."@en,
                    "La perte de masse d’un matériau dans certaines conditions (par exemple, une augmentation de la température lors d’une analyse thermogravimétrique)."@fr,
                    "La pérdida de masa de un material bajo alguna condición (por ejemplo, aumento de temperatura durante el análisis termogravimétrico)."@es,
                    "Der Masseverlust eines Materials unter bestimmten Bedingungen (z. B. steigende Temperatur während der thermogravimetrischen Analyse)."@de ;
    rdfs:subClassOf :VolumetricProperty .

:InterphaseThickness a owl:Class ;
    rdfs:label "Interphase Thickness"@en, "Épaisseur de l’interphase"@fr, "Espesor de la interfase"@es, "Interphasendicke"@de ;
    skos:definition "Thickness of matrix-particle interaction area with a gradient property as a function of distance from particle surface."@en,
                    "Épaisseur de la zone d’interaction matrice-particule avec une propriété de gradient en fonction de la distance à la surface de la particule."@fr,
                    "Espesor del área de interacción matriz-partícula con una propiedad de gradiente en función de la distancia desde la superficie de la partícula."@es,
                    "Dicke des Interaktionsbereichs zwischen Matrix und Partikel mit einer Gradienteneigenschaft in Abhängigkeit vom Abstand zur Partikeloberfläche."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/nanometre> ;
            owl:onProperty sio:SIO_000221 ],
            :VolumetricProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/nanometre> .

:Density a owl:Class ;
    rdfs:label "Density"@en, "Densité"@fr, "Densidad"@es, "Dichte"@de ;
    skos:definition "Degree of consistency measured by the quantity of mass per unit volume."@en,
                    "Degré de consistance mesuré par la quantité de masse par unité de volume."@fr,
                    "Grado de consistencia medido por la cantidad de masa por unidad de volumen."@es,
                    "Grad der Konsistenz, gemessen durch die Menge an Masse pro Volumeneinheit."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> ;
            owl:onProperty sio:SIO_000221 ],
            :VolumetricProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/kilogramPerCubicmetre> .

:LinearExpansionCoefficient a owl:Class ;
    rdfs:label "Linear Expansion Coefficient"@en, "Coefficient de dilatation linéaire"@fr, "Coeficiente de expansión lineal"@es, "Linearer Ausdehnungskoeffizient"@de ;
    skos:definition "It is the fractional change in length per degree of temperature change."@en,
                    "C’est le changement fractionnaire de la longueur par degré de changement de température."@fr,
                    "Es el cambio fraccionario en la longitud por grado de cambio de temperatura."@es,
                    "Es ist die fraktionierte Änderung der Länge pro Grad Temperaturänderung."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :m-k ;
            owl:onProperty sio:SIO_000221 ],
            :VolumetricProperty .

:VolumeExpansionCoefficient a owl:Class ;
    rdfs:label "Volume Expansion Coefficient"@en, "Coefficient de dilatation volumique"@fr, "Coeficiente de expansión volumétrica"@es, "Volumenausdehnungskoeffizient"@de ;
    skos:definition "Volumetric coefficient of thermal expansion."@en,
                    "Coefficient volumétrique de dilatation thermique."@fr,
                    "Coeficiente volumétrico de expansión térmica."@es,
                    "Volumetrischer Ausdehnungskoeffizient."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :m-3-k ;
            owl:onProperty sio:SIO_000221 ],
            :VolumetricProperty .

:SurfaceTension a owl:Class ;
    rdfs:label "Surface Tension"@en, "Tension de surface"@fr, "Tensión superficial"@es, "Oberflächenspannung"@de ;
    skos:definition "The force that causes the molecules on the surface of a liquid to be pushed together and form a layer."@en,
                    "La force qui pousse les molécules à la surface d’un liquide à se regrouper et à former une couche."@fr,
                    "La fuerza que hace que las moléculas en la superficie de un líquido se junten y formen una capa."@es,
                    "Die Kraft, die bewirkt, dass die Moleküle an der Oberfläche einer Flüssigkeit zusammengedrückt werden und eine Schicht bilden."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :N ;
            owl:onProperty sio:SIO_000221 ],
            :VolumetricProperty .

:InterfacialTension a owl:Class ;
    rdfs:label "Interfacial Tension"@en, "Tension interfaciale"@fr, "Tensión interfacial"@es, "Grenzflächenspannung"@de ;
    skos:definition "Interfacial tension is the force that holds the surface of a particular phase together."@en,
                    "La tension interfaciale est la force qui maintient la surface d’une phase particulière ensemble."@fr,
                    "La tensión interfacial es la fuerza que mantiene unida la superficie de una fase particular."@es,
                    "Die Grenzflächenspannung ist die Kraft, die die Oberfläche einer bestimmten Phase zusammenhält."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :N ;
            owl:onProperty sio:SIO_000221 ],
            :VolumetricProperty .

:WaterAbsorption a owl:Class ;
    rdfs:label "Water Absorption"@en, "Absorption d’eau"@fr, "Absorción de agua"@es, "Wasseraufnahme"@de ;
    skos:definition "The amount of weight gain (%) experienced in a polymer after immersion in water for a specific length of time under controlled environment."@en,
                    "La quantité de gain de poids (%) subie par un polymère après immersion dans l’eau pendant une durée spécifique dans un environnement contrôlé."@fr,
                    "La cantidad de aumento de peso (%) que experimenta un polímero después de la inmersión en agua durante un tiempo específico en un entorno controlado."@es,
                    "Die Menge an Gewichtszunahme (%), die ein Polymer nach dem Eintauchen in Wasser für eine bestimmte Zeit unter kontrollierten Bedingungen erfährt."@de ;
    rdfs:subClassOf :VolumetricProperty .

:Spectroscopy a owl:Class ;
    rdfs:label "Spectroscopy"@en, "Spectroscopie"@fr, "Espectroscopia"@es, "Spektroskopie"@de ;
    skos:definition "The chemical composition, composition variation, crystal structure, and photo-electric properties of the materials."@en,
                    "La composition chimique, la variation de composition, la structure cristalline et les propriétés photoélectriques des matériaux."@fr,
                    "La composición química, la variación de composición, la estructura cristalina y las propiedades fotoeléctricas de los materiales."@es,
                    "Die chemische Zusammensetzung, die Variationszusammensetzung, die Kristallstruktur und die photoelektrischen Eigenschaften der Materialien."@de ;
    rdfs:subClassOf sio:SIO_000052 .

:Stress a owl:Class ;
    rdfs:label "Stress"@en, "Contrainte"@fr, "Esfuerzo"@es, "Spannung"@de ;
    skos:definition "When a material is loaded with a force, it produces a stress, which then causes a material to deform."@en,
                    "Lorsqu’un matériau est soumis à une force, il produit une contrainte, qui entraîne ensuite une déformation du matériau."@fr,
                    "Cuando un material se somete a una fuerza, produce un esfuerzo, que luego causa una deformación del material."@es,
                    "Wenn ein Material mit einer Kraft belastet wird, erzeugt es eine Spannung, die dann eine Verformung des Materials verursacht."@de ;
    rdfs:subClassOf :MechanicalProperty .

:Strain a owl:Class ;
    rdfs:label "Strain"@en, "Déformation"@fr, "Deformación"@es, "Dehnung"@de ;
    skos:definition "Engineering strain is defined as the amount of deformation in the direction of the applied force divided by the initial length of the material."@en,
                    "La déformation technique est définie comme la quantité de déformation dans la direction de la force appliquée divisée par la longueur initiale du matériau."@fr,
                    "La deformación técnica se define como la cantidad de deformación en la dirección de la fuerza aplicada dividida por la longitud inicial del material."@es,
                    "Die technische Dehnung ist definiert als die Menge der Verformung in Richtung der aufgebrachten Kraft, geteilt durch die ursprüngliche Länge des Materials."@de ;
    rdfs:subClassOf :MechanicalProperty .

:DMAMode a owl:Class ;
    rdfs:label "Dynamic Mechanical Analysis"@en, "Analyse mécanique dynamique"@fr, "Análisis mecánico dinámico"@es, "Dynamisch-mechanische Analyse"@de ;
    skos:definition "The type of condition (e.g., temperature sweep or frequency sweep) under which a material’s dynamic mechanical response is measured."@en,
                    "Le type de condition (par exemple, balayage de température ou balayage de fréquence) sous laquelle la réponse mécanique dynamique d’un matériau est mesurée."@fr,
                    "El tipo de condición (por ejemplo, barrido de temperatura o barrido de frecuencia) bajo la cual se mide la respuesta mecánica dinámica de un material."@es,
                    "Die Art der Bedingung (z. B. Temperaturdurchlauf oder Frequenzdurchlauf), unter der die dynamische mechanische Antwort eines Materials gemessen wird."@de ;
    rdfs:subClassOf :DynamicProperties, obo:ID_0000061 .

:TemperatureSweep a owl:Class ;
    rdfs:label "Temperature Sweep"@en, "Balayage de température"@fr, "Barrido de temperatura"@es, "Temperaturdurchlauf"@de ;
    skos:definition "A continuous variation of temperature within a pre-defined range."@en,
                    "Une variation continue de la température dans une plage prédéfinie."@fr,
                    "Una variación continua de la temperatura dentro de un rango predefinido."@es,
                    "Eine kontinuierliche Variation der Temperatur innerhalb eines vordefinierten Bereichs."@de ;
    rdfs:subClassOf :DMA_Mode .

:RheologicalProperty a owl:Class ;
    rdfs:label "Rheological Property"@en, "Propriété rhéologique"@fr, "Propiedad reológica"@es, "Rheologische Eigenschaft"@de ;
    skos:definition "A property related to the flow of a material."@en,
                    "Une propriété liée à l’écoulement d’un matériau."@fr,
                    "Una propiedad relacionada con el flujo de un material."@es,
                    "Eine Eigenschaft, die mit dem Fluss eines Materials zusammenhängt."@de ;
    rdfs:subClassOf sio:SIO_000052 .

:RheologicalComplexModulus a owl:Class ;
    rdfs:label "Rheological Complex Modulus"@en, "Module rhéologique complexe"@fr, "Módulo complejo reológico"@es, "Rheologischer Komplexmodul"@de ;
    skos:definition "The ratio of shear-stress amplitude to strain amplitude of a material under oscillating shear stress."@en,
                    "Le rapport de l’amplitude de la contrainte de cisaillement à l’amplitude de la déformation d’un matériau sous une contrainte de cisaillement oscillante."@fr,
                    "La relación de la amplitud de la tensión de cizallamiento a la amplitud de la deformación de un material bajo tensión de cizallamiento oscilante."@es,
                    "Das Verhältnis der Amplitude der Scherspannung zur Amplitude der Dehnung eines Materials unter oszillierender Scherspannung."@de ;
    rdfs:subClassOf :RheologicalProperty .

:RheometerMode a owl:Class ;
    rdfs:label "Rheometer Mode"@en, "Mode de rhéomètre"@fr, "Modo de reómetro"@es, "Rheometer-Modus"@de ;
    skos:definition "The type of condition (e.g., temperature sweep or frequency sweep) under which a material’s rheological response is measured."@en,
                    "Le type de condition (par exemple, balayage de température ou balayage de fréquence) sous laquelle la réponse rhéologique d’un matériau est mesurée."@fr,
                    "El tipo de condición (por ejemplo, barrido de temperatura o barrido de frecuencia) bajo la cual se mide la respuesta reológica de un material."@es,
                    "Die Art der Bedingung (z. B. Temperaturdurchlauf oder Frequenzdurchlauf), unter der die rheologische Antwort eines Materials gemessen wird."@de ;
    rdfs:subClassOf :RheologicalComplexModulus, :RheologicalViscosity .

:RheologicalStorageModulus a owl:Class ;
    rdfs:label "Rheological Storage Modulus"@en, "Module de stockage rhéologique"@fr, "Módulo de almacenamiento reológico"@es, "Rheologischer Speichermodul"@de ;
    skos:definition "The deformation energy stored within a material when subject to shear; the elastic component of the complex modulus."@en,
                    "L’énergie de déformation stockée dans un matériau lorsqu’il est soumis à un cisaillement ; la composante élastique du module complexe."@fr,
                    "La energía de deformación almacenada dentro de un material cuando se somete a cizallamiento; el componente elástico del módulo complejo."@es,
                    "Die Verformungsenergie, die in einem Material bei Scherkraft gespeichert wird; die elastische Komponente des komplexen Moduls."@de ;
    rdfs:subClassOf :RheologicalComplexModulus .

:RheologicalLossModulus a owl:Class ;
    rdfs:label "Rheological Loss Modulus"@en, "Module de perte rhéologique"@fr, "Módulo de pérdida reológica"@es, "Rheologischer Verlustmodul"@de ;
    skos:definition "The deformation energy dissipated within a material when subject to shear; the viscous component of the complex modulus."@en,
                    "L’énergie de déformation dissipée dans un matériau lorsqu’il est soumis à un cisaillement ; la composante visqueuse du module complexe."@fr,
                    "La energía de deformación disipada dentro de un material cuando se somete a cizallamiento; el componente viscoso del módulo complejo."@es,
                    "Die Verformungsenergie, die in einem Material bei Scherkraft dissipiert wird; die viskose Komponente des komplexen Moduls."@de ;
    rdfs:subClassOf :RheologicalComplexModulus .

:RheologicalLossTangent a owl:Class ;
    rdfs:label "Rheological Loss Tangent"@en, "Tangente de perte rhéologique"@fr, "Tangente de pérdida reológica"@es, "Rheologischer Verlustfaktor"@de ;
    skos:definition "The damping factor, or the ratio of storage to loss moduli; for ideally elastic materials, the damping factor is zero; for ideally viscous materials, the damping factor is infinite."@en,
                    "Le facteur d’amortissement, ou le rapport des modules de stockage et de perte ; pour les matériaux idéalement élastiques, le facteur d’amortissement est zéro ; pour les matériaux idéalement visqueux, le facteur d’amortissement est infini."@fr,
                    "El factor de amortiguamiento, o la relación entre los módulos de almacenamiento y de pérdida; para materiales idealmente elásticos, el factor de amortiguamiento es cero; para materiales idealmente viscosos, el factor de amortiguamiento es infinito."@es,
                    "Der Dämpfungsfaktor oder das Verhältnis von Speicher- zu Verlustmodul; für ideal elastische Materialien ist der Dämpfungsfaktor null; für ideal viskose Materialien ist der Dämpfungsfaktor unendlich."@de ;
    rdfs:subClassOf :RheologicalComplexModulus .

:RheologicalMasterCurve a owl:Class ;
    rdfs:label "Rheological Master Curve"@en, "Courbe maîtresse rhéologique"@fr, "Curva maestra reológica"@es, "Rheologische Masterkurve"@de ;
    skos:definition "The superposition of rheological data taken at different temperatures in a given frequency range, where the curves are horizontally shifted to form a continuous master curve spanning a much larger frequency range that would otherwise be experimentally intractable or infeasible."@en,
                    "La superposition de données rhéologiques prises à différentes températures dans une plage de fréquences donnée, où les courbes sont décalées horizontalement pour former une courbe maîtresse continue couvrant une plage de fréquences beaucoup plus large qui serait autrement expérimentalement intraitable ou irréalisable."@fr,
                    "La superposición de datos reológicos tomados a diferentes temperaturas en un rango de frecuencias dado, donde las curvas se desplazan horizontalmente para formar una curva maestra continua que abarca un rango de frecuencias mucho mayor que de otro modo sería experimentalmente intratable o inviable."@es,
                    "Die Überlagerung von rheologischen Daten, die bei unterschiedlichen Temperaturen in einem gegebenen Frequenzbereich aufgenommen wurden, wobei die Kurven horizontal verschoben werden, um eine kontinuierliche Masterkurve zu bilden, die einen viel größeren Frequenzbereich abdeckt, der sonst experimentell schwer handhabbar oder nicht durchführbar wäre."@de ;
    rdfs:subClassOf :RheologicalComplexModulus .

:RheologicalViscosity a owl:Class ;
    rdfs:label "Rheological Viscosity"@en, "Viscosité rhéologique"@fr, "Viscosidad reológica"@es, "Rheologische Viskosität"@de ;
    skos:definition "The resistance of a fluid to flow."@en,
                    "La résistance d’un fluide à l’écoulement."@fr,
                    "La resistencia de un fluido al flujo."@es,
                    "Der Widerstand eines Fluids gegen das Fließen."@de ;
    rdfs:subClassOf :RheologicalProperty .

:DynamicViscosity a owl:Class ;
    rdfs:label "Dynamic Viscosity"@en, "Viscosité dynamique"@fr, "Viscosidad dinámica"@es, "Dynamische Viskosität"@de ;
    skos:definition "A measure of a fluid’s resistance to flow."@en,
                    "Une mesure de la résistance d’un fluide à l’écoulement."@fr,
                    "Una medida de la resistencia de un fluido al flujo."@es,
                    "Ein Maß für den Widerstand eines Fluids gegen das Fließen."@de ;
    rdfs:subClassOf :RheologicalViscosity .

:MeltViscosity a owl:Class ;
    rdfs:label "Melt Viscosity"@en, "Viscosité de fusion"@fr, "Viscosidad de fusión"@es, "Schmelzviskosität"@de ;
    skos:definition "The viscosity of a polymer in its melt (liquid) state."@en,
                    "La viscosité d’un polymère à l’état de fusion (liquide)."@fr,
                    "La viscosidad de un polímero en su estado de fusión (líquido)."@es,
                    "Die Viskosität eines Polymers im geschmolzenen (flüssigen) Zustand."@de ;
    rdfs:subClassOf :RheologicalViscosity .

:WeibullPlot a owl:Class ;
    rdfs:label "Weibull Plot"@en, "Diagramme de Weibull"@fr, "Gráfico de Weibull"@es, "Weibull-Diagramm"@de ;
    skos:definition "A plot of failure probability versus electric field, typically with the probability y-axis scaled according to the Weibull distribution as ln(-ln(1-p))."@en,
                    "Un graphique de la probabilité d’échec par rapport au champ électrique, généralement avec l’axe des ordonnées de probabilité mis à l’échelle selon la distribution de Weibull comme ln(-ln(1-p))."@fr,
                    "Un gráfico de la probabilidad de falla frente al campo eléctrico, típicamente con el eje y de probabilidad escalado según la distribución de Weibull como ln(-ln(1-p))."@es,
                    "Ein Diagramm der Ausfallwahrscheinlichkeit gegenüber dem elektrischen Feld, typischerweise mit der Wahrscheinlichkeits-y-Achse skaliert nach der Weibull-Verteilung als ln(-ln(1-p))."@de ;
    rdfs:subClassOf :DielectricBreakdownStrength .

:BreakdownStrength a owl:Class ;
    rdfs:label "Breakdown Strength"@en, "Résistance à la rupture"@fr, "Resistencia a la rotura"@es, "Durchbruchsstärke"@de ;
    skos:definition "The electric field at which the probability of failure is ln(-ln(1-p)) = 0, or approximately p = 0.632."@en,
                    "Le champ électrique auquel la probabilité d’échec est ln(-ln(1-p)) = 0, ou approximativement p = 0,632."@fr,
                    "El campo eléctrico en el que la probabilidad de falla es ln(-ln(1-p)) = 0, o aproximadamente p = 0,632."@es,
                    "Das elektrische Feld, bei dem die Ausfallwahrscheinlichkeit ln(-ln(1-p)) = 0 ist, oder ungefähr p = 0,632."@de ;
    rdfs:subClassOf :ElectricalProperty .

:ProbabilityOfFailure a owl:Class ;
    rdfs:label "Probability of Failure"@en, "Probabilité d’échec"@fr, "Probabilidad de falla"@es, "Ausfallwahrscheinlichkeit"@de ;
    skos:definition "As the electric field is intensified, the probability of failure is the likelihood that a breakdown channel forms across the test specimen."@en,
                    "À mesure que le champ électrique s’intensifie, la probabilité d’échec est la probabilité qu’un canal de rupture se forme à travers l’échantillon testé."@fr,
                    "A medida que se intensifica el campo eléctrico, la probabilidad de falla es la probabilidad de que se forme un canal de ruptura a través del espécimen de prueba."@es,
                    "Mit zunehmender Intensität des elektrischen Feldes ist die Ausfallwahrscheinlichkeit die Wahrscheinlichkeit, dass ein Durchbruchkanal durch die Testprobe entsteht."@de ;
    rdfs:subClassOf :ElectricalProperty .

:TensileStrength a owl:Class ;
    rdfs:label "Tensile Strength"@en, "Résistance à la traction"@fr, "Resistencia a la tracción"@es, "Zugfestigkeit"@de ;
    skos:definition "The maximum engineering stress experienced by a test specimen during a tensile test, at which point the material begins to fail catastrophically."@en,
                    "La contrainte technique maximale subie par un échantillon testé lors d’un essai de traction, au point où le matériau commence à échouer de manière catastrophique."@fr,
                    "El esfuerzo técnico máximo experimentado por un espécimen de prueba durante un ensayo de tracción, en el punto en que el material comienza a fallar catastróficamente."@es,
                    "Die maximale technische Spannung, die eine Testprobe während eines Zugtests erfährt, an dem Punkt, an dem das Material katastrophal zu versagen beginnt."@de ;
    rdfs:subClassOf :TensileProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/megapascal> .

:StressRelaxation a owl:Class ;
    rdfs:label "Stress Relaxation"@en, "Relaxation des contraintes"@fr, "Relajación del esfuerzo"@es, "Spannungsrelaxation"@de ;
    skos:definition "Stress relaxation, which occurs when a viscoelastic test specimen is brought to a fixed strain and held, is the gradual release of internal stress due to the viscous nature of the test specimen."@en,
                    "La relaxation des contraintes, qui se produit lorsqu’un échantillon viscoélastique est soumis à une déformation fixe et maintenu, est la libération progressive de la contrainte interne due à la nature visqueuse de l’échantillon."@fr,
                    "La relajación del esfuerzo, que ocurre cuando un espécimen de prueba viscoelástico se lleva a una deformación fija y se mantiene, es la liberación gradual del esfuerzo interno debido a la naturaleza viscosa del espécimen."@es,
                    "Die Spannungsrelaxation, die auftritt, wenn eine viskoelastische Testprobe auf eine feste Dehnung gebracht und gehalten wird, ist die allmähliche Freisetzung interner Spannungen aufgrund der viskosen Natur der Testprobe."@de ;
    rdfs:subClassOf sio:SIO_001365 .

:StrainAtBreak a owl:Class ;
    rdfs:label "Strain at Break"@en, "Déformation à la rupture"@fr, "Deformación al romperse"@es, "Bruchdehnung"@de ;
    skos:definition "The strain at which the material fractures (e.g., during a tensile test)."@en,
                    "La déformation à laquelle le matériau se fracture (par exemple, lors d’un essai de traction)."@fr,
                    "La deformación en la que el material se fractura (por ejemplo, durante un ensayo de tracción)."@es,
                    "Die Dehnung, bei der das Material bricht (z. B. während eines Zugtests)."@de ;
    rdfs:subClassOf :Strain .

:PreCrackingProcess a owl:Class ;
    rdfs:label "PreCracking Process"@en, "Processus de pré-fissuration"@fr, "Proceso de pre-ruptura"@es, "Vor-Rissbildungsprozess"@de ;
    skos:definition "The process of establishing an initiator crack or groove in a test specimen such that the failure of the test specimen deterministically begins at the established location."@en,
                    "Le processus d’établissement d’une fissure ou d’une rainure initiatrice dans un échantillon testé de manière à ce que la rupture de l’échantillon commence de manière déterministe à l’emplacement établi."@fr,
                    "El proceso de establecer una grieta o ranura iniciadora en un espécimen de prueba de manera que la falla del espécimen comience determinísticamente en la ubicación establecida."@es,
                    "Der Prozess des Herstellens eines Initiatorrisses oder einer Rille in einer Testprobe, sodass der Ausfall der Testprobe deterministisch an der festgelegten Stelle beginnt."@de ;
    rdfs:subClassOf sio:SIO_000999 .

:FractureEnergy a owl:Class ;
    rdfs:label "Fracture Energy"@en, "Énergie de fracture"@fr, "Energía de fractura"@es, "Bruchenergie"@de ;
    skos:definition "The energy required to create a new surface in the material, measured by the energy absorbed by the material during fracture."@en,
                    "L’énergie nécessaire pour créer une nouvelle surface dans le matériau, mesurée par l’énergie absorbée par le matériau pendant la fracture."@fr,
                    "La energía necesaria para crear una nueva superficie en el material, medida por la energía absorbida por el material durante la fractura."@es,
                    "Die Energie, die benötigt wird, um eine neue Oberfläche im Material zu erzeugen, gemessen durch die Energie, die das Material während des Bruchs absorbiert."@de ;
    rdfs:subClassOf :MechanicalProperty .

:KFactor a owl:Class ;
    rdfs:label "K Factor"@en, "Facteur K"@fr, "Factor K"@es, "K-Faktor"@de ;
    skos:definition "In fracture mechanics, the Stress Intensity Factor, K, describes the stress state at the tip of a crack in a material."@en,
                    "En mécanique de la fracture, le facteur d’intensité de contrainte, K, décrit l’état de contrainte à la pointe d’une fissure dans un matériau."@fr,
                    "En mecánica de fractura, el factor de intensidad de esfuerzo, K, describe el estado de esfuerzo en la punta de una grieta en un material."@es,
                    "In der Bruchmechanik beschreibt der Spannungsintensitätsfaktor K den Spannungszustand an der Spitze eines Risses in einem Material."@de ;
    rdfs:subClassOf sio:SIO_001018 .

:JIntegral a owl:Class ;
    rdfs:label "J Integral"@en, "Intégrale J"@fr, "Integral J"@es, "J-Integral"@de ;
    skos:definition "In fracture mechanics, the J-integral represents the energy required to advance a crack in a material (related to the fracture toughness)."@en,
                    "En mécanique de la fracture, l’intégrale J représente l’énergie nécessaire pour faire progresser une fissure dans un matériau (liée à la ténacité à la fracture)."@fr,
                    "En mecánica de fractura, la integral J representa la energía necesaria para avanzar una grieta en un material (relacionada con la tenacidad a la fractura)."@es,
                    "In der Bruchmechanik repräsentiert das J-Integral die Energie, die benötigt wird, um einen Riss in einem Material voranzutreiben (im Zusammenhang mit der Bruchzähigkeit)."@de ;
    rdfs:subClassOf sio:SIO_000368 .

:MeasurementMethod a owl:Class ;
    rdfs:label "Measurement Method"@en, "Méthode de mesure"@fr, "Método de medición"@es, "Messmethode"@de ;
    skos:definition "A method or process used to obtain a measure of some property."@en,
                    "Une méthode ou un processus utilisé pour obtenir une mesure d’une propriété."@fr,
                    "Un método o proceso utilizado para obtener una medida de una propiedad."@es,
                    "Eine Methode oder ein Prozess, der verwendet wird, um eine Messung einer Eigenschaft zu erhalten."@de ;
    rdfs:subClassOf sio:SIO_001054 .

:FrequencySweep a owl:Class ;
    rdfs:label "Frequency Sweep"@en, "Balayage de fréquence"@fr, "Barrido de frecuencia"@es, "Frequenzdurchlauf"@de ;
    skos:definition "A continuous variation of frequency within a pre-defined range to measure a material’s response."@en,
                    "Une variation continue de la fréquence dans une plage prédéfinie pour mesurer la réponse d’un matériau."@fr,
                    "Una variación continua de la frecuencia dentro de un rango predefinido para medir la respuesta de un material."@es,
                    "Eine kontinuierliche Variation der Frequenz innerhalb eines vordefinierten Bereichs, um die Reaktion eines Materials zu messen."@de ;
    rdfs:subClassOf :MeasurementMethod .

:StrainSweep a owl:Class ;
    rdfs:label "Strain Sweep"@en, "Balayage de déformation"@fr, "Barrido de deformación"@es, "Dehnungsdurchlauf"@de ;
    skos:definition "A continuous variation of strain (amplitude) within a pre-defined range."@en,
                    "Une variation continue de la déformation (amplitude) dans une plage prédéfinie."@fr,
                    "Una variación continua de la deformación (amplitud) dentro de un rango predefinido."@es,
                    "Eine kontinuierliche Variation der Dehnung (Amplitude) innerhalb eines vordefinierten Bereichs."@de ;
    rdfs:subClassOf :MeasurementMethod .

:DynamicPropertyProfile a owl:Class ;
    rdfs:label "Dynamic Property Profile"@en, "Profil de propriété dynamique"@fr, "Perfil de propiedad dinámica"@es, "Dynamisches Eigenschaftsprofil"@de ;
    skos:definition "A profile describing a dynamic property measurement (e.g., in dynamic mechanical analysis)."@en,
                    "Un profil décrivant une mesure de propriété dynamique (par exemple, dans l’analyse mécanique dynamique)."@fr,
                    "Un perfil que describe una medición de propiedad dinámica (por ejemplo, en el análisis mecánico dinámico)."@es,
                    "Ein Profil, das eine Messung dynamischer Eigenschaften beschreibt (z. B. in der dynamisch-mechanischen Analyse)."@de ;
    rdfs:subClassOf :Profile .

:MasterCurve a owl:Class ;
    rdfs:label "Master Curve"@en, "Courbe maîtresse"@fr, "Curva maestra"@es, "Masterkurve"@de ;
    skos:definition "See Rheological Master Curve."@en,
                    "Voir Courbe maîtresse rhéologique."@fr,
                    "Ver Curva maestra reológica."@es,
                    "Siehe Rheologische Masterkurve."@de ;
    rdfs:subClassOf sio:SIO_000608 .

:Profile a owl:Class ;
    rdfs:label "Profile"@en, "Profil"@fr, "Perfil"@es, "Profil"@de ;
    skos:definition "A data series."@en,
                    "Une série de données."@fr,
                    "Una serie de datos."@es,
                    "Eine Datenserie."@de ;
    rdfs:subClassOf sio:SIO_000464 .

:SampleShape a owl:Class ;
    rdfs:label "Sample Shape"@en, "Forme d’échantillon"@fr, "Forma de muestra"@es, "Probenform"@de ;
    skos:definition "The geometric form of a test specimen."@en,
                    "La forme géométrique d’un échantillon testé."@fr,
                    "La forma geométrica de un espécimen de prueba."@es,
                    "Die geometrische Form einer Testprobe."@de ;
    rdfs:subClassOf sio:SIO_000055 .

:ResonanceFrequency a owl:Class ;
    rdfs:label "Resonance Frequency"@en, "Fréquence de résonance"@fr, "Frecuencia de resonancia"@es, "Resonanzfrequenz"@de ;
    skos:definition "When an oscillating force is applied at a resonant frequency of a dynamic system, the system will oscillate at a higher amplitude than when the same force is applied at other, non-resonant frequencies."@en,
                    "Lorsqu’une force oscillante est appliquée à la fréquence de résonance d’un système dynamique, le système oscillera à une amplitude plus élevée que lorsque la même force est appliquée à d’autres fréquences non résonantes."@fr,
                    "Cuando una fuerza oscilante se aplica a la frecuencia de resonancia de un sistema dinámico, el sistema oscilará a una amplitud mayor que cuando se aplica la misma fuerza en otras frecuencias no resonantes."@es,
                    "Wenn eine oszillierende Kraft mit der Resonanzfrequenz eines dynamischen Systems angewendet wird, wird das System mit einer höheren Amplitude schwingen als bei Anwendung derselben Kraft bei anderen, nicht-resonanten Frequenzen."@de ;
    rdfs:subClassOf sio:SIO_001367 ;
    prov:wasQuotedFrom <https://en.wikipedia.org/wiki/Resonance> .

:StrainAmplitude a owl:Class ;
    rdfs:label "Strain Amplitude"@en, "Amplitude de déformation"@fr, "Amplitud de deformación"@es, "Dehnungsamplitude"@de ;
    skos:definition "The maximum magnitude of forced displacement under oscillatory loading conditions."@en,
                    "La magnitude maximale du déplacement forcé sous des conditions de chargement oscillatoire."@fr,
                    "La magnitud máxima del desplazamiento forzado bajo condiciones de carga oscilatoria."@es,
                    "Die maximale Größe der erzwungenen Verschiebung unter oszillierenden Belastungsbedingungen."@de ;
    rdfs:subClassOf :Condition .

:Condition a owl:Class ;
    rdfs:label "Condition"@en, "Condition"@fr, "Condición"@es, "Bedingung"@de ;
    skos:definition "A state or circumstance under which a material is tested or processed."@en,
                    "Un état ou une circonstance sous laquelle un matériau est testé ou traité."@fr,
                    "Un estado o circunstancia bajo la cual se prueba o procesa un material."@es,
                    "Ein Zustand oder eine Bedingung, unter der ein Material getestet oder verarbeitet wird."@de ;
    rdfs:subClassOf :CompressionProperty .

:StrainRate a owl:Class ;
    rdfs:label "Strain Rate"@en, "Taux de déformation"@fr, "Tasa de deformación"@es, "Dehnungsrate"@de ;
    skos:definition "The rate at which a material deforms under an applied force."@en,
                    "Le taux auquel un matériau se déforme sous une force appliquée."@fr,
                    "La tasa a la que un material se deforma bajo una fuerza aplicada."@es,
                    "Die Rate, mit der ein Material unter einer aufgebrachten Kraft verformt wird."@de ;
    rdfs:subClassOf :Condition ;
    :hasPreferredUnit <http://materialsmine.org/ns/unit/1-s> .

:WeibullParameter a owl:Class ;
    rdfs:label "Weibull Parameter"@en, "Paramètre de Weibull"@fr, "Parámetro de Weibull"@es, "Weibull-Parameter"@de ;
    rdfs:subClassOf :ElectricalProperty .

:PhysicalProperty a owl:Class ;
    rdfs:label "Physical Property"@en, "Propriété physique"@fr, "Propiedad física"@es, "Physikalische Eigenschaft"@de ;
    skos:definition "Physical properties are characteristics of a substance that can be observed or measured without changing the chemical composition of the substance."@en,
                    "Les propriétés physiques sont des caractéristiques d’une substance qui peuvent être observées ou mesurées sans modifier la composition chimique de la substance."@fr,
                    "Las propiedades físicas son características de una sustancia que pueden observarse o medirse sin cambiar la composición química de la sustancia."@es,
                    "Physikalische Eigenschaften sind Merkmale einer Substanz, die beobachtet oder gemessen werden können, ohne die chemische Zusammensetzung der Substanz zu verändern."@de ;
    rdfs:subClassOf sio:SIO_000052 .

:WorkOfAdhesion a owl:Class ;
    rdfs:label "Work of Adhesion"@en, "Travail d’adhésion"@fr, "Trabajo de adhesión"@es, "Arbeit der Adhäsion"@de ;
    skos:definition "The work required to separate two surfaces or phases that are adhered."@en,
                    "Le travail requis pour séparer deux surfaces ou phases qui sont adhérées."@fr,
                    "El trabajo requerido para separar dos superficies o fases que están adheridas."@es,
                    "Die Arbeit, die benötigt wird, um zwei Oberflächen oder Phasen zu trennen, die aneinander haften."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :j-m-2 ;
            owl:onProperty sio:SIO_000221 ],
            :PhysicalProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerSquareMetre> .

:WorkOfSpreading a owl:Class ;
    rdfs:label "Work of Spreading"@en, "Travail d’étalement"@fr, "Trabajo de esparcimiento"@es, "Arbeit des Ausbreitens"@de ;
    skos:definition "The energy required to spread a liquid over a surface."@en,
                    "L’énergie nécessaire pour étaler un liquide sur une surface."@fr,
                    "La energía requerida para esparcir un líquido sobre una superficie."@es,
                    "Die Energie, die benötigt wird, um eine Flüssigkeit über eine Oberfläche zu verteilen."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :j-m-2 ;
            owl:onProperty sio:SIO_000221 ],
            :PhysicalProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerSquareMetre> .

:WettingAngle a owl:Class ;
    rdfs:label "Wetting Angle"@en, "Angle de mouillage"@fr, "Ángulo de mojado"@es, "Benetzungswinkel"@de ;
    skos:definition "The angle formed between a liquid droplet and a solid surface. It is a measure of the thermodynamic compatibility between the liquid and the solid, and is influenced by factors such as surface energy and surface tension."@en,
                    "L’angle formé entre une gouttelette de liquide et une surface solide. C’est une mesure de la compatibilité thermodynamique entre le liquide et le solide, influencée par des facteurs tels que l’énergie de surface et la tension de surface."@fr,
                    "El ángulo formado entre una gota de líquido y una superficie sólida. Es una medida de la compatibilidad termodinámica entre el líquido y el sólido, y está influenciado por factores como la energía superficial y la tensión superficial."@es,
                    "Der Winkel, der zwischen einem Flüssigkeitstropfen und einer festen Oberfläche gebildet wird. Es ist ein Maß für die thermodynamische Kompatibilität zwischen der Flüssigkeit und dem Feststoff und wird durch Faktoren wie Oberflächenenergie und Oberflächenspannung beeinflusst."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :degrees ;
            owl:onProperty sio:SIO_000221 ],
            :PhysicalProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/degree> .

:DegreeOfWetting a owl:Class ;
    rdfs:label "Degree of Wetting"@en, "Degré de mouillage"@fr, "Grado de mojado"@es, "Benetzungsgrad"@de ;
    skos:definition "Cosine of the wetting angle."@en,
                    "Cosinus de l’angle de mouillage."@fr,
                    "Coseno del ángulo de mojado."@es,
                    "Kosinus des Benetzungswinkels."@de ;
    rdfs:subClassOf :WettingAngle ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/Ratio> .

:SurfaceEnergy a owl:Class ;
    rdfs:label "Surface Energy"@en, "Énergie de surface"@fr, "Energía superficial"@es, "Oberflächenenergie"@de ;
    skos:definition "Interaction strength of two phases at a phase interface."@en,
                    "Force d’interaction de deux phases à une interface de phase."@fr,
                    "Fuerza de interacción de dos fases en una interfaz de fase."@es,
                    "Interaktionsstärke von zwei Phasen an einer Phasengrenze."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :j-m-2 ;
            owl:onProperty sio:SIO_000221 ],
            :PhysicalProperty ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerSquareMetre> .

:DispersiveSurfaceEnergy a owl:Class ;
    rdfs:label "Dispersive Surface Energy"@en, "Énergie de surface dispersive"@fr, "Energía superficial dispersiva"@es, "Dispersive Oberflächenenergie"@de ;
    skos:definition "Interaction strength at a phase interface caused by dispersion forces."@en,
                    "Force d’interaction à une interface de phase causée par des forces de dispersion."@fr,
                    "Fuerza de interacción en una interfaz de fase causada por fuerzas de dispersión."@es,
                    "Interaktionsstärke an einer Phasengrenze, die durch Dispersionskräfte verursacht wird."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :j-m-2 ;
            owl:onProperty sio:SIO_000221 ],
            :SurfaceEnergy ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerSquareMetre> .

:PolarSurfaceEnergy a owl:Class ;
    rdfs:label "Polar Surface Energy"@en, "Énergie de surface polaire"@fr, "Energía de superficie polar"@es, "Polare Oberflächenenergie"@de ;
    skos:definition "Interaction strength at a phase interface caused by polar forces."@en,
                    "Force d’interaction à une interface de phase causée par des forces polaires."@fr,
                    "Fuerza de interacción en una interfaz de fase causada por fuerzas polares."@es,
                    "Interaktionsstärke an einer Phasengrenze, die durch polare Kräfte verursacht wird."@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :j-m-2 ;
            owl:onProperty sio:SIO_000221 ],
            :SurfaceEnergy ;
    :hasPreferredUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/joulePerSquareMetre> .

:AlternatingCurrent a owl:Class ;
    rdfs:label "Alternating Current"@en, "Courant alternatif"@fr, "Corriente alterna"@es, "Wechselstrom"@de ;
    rdfs:subClassOf :ElectricalProperty .

:DirectCurrent a owl:Class ;
    rdfs:label "Direct Current"@en, "Courant continu"@fr, "Corriente continua"@es, "Gleichstrom"@de ;
    rdfs:subClassOf :ElectricalProperty .

:VolumetricShrinkage a owl:Class ;
    rdfs:label "Volumetric Shrinkage"@en, "Retrait volumétrique"@fr, "Contracción volumétrica"@es, "Volumetrische Schrumpfung"@de ;
    skos:definition "The amount of reduction by volume (%) experienced in a thermoset due to crosslinking between the monomer(s) and curing agent(s)."@en,
                    "La quantité de réduction en volume (%) subie par un thermodurcissable en raison de la réticulation entre le(s) monomère(s) et le(s) agent(s) de durcissement."@fr,
                    "La cantidad de reducción en volumen (%) experimentada en un termoestable debido a la reticulación entre el(los) monómero(s) y el(los) agente(s) de curado."@es,
                    "Die Menge der Volumenreduktion (%), die in einem Duroplasten aufgrund der Vernetzung zwischen dem(n) Monomer(en) und dem(n) Härtungsmittel(n) auftritt."@de ;
    rdfs:subClassOf :VolumetricProperty .



#Unit of Measure
:nm a :Units ;
