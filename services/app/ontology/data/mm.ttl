    rdfs:subClassOf sio:SIO_000144 .

:XRay_Photoelectron_Spectroscopy a owl:Class ;
    rdfs:label "X-Ray Photoelectron Spectroscopy"@en, "Espectroscopía de Fotoelectrones por Rayos X"@es, "Röntgen-Photoelektronenspektroskopie"@de, "Spectroscopie de Photoélectrons X"@fr ;
    rdfs:subClassOf sio:SIO_001054 ;
    skos:definition "X-Ray Photoelectron Spectroscopy (abbr. XPS) is a spectroscopy for material characterization;"@en, "La spectroscopie de photoélectrons X (abrégée XPS) est une technique de spectroscopie utilisée pour la caractérisation des matériaux;"@fr, "Die Röntgen-Photoelektronenspektroskopie (kurz XPS) ist eine Spektroskopietechnik zur Materialcharakterisierung;"@de, "La espectroscopía de fotoelectrones por rayos X (abreviada XPS) es una técnica de espectroscopía para la caracterización de materiales;"@es .

