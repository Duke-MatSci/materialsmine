    rdfs:subClassOf :SoftwareExecution .

:Isotropic a owl:Class ;
    rdfs:label "Isotropic"@en, "Isotrópico"@es, "Isotrop"@de, "Isotrope"@fr ;
    rdfs:subClassOf :Orientation .

:Anisotropic a owl:Class ;
    rdfs:label "Anisotropic"@en, "Anisotrópico"@es, "Anisotrop"@de, "Anisotrope"@fr ;
    rdfs:subClassOf :Orientation .

:CelluloseNanofibers a owl:Class ;
    rdfs:label "Cellulose nanofibers"@en, "Nanofibrillas de celulosa"@es, "Cellulose-Nanofasern"@de, "Nanofibres de cellulose"@fr ;
    rdfs:subClassOf sio:SIO_010046 ;
    skos:definition "Made from wood-derived fiber (pulp) that has been defibrated to the nano level of several hundredths of a micron and smaller, cellulose nanofiber is the world's most advanced biomass material."@en,
        "Fabriquée à partir de fibres dérivées du bois (pâte) défibrées à l’échelle nanométrique, jusqu’à quelques centièmes de micron, la nanofibre de cellulose est le matériau de biomasse le plus avancé au monde."@fr,
        "Hergestellt aus holzbasierten Fasern (Zellstoff), die auf Nanoebene bis auf wenige Hundertstel Mikrometer defibrilliert wurden, ist Zellulose-Nanofaser das fortschrittlichste Biomassematerial der Welt."@de,
        "Hecha a partir de fibras derivadas de la madera (pulpa) que han sido desfibradas a nivel nano de unas pocas centésimas de micrón o menos, la nanofibra de celulosa es el material de biomasa más avanzado del mundo."@es ;
    prov:wasQuotedFrom "https://www.nipponpapergroup.com/english/research/organize/cnf.html" .

:BovineSerumAlbumen a owl:Class ;
    rdfs:label "Bovine Serum Albumen"@en, "Albúmina de suero bovino"@es, "Rinderserumalbumin"@de, "Albumine sérique bovine"@fr ;
    rdfs:subClassOf sio:SIO_010043 ;
    skos:definition """Bovine Serum Albumin, also known as "BSA" or "Fraction V", is a protein derived from bovine blood plasma."""@en,
        """L'albumine sérique bovine, également connue sous le nom de "BSA" ou "Fraction V", est une protéine dérivée du plasma sanguin bovin."""@fr,
        """Rinderserumalbumin, auch bekannt als "BSA" oder "Fraktion V", ist ein Protein, das aus dem Blutplasma von Rindern gewonnen wird."""@de,
        """La albúmina sérica bovina, también conocida como "BSA" o "Fracción V", es una proteína derivada del plasma sanguíneo bovino."""@es ;
    prov:wasQuotedFrom "https://www.capricorn-scientific.com/BSA" .

:StearicAcid a owl:Class ;
    rdfs:label "Stearic Acid"@en, "Ácido esteárico"@es, "Stearinsäure"@de, "Acide stéarique"@fr ;
    rdfs:subClassOf sio:SIO_010011 ;
    skos:altLabel "Octadecanoic Acid" ;
    skos:definition "Stearic acid (IUPAC systematic name: octadecanoic acid) is one of the useful types of saturated fatty acids that comes from many animal and vegetable fats and oils. It is a waxy solid."@en,
        "Acide stéarique (nom systématique UICPA : acide octadécanoïque) est un type utile d'acide gras saturé provenant de nombreuses graisses et huiles animales et végétales. C'est un solide cireux."@fr,
        "Stearinsäure (IUPAC-Name: Octadecansäure) ist eine nützliche Art gesättigter Fettsäuren, die aus vielen tierischen und pflanzlichen Fetten und Ölen stammt. Sie ist ein wachsfester Stoff."@de,
        "Ácido esteárico (nombre sistemático de la IUPAC: ácido octadecanoico) es un tipo útil de ácido graso saturado que proviene de muchas grasas y aceites animales y vegetales. Es un sólido ceroso."@es ;
    prov:wasQuotedFrom "https://www.drugbank.ca/drugs/DB03193" .

:OleicAcid a owl:Class ;
    rdfs:label "Oleic Acid"@en, "Ácido oleico"@es, "Ölsäure"@de, "Acide oléique"@fr ;
    rdfs:subClassOf sio:SIO_010011 ;
    skos:definition"An octadec-9-enoic acid in which the double bond at C-9 has Z (cis) stereochemistry"@en,
        "Un acide octadéc-9-énoïque dont la double liaison en C-9 présente une stéréochimie Z (cis)"@fr,
        "Eine Octadec-9-ensäure, bei der die Doppelbindung an C-9 eine Z-(cis)-Stereochemie aufweist"@de,
        "Un ácido octadec-9-enoico en el que el doble enlace en C-9 tiene una estereoquímica Z (cis)"@es ;
    prov:wasQuotedFrom "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:16196" .

:LinoleicAcid a owl:Class ;
    rdfs:label "Linoleic Acid"@en, "Ácido linoleico"@es, "Linolsäure"@de, "Acide linoléique"@fr ;
    rdfs:subClassOf sio:SIO_010011 ;
    skos:Definition "An octadecadienoic acid in which the two double bonds are at positions 9 and 12 and have Z (cis) stereochemistry."@en,
        "Un ácido octadecadienoico en el que los dos dobles enlaces están en las posiciones 9 y 12 y tienen estereoquímica Z (cis)."@es,
        "Eine Octadecadien-Säure, bei der sich die zwei Doppelbindungen an den Positionen 9 und 12 befinden und die Z-(cis)-Stereochemie aufweisen."@de,
        "Un acide octadécadiénoïque dans lequel les deux doubles liaisons sont aux positions 9 et 12 et ont une stéréochimie Z (cis)."@fr ;
     prov:wasQuotedFrom "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17351" .

:Sorbitol a owl:Class ;
    rdfs:label "Sorbitol"@en, "Sorbitol"@es, "Sorbit"@de, "Sorbitol"@fr ;
    rdfs:subClassOf sio:SIO_010072 ;
    skos:definition "A polyhydric alcohol with about half the sweetness of sucrose. Sorbitol occurs naturally and is also produced synthetically from glucose. It was formerly used as a diuretic and may still be used as a laxative and in irrigating solutions for some surgical procedures."@en,
        "Un alcool polyhydrique avec environ la moitié de la douceur du saccharose. Le sorbitol se trouve naturellement et est également produit synthétiquement à partir du glucose. Il était autrefois utilisé comme diurétique et peut encore être utilisé comme laxatif et dans les solutions d'irrigation pour certaines interventions chirurgicales."@fr,
        "Ein mehrwertiger Alkohol mit etwa der Hälfte der Süße von Saccharose. Sorbit kommt natürlich vor und wird auch synthetisch aus Glukose hergestellt. Früher wurde es als Diuretikum verwendet und kann noch als Abführmittel und in Spüllösungen bei einigen chirurgischen Eingriffen eingesetzt werden."@de,
        "Un alcohol polihídrico con aproximadamente la mitad de la dulzura de la sacarosa. El sorbitol se encuentra naturalmente y también se produce sintéticamente a partir de glucosa. Anteriormente se usaba como diurético y todavía puede usarse como laxante y en soluciones de irrigación para algunos procedimientos quirúrgicos."@es ;
    prov:wasQuotedFrom "https://www.drugbank.ca/drugs/DB01638" .

:Glycerol a owl:Class ;
    rdfs:label "Glycerol"@en, "Glicerol"@es, "Glycerin"@de, "Glycérol"@fr ;
    rdfs:subClassOf sio:SIO_010072 ;
    skos:definition "Glycerol is a triol with a structure of propane substituted at positions 1, 2 and 3 by hydroxy groups. It has a role as an osmolyte, a solvent, a detergent, a human metabolite, an algal metabolite, a Saccharomyces cerevisiae metabolite, an Escherichia coli metabolite, a mouse metabolite and a geroprotector. It is an alditol and a triol."@en,
        "Le glycérol est un triol avec une structure de propane substituée en positions 1, 2 et 3 par des groupes hydroxy. Il joue un rôle d’osmolyte, de solvant, de détergent, de métabolite humain, de métabolite algal, de métabolite de Saccharomyces cerevisiae, de métabolite d’Escherichia coli, de métabolite de souris et de géroprotecteur. C’est un alditol et un triol."@fr,
        "Glycerol ist ein Triol mit einer Propanstruktur, die an den Positionen 1, 2 und 3 durch Hydroxygruppen substituiert ist. Es fungiert als Osmolyt, Lösungsmittel, Detergens, menschlicher Metabolit, Algenmetabolit, Saccharomyces cerevisiae-Metabolit, Escherichia coli-Metabolit, Mausmetabolit und Geroprotektor. Es ist ein Alditol und ein Triol."@de,
        "El glicerol es un triol con una estructura de propano sustituida en las posiciones 1, 2 y 3 por grupos hidroxilo. Tiene un papel como osmólito, solvente, detergente, metabolito humano, metabolito de algas, metabolito de Saccharomyces cerevisiae, metabolito de Escherichia coli, metabolito de ratón y geroprotector. Es un alditol y un triol."@es ;
    prov:wasQuotedFrom "https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:17754" .

:CrosslinkDensityFraction a owl:Class ;
    rdfs:label "CrosslinkDensityFraction"@en, "Fracción de densidad de reticulación"@es, "Vernetzungsdichteanteil"@de, "Fraction de densité de réticulation"@fr ;
    rdfs:subClassOf :Thermoset ;
    skos:definition "Ratio of the number of cross-links formed to the maximum possible cross-links that can be formed in a thermosetting system (NOTE: numeric value restricted to be between 0 and 1)"@en,
        "Rapport du nombre de liaisons croisées formées au nombre maximal de liaisons croisées pouvant être formées dans un système thermodurcissable (REMARQUE : valeur numérique limitée entre 0 et 1)"@fr,
        "Verhältnis der Anzahl gebildeter Vernetzungen zur maximal möglichen Anzahl von Vernetzungen in einem Duroplastsystem (HINWEIS: Numerischer Wert ist auf 0 bis 1 beschränkt)"@de,
        "Relación entre el número de entrecruzamientos formados y el número máximo posible de entrecruzamientos que pueden formarse en un sistema termoendurecible (NOTA: valor numérico restringido entre 0 y 1)"@es .

:PubChemReference a owl:Class ;
    rdfs:label "PubChem Reference"@en, "PubChem-Referenz"@de, "Referencia PubChem"@es, "Référence PubChem"@fr ;
    rdfs:subClassOf sio:SIO_000176 .

:ConstitutionalUnit a owl:Class ;
    rdfs:label "Constitutional Unit"@en, "Unidad constitucional"@es, "Konstitutionelle Einheit"@de, "Unité constitutionnelle"@fr ;
    rdfs:subClassOf sio:SIO_000074 .

:MatrixComponentComposition a owl:Class ;
    rdfs:label "Matrix Component Composition"@en, "Matrixkomponenten-Zusammensetzung"@de, "Composición del componente de matriz"@es, "Composition du composant matriciel"@fr ;
    rdfs:subClassOf :Composition .

:Constituent a owl:Class ;
    rdfs:label "Constituent"@en, "Bestandteil"@de, "Constituyente"@es, "Constituant"@fr ;
    rdfs:subClassOf sio:SIO_000004 .

:DielectricandImpedanceSpectroscopyAnalysis a owl:Class ;
    rdfs:label "Dielectric and Impedance Spectroscopy Analysis"@en, "Análisis de espectroscopía dieléctrica e impedancia"@es, "Analyse der dielektrischen und Impedanzspektroskopie"@de, "Analyse par spectroscopie diélectrique et d’impédance"@fr ;
    rdfs:subClassOf sio:SIO_001054 ;
    skos:definition "A technique used to study the electrical properties of materials by measuring their dielectric behavior and impedance over a range of frequencies."@en,
    "Una técnica utilizada para estudiar las propiedades eléctricas de los materiales midiendo su comportamiento dieléctrico e impedancia en un rango de frecuencias."@es,
    "Eine Methode zur Untersuchung der elektrischen Eigenschaften von Materialien durch Messung ihres dielektrischen Verhaltens und ihrer Impedanz über verschiedene Frequenzen."@de,
    "Une technique utilisée pour étudier les propriétés électriques des matériaux en mesurant leur comportement diélectrique et leur impédance sur une gamme de fréquences."@fr .

:TransmissionElectronMicroscopy a owl:Class ;
    rdfs:label "Transmission Electron Microscopy"@en, "Microscopía Electrónica de Transmisión"@es, "Transmissionselektronenmikroskopie"@de, "Microscopie Électronique en Transmission"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :Magnification ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :AcceleratingVoltage ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :WorkingDistance ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :EmissionCurrent ],
        [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ElectricalProperty ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :ExposureTime ],
        sio:SIO_001054 ;
    skos:definition "Transmission electron microscopy for obtaining microstructure at nanoscale"@en,
        "Microscopie électronique en transmission pour obtenir la microstructure à l'échelle nanométrique"@fr,
        "Transmissions-Elektronenmikroskopie zur Gewinnung der Mikrostruktur im Nanomaßstab"@de,
        "Microscopía electrónica de transmisión para obtener la microestructura a nanoescala"@es .

:ScanningElectronMicroscopy a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ElectricalProperty ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :AcceleratingVoltage ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :EmissionCurrent ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :ExposureTime ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :Magnification ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :WorkingDistance ],
        sio:SIO_001054 ;
    skos:definition "Scanning electron microscopy for obtaining microstructure at microscale"@en, "Microscopie électronique à balayage pour obtenir la microstructure à l'échelle microscopique"@fr, "Rasterelektronenmikroskopie zur Gewinnung der Mikrostruktur im Mikromaßstab"@de, "Microscopía electrónica de barrido para obtener la microestructura a microescala"@es .

:DynamicMechanicalAnalysis a owl:Class ;
    rdfs:label "Dynamic Mechanical Analysis"@en, "Análisis Mecánico Dinámico"@es, "Dynamisch-mechanische Analyse"@de, "Analyse Mécanique Dynamique"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ViscoelasticProperty ],
        sio:SIO_001054 ;
    skos:definition "Method to get viscoelastic behavior of materials with controlled temperature and frequency"@en,
        "Méthode pour obtenir le comportement viscoélastique des matériaux avec une température et une fréquence contrôlées"@fr,
        "Methode zur Ermittlung des viskoelastischen Verhaltens von Materialien bei kontrollierter Temperatur und Frequenz"@de,
        "Método para obtener el comportamiento viscoelástico de los materiales con temperatura y frecuencia controladas"@es .

:DielectricandImpedanceSpectroscopyAnalysis a owl:Class ;
    rdfs:label "Dielectric and Impedance Spectroscopy Analysis"@en, "Análisis de espectroscopía dieléctrica e impedancia"@es, "Analyse der dielektrischen und Impedanzspektroskopie"@de, "Analyse par spectroscopie diélectrique et d’impédance"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ElectricalProperty ],
        sio:SIO_001054 ;
    skos:definition "Measurement of dielectric spectroscopy (variation of dielectric constant with frequency)"@en,
        "Mesure de la spectroscopie diélectrique (variation de la constante diélectrique en fonction de la fréquence)"@fr,
        "Messung der dielektrischen Spektroskopie (Variation der Dielektrizitätskonstanten mit der Frequenz)"@de,
        "Medición de la espectroscopía dieléctrica (variación de la constante dieléctrica con la frecuencia)"@es .

:DifferentialScanningCalorimetry a owl:Class ;
    rdfs:label "Differential Scanning Calorimetry"@en, "Calorimetría Diferencial de Barrido"@es, "Differenzkalorimetrie (DSC)"@de, "Calorimétrie différentielle à balayage"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :HeatingRate ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :CoolingRate ],
        [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ThermalProperty ],
        sio:SIO_001054 ;
    skos:definition "Measurement of heat required to increase unit temperature in a material"@en,
        "Mesure de la chaleur nécessaire pour augmenter la température unitaire d'un matériau"@fr,
        "Messung der Wärme, die erforderlich ist, um die Einheitstemperatur eines Materials zu erhöhen"@de,
        "Medición del calor requerido para aumentar la temperatura unitaria de un material"@es .

:FourierTransformInfraredSpectroscopy a owl:Class ;
    rdfs:label "Fourier Transform Infrared Spectroscopy"@en, "Espectroscopía Infrarroja por Transformada de Fourier"@es, "Fourier-Transform-Infrarotspektroskopie"@de, "Spectroscopie Infrarouge à Transformée de Fourier"@fr ;
    rdfs:subClassOf sio:SIO_001054 ;
    skos:definition "Measurement of infrared spectrum of absorption or emission of a solid, liquid or gas"@en,
        "Mesure du spectre infrarouge d'absorption ou d'émission d'un solide, liquide ou gaz"@fr,
        "Messung des Infrarotspektrums der Absorption oder Emission eines Feststoffs, einer Flüssigkeit oder eines Gases"@de,
        "Medición del espectro infrarrojo de absorción o emisión de un sólido, líquido o gas"@es ;
    skos:exactMatch obo:CHMO_0000636 .

:XRayDiffractionAndScattering a owl:Class ;
    rdfs:label "X-Ray Diffraction and Scattering"@en, "Difracción y dispersión de rayos X"@es, "Röntgenbeugung und -streuung"@de, "Diffraction et diffusion des rayons X"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :Spectroscopy ],
        sio:SIO_001054 ;
    skos:definition "Non-destructive X-ray measurement for crystal structure, chemical composition, and physical properties"@en, "Mesure non destructive par rayons X de la structure cristalline, de la composition chimique et des propriétés physiques"@fr, "Zerstörungsfreie Röntgenmessung der Kristallstruktur, chemischen Zusammensetzung und physikalischen Eigenschaften"@de, "Medición no destructiva por rayos X de la estructura cristalina, la composición química y las propiedades físicas"@es .

:AtomicForceMicroscopy a owl:Class ;
    rdfs:label "Atomic Force Microscopy"@en, "Microscopía de Fuerza Atómica"@es, "Rasterkraftmikroskopie"@de, "Microscopie à Force Atomique"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ViscoelasticProperty ],
        [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :MechanicalProperty ],
        sio:SIO_001054 ;
    skos:definition "Nanoscale probing of material surface characteristics"@en, "Analyse à l’échelle nanométrique des caractéristiques de surface des matériaux"@fr, "Sondierung von Materialoberflächeneigenschaften im Nanomaßstab"@de, "Sondeo a nanoescala de las características superficiales del material"@es .

:ThermogravimetricAnalysis a owl:Class ;
    rdfs:label "Thermogravimetric Analysis"@en, "Análisis termogravimétrico"@es, "Thermogravimetrische Analyse"@de, "Analyse thermogravimétrique"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ThermalProperty ],
        sio:SIO_001054 ;
    skos:definition "Thermal analysis of material properties as function of temperature and time"@en, "Analyse thermique des propriétés des matériaux en fonction de la température et du temps"@fr, "Thermische Analyse der Materialeigenschaften in Abhängigkeit von Temperatur und Zeit"@de, "Análisis térmico de las propiedades del material en función de la temperatura y el tiempo"@es .

:PulsedElectroAcoustic a owl:Class ;
    rdfs:label "Pulsed Electro Acoustic"@en, "Electroacústico pulsado"@es, "Gepulste elektroakustische Methode"@de, "Électroacoustique pulsée"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ElectricalProperty ],
        sio:SIO_001054 ;
    skos:definition "Measurement of space charge in dielectric materials"@en, "Mesure de la charge d'espace dans les matériaux diélectriques"@fr, "Messung der Raumladung in dielektrischen Materialien"@de, "Medición de la carga espacial en materiales dieléctricos"@es .

:RamanSpectroscopy a owl:Class ;
    rdfs:label "Raman Spectroscopy"@en, "Espectroscopía Raman"@es, "Raman-Spektroskopie"@de, "Spectroscopie Raman"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :Spectroscopy ],
        sio:SIO_001054 ;
    skos:definition "Molecular analysis with spectroscopic techniques that observe low-frequency modes in a material"@en,
            "Analyse moléculaire avec des techniques spectroscopiques qui observent les modes de basse fréquence dans un matériau"@fr,
            "Molekularanalyse mit spektroskopischen Techniken, die niederfrequente Moden in einem Material beobachten"@de,
            "Análisis molecular con técnicas espectroscópicas que observan modos de baja frecuencia en un material"@es .

:NuclearMagneticResonance a owl:Class ;
    rdfs:label "Nuclear Magnetic Resonance"@en, "Resonancia Magnética Nuclear"@es, "Kernspinresonanz"@de, "Résonance Magnétique Nucléaire"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :Spectroscopy ],
        sio:SIO_001054 ;
    skos:definition "Molecular analysis due to observed NMR under applied magnetic field"@en, "Analyse moléculaire due à la RMN observée sous champ magnétique appliqué"@fr, "Molekularanalyse aufgrund beobachteter NMR unter angelegtem Magnetfeld"@de, "Análisis molecular debido a la RMN observada bajo un campo magnético aplicado"@es .

:XRayPhotoelectronSpectroscopy a owl:Class ;
    rdfs:label "X-Ray Photoelectron Spectroscopy"@en, "Espectroscopía de Fotoelectrones por Rayos X"@es, "Röntgen-Photoelektronenspektroskopie"@de, "Spectroscopie de Photoélectrons X"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :Spectroscopy ],
        sio:SIO_001054 .

:Rheometery a owl:Class ;
    rdfs:label "Rheometry"@en, "Reometría"@es, "Rheometrie"@de, "Rhéométrie"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ViscoelasticProperty ],
        [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :CapillarySize ],
        sio:SIO_001054 ;
    skos:definition "Measurement of the quantitative and qualitative relationships between deformations and stresses and their derivatives"@en, "Mesure des relations quantitatives et qualitatives entre les déformations, les contraintes et leurs dérivées"@fr, "Messung der quantitativen und qualitativen Beziehungen zwischen Deformationen, Spannungen und deren Ableitungen"@de, "Medición de las relaciones cuantitativas y cualitativas entre deformaciones, tensiones y sus derivadas"@es .

:Electrometry a owl:Class ;
    rdfs:label "Electrometry"@en, "Electrometría"@es, "Elektrometrie"@de, "Électrométrie"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ViscoelasticProperty ],
            [ a owl:Restriction ;
            owl:onProperty prov:used ;
            owl:someValuesFrom :CapillarySize ],
            sio:SIO_001054 ;
    skos:definition "Measurement of electric charge or electrical potential difference"@en, "Mesure de la charge électrique ou de la différence de potentiel électrique"@fr, "Messung der elektrischen Ladung oder des elektrischen Potentialunterschieds"@de, "Medición de la carga eléctrica o de la diferencia de potencial eléctrico"@es .

:OpticalMicroscopy a owl:Class ;
    rdfs:label "Optical Microscopy"@en, "Microscopía óptica"@es, "Optische Mikroskopie"@de, "Microscopie optique"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ViscoelasticProperty ],
        [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :MechanicalProperty ],
        sio:SIO_001054 ;
    skos:definition "Magnification of small objects with visible light"@en, "Grossissement de petits objets avec la lumière visible"@fr, "Vergrößerung kleiner Objekte mit sichtbarem Licht"@de, "Ampliación de objetos pequeños con luz visible"@es .

:PlateRheometery a owl:Class ;
    rdfs:label "Plate Rheometry"@en, "Reometría de placas"@es, "Plattenrheometrie"@de, "Rhéométrie à plateaux"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ViscoelasticProperty ],
      :Rheometery ;
    skos:definition "The falling plate rheometer sandwiches liquid between two solid surfaces. The top plate is fixed, and bottom plate falls under the influence of gravity, drawing out a string of the liquid"@en, "Le rhéomètre à plaque tombante enferme le liquide entre deux surfaces solides. La plaque supérieure est fixe, et la plaque inférieure tombe sous l'effet de la gravité, tirant un fil du liquide."@fr, "Das Fallplatten-Rheometer klemmt eine Flüssigkeit zwischen zwei festen Oberflächen ein. Die obere Platte ist fixiert, und die untere fällt durch die Schwerkraft, wodurch ein Faden der Flüssigkeit gezogen wird."@de, "El reómetro de placa descendente coloca el líquido entre dos superficies sólidas. La placa superior está fija y la inferior cae por efecto de la gravedad, estirando un hilo del líquido."@es .

:ConePlateRheometery a owl:Class ;
    rdfs:label "Cone-Plate Rheometry"@en, "Reometría de cono y placa"@es, "Kegel-Platten-Rheometrie"@de, "Rhéométrie à cône-plateau"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ViscoelasticProperty ],
        :Rheometery ;
    skos:definition "The liquid is placed on a horizontal plate and a shallow cone placed into it. The angle between the surface of the cone and the plate is around 1–2 degrees but can vary depending on the types of tests being run. Typically the plate is rotated and the torque on the cone measured."@en, "Le liquide est placé sur une plaque horizontale et un cône peu profond y est inséré. L'angle entre la surface du cône et la plaque est d'environ 1 à 2 degrés, mais peut varier selon le type de test effectué. En général, la plaque est mise en rotation et le couple exercé sur le cône est mesuré."@fr, "Die Flüssigkeit wird auf eine horizontale Platte gegeben und ein flacher Kegel hineingesetzt. Der Winkel zwischen der Oberfläche des Kegels und der Platte beträgt etwa 1–2 Grad, kann jedoch je nach Art des durchgeführten Tests variieren. Typischerweise wird die Platte gedreht und das Drehmoment am Kegel gemessen."@de, "El líquido se coloca sobre una placa horizontal y se introduce un cono poco profundo en él. El ángulo entre la superficie del cono y la placa es de aproximadamente 1–2 grados, aunque puede variar según el tipo de prueba realizada. Normalmente, se hace girar la placa y se mide el par sobre el cono."@es .

:HighPressureCapillaryRheometery a owl:Class ;
    rdfs:label "High Pressure Capillary Rheometry"@en, "Reometría capilar a alta presión"@es, "Hochdruck-Kapillarrheometrie"@de, "Rhéométrie capillaire haute pression"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty prov:generated ;
            owl:someValuesFrom :ViscoelasticProperty ],
        :Rheometery .

