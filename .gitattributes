# Default: let git normalize text, store LF in the repo
* text=auto

# Files executed in Linux containers / WSL — must be LF or the shebang breaks
*.sh        text eol=lf
.husky/**   text eol=lf
install     text eol=lf

# Pinned upstream file, checked by SHA-256 at load time: never convert its line endings
services/app/ontology/data/qudt-units-v3.5.3.ttl -text
